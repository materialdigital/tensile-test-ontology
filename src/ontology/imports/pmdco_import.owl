AnnotationAssertion(skos:definition co:PMD_0000781 "A function performed to alter the properties of materials through controlled heating and cooling processes."@en)
AnnotationAssertion(skos:definition co:PMD_0000781 "Eine Funktion, die durchgeführt wird, um die Eigenschaften von Materialien durch kontrollierte Wärme- und Abkühlungsprozesse zu verändern."@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0000781 "true"^^xsd:boolean)

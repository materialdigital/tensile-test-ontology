SubClassOf(co:PMD_0000966 co:PMD_0000602)

# Class: co:PMD_0000967 (temperature)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0000967 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0000967 "PERSON: Joerg Waitelonis")
AnnotationAssertion(rdfs:comment co:PMD_0000967 "The concept refers to an absolute temperature, not to be mistaken with temperature difference."@en)
AnnotationAssertion(rdfs:comment co:PMD_0000967 "To express that an object has a temperature, the property 'intensive bearer of' can be used. It implies a chain of: object consists of some portion of matter and portion of matter bearer of some temperature."@en)
AnnotationAssertion(rdfs:label co:PMD_0000967 "Temperatur"@de)
AnnotationAssertion(rdfs:label co:PMD_0000967 "temperature"@en)
AnnotationAssertion(skos:definition co:PMD_0000967 "Die Temperatur ist eine grundlegende intensive Qualität, die die durchschnittliche atomare oder molekulare Bewegung oder Schwingung eines Teils der Materie darstellt."@de)
AnnotationAssertion(skos:definition co:PMD_0000967 "The temperature is a fundamental intensive quality representing the average atomic or molcular movement or vibration of a portion of matter."@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0000967 "true"^^xsd:boolean)
SubClassOf(co:PMD_0000967 co:PMD_0023043)

# Class: co:PMD_0000968 (Temperaturänderungswerkzeug)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0000968 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0000968 "PERSON: Joerg Waitelonis")
AnnotationAssertion(rdfs:label co:PMD_0000968 "Temperaturänderungswerkzeug"@de)
AnnotationAssertion(rdfs:label co:PMD_0000968 "temperature change device"@en)
AnnotationAssertion(skos:definition co:PMD_0000968 "A device that is used for the alteration and adjustment of the temperature of a tangible object or the environment, e.g., a furnace and cooling media."@en)
AnnotationAssertion(skos:definition co:PMD_0000968 "Diese Entität beschreibt allgemein jedes Werkzeug, das zur Änderung und Einstellung der Temperatur eines materiellen Objekts oder der Umgebung verwendet wird, z. B. einen Ofen und Kühlmittel."@de)
SubClassOf(co:PMD_0000968 co:PMD_0000602)


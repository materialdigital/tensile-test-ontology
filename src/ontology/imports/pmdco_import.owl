AnnotationAssertion(rdfs:label co:PMD_0080103 "volume concentration"@en)
AnnotationAssertion(skos:definition co:PMD_0080103 "Volume concentration links the volume of a mixture component to the total volume, crucial for quantitative composition description"@en)
AnnotationAssertion(skos:definition co:PMD_0080103 "Volumenkonzentration verbindet das Volumen eines Mischbestandteils mit dem Gesamtvolumen, entscheidend für die quantitative Zusammensetzungsbeschreibung"@de)
AnnotationAssertion(skos:example co:PMD_0080103 "A paint pigment dispersion has a TiO2 volume concentration of 20 %"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080103 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080103 co:PMD_0020104)

# Class: co:PMD_0080104 (volume fraction)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080104 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080104 "Necessary and sufficient conditions for 'volume fraction' have not yet been formalized. The term is defined as a specific subtype of 'volume ratio'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://de.wikipedia.org/wiki/Volumenkonzentration."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080104 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080104 <https://de.wikipedia.org/wiki/Volumenkonzentration>)
AnnotationAssertion(rdfs:label co:PMD_0080104 "Volumenanteil"@de)
AnnotationAssertion(rdfs:label co:PMD_0080104 "volume fraction"@en)
AnnotationAssertion(skos:definition co:PMD_0080104 "Volume fraction describes the volume of a mixture component relative to the sum of all components' volumes"@en)
AnnotationAssertion(skos:definition co:PMD_0080104 "Volumenanteil beschreibt das Volumen eines Mischbestandteils im Verhältnis zur Summe der Volumina aller Bestandteile"@de)
AnnotationAssertion(skos:example co:PMD_0080104 "A dual-phase steel contains a martensite volume fraction of 20 %, controlling its strength-ductility balance"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080104 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080104 co:PMD_0020104)

# Class: co:PMD_0080105 (Mischengehaltverhältnis)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080105 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080105 "Necessary and sufficient conditions for 'volume mix ratio' have not yet been formalized. The term is defined as a specific subtype of 'volume ratio'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://de.wikipedia.org/wiki/Volumenverh%C3%A4ltnis."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080105 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080105 <https://de.wikipedia.org/wiki/Volumenverh%C3%A4ltnis>)

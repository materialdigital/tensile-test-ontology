# Class: co:PMD_0000637 (Materialermüdungsprüfmaschine)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0000637 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0000637 "PERSON: Joerg Waitelonis")

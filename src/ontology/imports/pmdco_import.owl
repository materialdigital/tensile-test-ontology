AnnotationAssertion(rdfs:label co:PMD_0020111 "OBSOLETE martensite"@en)
AnnotationAssertion(owl:deprecated co:PMD_0020111 "true"^^xsd:boolean)
AnnotationAssertion(skos:definition co:PMD_0020111 "hard, body-centered tetragonal phase formed by diffusionless shear transformation of austenite upon rapid quenching in iron-carbon alloys, with carbon atoms trapped in interstitial sites"@en)
AnnotationAssertion(skos:definition co:PMD_0020111 "harte, körperzentrierte tetragonale Phase, die durch diffusionslose Scherumwandlung von Austenit beim schnellen Abschrecken in Eisen-Kohlenstoff-Legierungen entsteht, wobei Kohlenstoffatome in Zwischengitterplätzen eingeschlossen sind"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0020111 "true"^^xsd:boolean)


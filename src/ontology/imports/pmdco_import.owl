AnnotationAssertion(rdfs:label co:PMD_0025014 "single crystal"@en)
AnnotationAssertion(skos:definition co:PMD_0025014 "Single crystal is a crystal which is not part of a polycrystal and its boundaries are its external surfaces."@en)
SubClassOf(co:PMD_0025014 co:PMD_0020003)


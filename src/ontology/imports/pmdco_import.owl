AnnotationAssertion(rdfs:label co:PMD_0020207 "Stoffmenge"@de)
AnnotationAssertion(rdfs:label co:PMD_0020207 "amount of substance"@en)
AnnotationAssertion(skos:definition co:PMD_0020207 "Amount of substance n is a molar proportion when the whole is an object aggregate N, which has avogadro number objects (of same type) as parts (n = N/N_A)."@en)
AnnotationAssertion(skos:definition co:PMD_0020207 "Die Menge der Substanz n ist ein molarer Anteil, wenn das Ganze ein Objektaggregat N ist, das Avogadro-Anzahlobjekte (gleicher Art) als Teile hat (n = N/N_A)."@de)
SubClassOf(co:PMD_0020207 co:PMD_0020103)


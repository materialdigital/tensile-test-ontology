AnnotationAssertion(rdfs:label co:PMD_0000535 "Siedepunkt"@de)
AnnotationAssertion(rdfs:label co:PMD_0000535 "boiling point"@en)
AnnotationAssertion(skos:definition co:PMD_0000535 "Der Siedepunkt ist eine Zustandsgrenze einer Materie, die durch den Übergang vom flüssigen in den gasförmigen Zustand (oder umgekehrt) entsteht."@de)
AnnotationAssertion(skos:definition co:PMD_0000535 "The boiling point is a state of matter boundary realized by transition form the liquid state to the gaseous state (or vice versa)."@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0000535 "true"^^xsd:boolean)
SubClassOf(co:PMD_0000535 co:PMD_0020164)


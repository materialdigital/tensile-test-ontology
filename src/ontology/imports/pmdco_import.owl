# Class: co:PMD_0050150 (iron-based metallic glass)

AnnotationAssertion(rdfs:label co:PMD_0050150 "iron-based metallic glass"@en)
AnnotationAssertion(skos:definition co:PMD_0050150 "amorphous metal glass that is predominantly composed of iron"@en)
SubClassOf(co:PMD_0050150 co:PMD_0050149)

# Class: co:PMD_0050151 (magnesium-based metallic glass)

AnnotationAssertion(rdfs:label co:PMD_0050151 "magnesium-based metallic glass"@en)
AnnotationAssertion(skos:definition co:PMD_0050151 "amorphous metal glass that is primarily composed of magnesium, noted for its low density"@en)
SubClassOf(co:PMD_0050151 co:PMD_0050149)

# Class: co:PMD_0050152 (zirconium-based metallic glass)

AnnotationAssertion(rdfs:label co:PMD_0050152 "zirconium-based metallic glass"@en)
AnnotationAssertion(skos:definition co:PMD_0050152 "amorphous metal glass that is composed mainly of zirconium, valued for its corrosion resistance and strength"@en)
SubClassOf(co:PMD_0050152 co:PMD_0050149)

# Class: co:PMD_0050153 (thickness)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0050153 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0050153 "PERSON: Markus Schilling")
AnnotationAssertion(rdfs:label co:PMD_0050153 "Dicke"@de)
AnnotationAssertion(rdfs:label co:PMD_0050153 "thickness"@en)
AnnotationAssertion(skos:definition co:PMD_0050153 "A length that describes the measured dimension in one direction of a test piece."@en)
AnnotationAssertion(skos:definition co:PMD_0050153 "Diese Klasse beschreibt das gemessene Maß in einer Richtung eines Prüfkörpers."@de)
SubClassOf(co:PMD_0050153 co:PMD_0040001)

# Class: co:PMD_0050154 (Breite)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0050154 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0050154 "PERSON: Markus Schilling")
AnnotationAssertion(rdfs:label co:PMD_0050154 "Breite"@de)
AnnotationAssertion(rdfs:label co:PMD_0050154 "width"@en)
AnnotationAssertion(rdfs:seeAlso co:PMD_0050154 <https://w3id.org/pmd/co/2.0.8/Width>)
AnnotationAssertion(rdfs:seeAlso co:PMD_0050154 <https://www.merriam-webster.com/dictionary/width>)
AnnotationAssertion(skos:definition co:PMD_0050154 "Diese Klasse beschreibt eine horizontale Messung eines Objekts, die im rechten Winkel zur Länge des Objekts vorgenommen wird."@de)
AnnotationAssertion(skos:definition co:PMD_0050154 "This class describes a horizontal measurement of an object taken at right angles to the length of the object."@en)
SubClassOf(co:PMD_0050154 co:PMD_0040001)

# Class: co:PMD_0050155 (shape)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0050155 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0050155 "PERSON: Markus Schilling")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0050155 "“Shape.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/shape. Accessed 13 Jan. 2023.")
AnnotationAssertion(rdfs:label co:PMD_0050155 "Form"@de)
AnnotationAssertion(rdfs:label co:PMD_0050155 "shape"@en)
AnnotationAssertion(skos:definition co:PMD_0050155 "Das sichtbare Ausstattungsmerkmal (räumliche Form oder Kontur) eines bestimmten Objektes oder einer Art von Objekt."@de)
AnnotationAssertion(skos:definition co:PMD_0050155 "Extemsive quality, the visible makeup characteristic (spatial form or contour) of a particular item or kind of item."@en)
SubClassOf(co:PMD_0050155 co:PMD_0020353)

# Class: co:PMD_0050156 (Geometrische Form)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0050156 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0050156 "PERSON: Markus Schilling")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0050156 "DIN EN ISO 6892-1:2019")
AnnotationAssertion(rdfs:label co:PMD_0050156 "Geometrische Form"@de)
AnnotationAssertion(rdfs:label co:PMD_0050156 "geometry shape"@en)
AnnotationAssertion(skos:definition co:PMD_0050156 "Dieses Konzept beschreibt die geometrischen Abmessungen und das Erscheinungsbild (Form und Abmaße) einer Probe, eines Prüfkörpers oder eines Prüfstücks, wie sie üblicherweise durch eine entsprechende Norm definiert sind. Dementsprechend ist der angegebene Formwert in Übereinstimmung mit der definierenden Norm anzugeben, z. B. \"Zugprüfstück Form 1 gemäß Anhang B der Zugversuchsnorm\"."@de)
AnnotationAssertion(skos:definition co:PMD_0050156 "This concept describes the geometric dimensions and appearance (shape and dimensions) of a sample, specimen, or test piece as usually defined by a corresponding standard. Accordingly, the shape value given is in accordance with the defining standard, e.g., ‘tensile test piece shape 1 in accordance with annex B of the tensile test standard’."@en)
SubClassOf(co:PMD_0050156 co:PMD_0050155)

# Class: co:PMD_0050157 (3D Geometrie)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0050157 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0050157 "PERSON: Markus Schilling")
AnnotationAssertion(rdfs:label co:PMD_0050157 "3D Geometrie"@de)
AnnotationAssertion(rdfs:label co:PMD_0050157 "shape 3d"@en)
AnnotationAssertion(skos:definition co:PMD_0050157 "A shape 3D is a geometry shape that exists in three dimensions, having length, width, and height, and can be defined by its spatial properties such as volume and surface area."@en)
AnnotationAssertion(skos:definition co:PMD_0050157 "Eine 3D Geometrie ist eine geometrische Form, die in drei Dimensionen existiert, mit Länge, Breite und Höhe, und die durch ihre räumlichen Eigenschaften wie Volumen und Oberfläche definiert werden kann."@de)
AnnotationAssertion(skos:example co:PMD_0050157 "Beispiele sind Formen wie Würfel, Kugeln und Pyramiden."@de)
AnnotationAssertion(skos:example co:PMD_0050157 "Examples include shapes like cubes, spheres, and pyramids."@en)
SubClassOf(co:PMD_0050157 co:PMD_0050156)

# Class: co:PMD_0060006 (device specification)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0060006 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0060006 "PERSON: Hossein Beygi Nasrabadi")
AnnotationAssertion(rdfs:label co:PMD_0060006 "device specification"@en)
AnnotationAssertion(skos:definition co:PMD_0060006 "A directive information entity that outlines the technical requirements, features, constraints, and performance criteria of a specific device, guiding its design, manufacturing, operation, or maintenance."@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0060006 "true"^^xsd:boolean)
SubClassOf(co:PMD_0060006 obo:IAO_0000033)

# Class: co:PMD_0060007 (material specification)

AnnotationAssertion(rdfs:label co:PMD_0060007 "material specification"@en)
AnnotationAssertion(skos:definition co:PMD_0060007 "A directive information entity that defines the composition, properties, performance criteria, and acceptable standards for a material, guiding its selection, processing, and application in a specific context."@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0060007 "true"^^xsd:boolean)
SubClassOf(co:PMD_0060007 obo:IAO_0000033)

# Class: co:PMD_0060008 (recipe)

AnnotationAssertion(rdfs:label co:PMD_0060008 "recipe"@en)
AnnotationAssertion(skos:definition co:PMD_0060008 "A plan specification that outlines the ingredients, proportions, and procedural steps required to prepare a specific product, typically in cooking, manufacturing, or chemical processes."@en)
SubClassOf(co:PMD_0060008 obo:IAO_0000104)

# Class: co:PMD_0060009 (specification datum)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0060009 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0060009 "PERSON: Hossein Beygi Nasrabadi")
AnnotationAssertion(rdfs:comment co:PMD_0060009 "The intent of the specification datum is to express the \"Sollwert\" of some qualitiy or behavioral material property. Then, the specification datum can be further specified by  some value specification."@en)
AnnotationAssertion(rdfs:label co:PMD_0060009 "specification datum"@en)
AnnotationAssertion(skos:definition co:PMD_0060009 "A directive information entity that provides information of a setpoint of some value, i.e., it is an intended value."@en)
AnnotationAssertion(skos:example co:PMD_0060009 "The setpoint value of a ultimate tensile strength of some steel material"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0060009 "true"^^xsd:boolean)
SubClassOf(co:PMD_0060009 obo:IAO_0000033)

# Class: co:PMD_0080007 (radiologic disposition)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080007 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080007 "Necessary and sufficient conditions for 'radiologic quality' have not yet been formalized. The term is defined as a specific subtype of 'physical quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080007 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080007 "radiologic disposition"@en)
AnnotationAssertion(rdfs:label co:PMD_0080007 "radiologische Eigenschaft"@de)
AnnotationAssertion(skos:definition co:PMD_0080007 "Radiologic disposition pertains to properties or characteristics related to an entity's interaction with radiant energy"@en)
AnnotationAssertion(skos:definition co:PMD_0080007 "Radiologische Qualität bezieht sich auf die Eigenschaften oder Merkmale im Zusammenhang mit der Wechselwirkung einer Entität mit Strahlungsenergie"@de)
AnnotationAssertion(skos:example co:PMD_0080007 "The dose equivalent a patient receives from a chest X-ray is a radiologic quality of the examination"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080007 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080007 co:PMD_0020353)

# Class: co:PMD_0080010 (räumliche Relationsqualität)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080010 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080010 "Necessary and sufficient conditions for 'spatial relational quality' have not yet been formalized. The term is defined as a specific subtype of 'BFO_0000145'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080010 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080010 "räumliche Relationsqualität"@de)
AnnotationAssertion(rdfs:label co:PMD_0080010 "spatial relational quality"@en)
AnnotationAssertion(skos:definition co:PMD_0080010 "Räumliche Beziehungsqualität ist eine Qualität, die einer materiellen Entität aufgrund ihrer räumlichen Beziehung zu einer oder mehreren anderen Entitäten, wie z. B. Position, Ausrichtung oder Entfernung, innewohnt"@de)
AnnotationAssertion(skos:definition co:PMD_0080010 "Spatial relational quality is a quality that inheres in a material entity by virtue of its spatial relationship to one or more other entities, such as position, orientation, or distance"@en)
AnnotationAssertion(skos:example co:PMD_0080010 "the distance between a bolt and the nearest edge of a steel plate is a spatial relational quality of the bolt"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080010 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080010 obo:BFO_0000145)

# Class: co:PMD_0080011 (Geschwindigkeit)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080011 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080011 "Necessary and sufficient conditions for 'speed' have not yet been formalized. The term is defined as a specific subtype of 'physical process characteristic'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://simple.wikipedia.org/wiki/Speed."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080011 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080011 <https://simple.wikipedia.org/wiki/Speed>)
AnnotationAssertion(rdfs:label co:PMD_0080011 "Geschwindigkeit"@de)
AnnotationAssertion(rdfs:label co:PMD_0080011 "speed"@en)
AnnotationAssertion(skos:definition co:PMD_0080011 "Geschwindigkeit beschreibt die Entfernung, die ein Objekt in einer bestimmten Zeit zurücklegt, immer positiv"@de)
AnnotationAssertion(skos:definition co:PMD_0080011 "process attribute that describes the distance an object moves in a given amount of time, always positive"@en)
AnnotationAssertion(skos:example co:PMD_0080011 "If a train takes 1 hour to travel 100 kilometers, it has a speed of 100 kilometers per hour (62 mph)"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080011 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080011 co:PMD_0000008)

# Class: co:PMD_0080012 (elektrischer Strom)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080012 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080012 "Necessary and sufficient conditions for 'electric current' have not yet been formalized. The term is defined as a specific subtype of 'physical process characteristic'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080012 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080012 "electric current"@en)
AnnotationAssertion(rdfs:label co:PMD_0080012 "elektrischer Strom"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080012 "electric current"@en)
AnnotationAssertion(skos:definition co:PMD_0080012 "Elektrischer Strom ist der Fluss elektrischer Ladung pro Zeiteinheit"@de)
AnnotationAssertion(skos:definition co:PMD_0080012 "process attribute that represents the flow of electric charge per unit time"@en)
AnnotationAssertion(skos:example co:PMD_0080012 "A 100 W incandescent bulb draws an electric current of about 0.43 A at 230 V"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080012 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080012 co:PMD_0000008)

# Class: co:PMD_0080013 (force rate)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080013 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080013 "Necessary and sufficient conditions for 'force rate' have not yet been formalized. The term is defined as a specific subtype of 'physical process characteristic'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080013 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080013 "Kraftrate"@de)
AnnotationAssertion(rdfs:label co:PMD_0080013 "force rate"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080013 "Ruck"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080013 "yank"@en)
AnnotationAssertion(skos:definition co:PMD_0080013 "In der Physik wird der Begriff \"Ruck\" manchmal verwendet, um die Ableitung der Kraft in Bezug auf die Zeit oder die mit dem Ruck multiplizierte Masse zu bezeichnen. In der relativistischen Physik wird dieser Begriff als die zweite Ableitung des Impulses in Bezug auf die Zeit ausgedrückt, da die Masse geschwindigkeitsabhängig ist. Obwohl nicht allgemein als offizieller Begriff für diese Größe anerkannt, wird der Begriff \"Ruck\" häufig von Physikbegeisterten verwendet"@de)
AnnotationAssertion(skos:definition co:PMD_0080013 "In physics, yank is sometimes used to denote the derivative of force with respect to time or mass multiplied by jerk. In relativistic physics, it is expressed as the second derivative of momentum with respect to time, because the mass is velocity-dependent. Though not universally accepted as an official term for this quantity, the term \"yank\" is commonly used among physics enthusiasts"@en)
AnnotationAssertion(skos:example co:PMD_0080013 "During impact testing, the force rate on the specimen rises to 10 kN/ms within the first microsecond"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080013 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080013 co:PMD_0000008)

# Class: co:PMD_0080014 (mass flow rate)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080014 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080014 "Necessary and sufficient conditions for 'mass flow rate' have not yet been formalized. The term is defined as a specific subtype of 'physical process characteristic'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Mass_flow_rate."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080014 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080014 <https://en.wikipedia.org/wiki/Mass_flow_rate>)
AnnotationAssertion(rdfs:label co:PMD_0080014 "Massendurchsatz"@de)
AnnotationAssertion(rdfs:label co:PMD_0080014 "mass flow rate"@en)
AnnotationAssertion(skos:definition co:PMD_0080014 "Der Massendurchfluss quantifiziert die pro Zeiteinheit fließende Masse und wird üblicherweise in Kilogramm pro Sekunde oder Pfund pro Sekunde gemessen"@de)
AnnotationAssertion(skos:definition co:PMD_0080014 "process attribute that quantifies the mass passing per unit time, commonly measured in kilograms per second or pounds per second"@en)
AnnotationAssertion(skos:example co:PMD_0080014 "A coolant pump delivers a mass flow rate of 2 kg/s of water through a heat exchanger"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080014 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080014 co:PMD_0000008)

# Class: co:PMD_0080015 (mechanischer Impuls)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080015 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080015 "Necessary and sufficient conditions for 'mechanical impulse' have not yet been formalized. The term is defined as a specific subtype of 'physical process characteristic'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Impulse_(physics)."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080015 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080015 <https://en.wikipedia.org/wiki/Impulse_(physics)>)
AnnotationAssertion(rdfs:label co:PMD_0080015 "mechanical impulse"@en)
AnnotationAssertion(rdfs:label co:PMD_0080015 "mechanischer Impuls"@de)
AnnotationAssertion(skos:definition co:PMD_0080015 "Unter mechanischem Impuls versteht man die Änderung des Impulses eines Objekts, wenn es im Laufe der Zeit einer Kraft ausgesetzt wird"@de)
AnnotationAssertion(skos:definition co:PMD_0080015 "process attribute that signifies the change in momentum of an object when subjected to a force over time"@en)
AnnotationAssertion(skos:example co:PMD_0080015 "A drop weight imparts a mechanical impulse of 50 N·s to the Charpy specimen during impact"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080015 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080015 co:PMD_0000008)

# Class: co:PMD_0080016 (radiant energy flux)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080016 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080016 "Necessary and sufficient conditions for 'radiant energy flux' have not yet been formalized. The term is defined as a specific subtype of 'physical process characteristic'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Radiant_energy."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080016 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080016 <https://en.wikipedia.org/wiki/Radiant_energy>)
AnnotationAssertion(rdfs:label co:PMD_0080016 "Strahlungsfluss"@de)
AnnotationAssertion(rdfs:label co:PMD_0080016 "radiant energy flux"@en)
AnnotationAssertion(skos:definition co:PMD_0080016 "Strahlungsfluss beschreibt die Strahlungsenergie, die pro Zeiteinheit emittiert, reflektiert, übertragen oder empfangen wird"@de)
AnnotationAssertion(skos:definition co:PMD_0080016 "process attribute that represents the radiant energy emitted, reflected, transmitted, or received per unit time"@en)
AnnotationAssertion(skos:example co:PMD_0080016 "A solar panel receives a radiant energy flux of 1000 W/m2 under standard test conditions"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080016 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080016 co:PMD_0000008)

# Class: co:PMD_0080017 (temperature profile)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080017 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080017 "Necessary and sufficient conditions for 'temperature profile' have not yet been formalized. The term is defined as a specific subtype of 'physical process characteristic'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080017 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080017 "Temperaturprofil"@de)
AnnotationAssertion(rdfs:label co:PMD_0080017 "temperature profile"@en)
AnnotationAssertion(skos:definition co:PMD_0080017 "Temperatur Profil beschreibt Änderungen der Temperatur eines materiellen Wesens oder Raums über die Zeit"@de)
AnnotationAssertion(skos:definition co:PMD_0080017 "process attribute that describes changes in the temperature of a material entity or space over time"@en)
AnnotationAssertion(skos:example co:PMD_0080017 "The temperature profile along a quenched steel bar varies from 850 C at the surface to 200 C at the core"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080017 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080017 co:PMD_0000008)

# Class: co:PMD_0080019 (Fläche)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080019 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080019 "Necessary and sufficient conditions for 'area' have not yet been formalized. The term is defined as a specific subtype of 'DimensionQuality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0001323."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080019 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080019 obo:PATO_0001323)
AnnotationAssertion(rdfs:label co:PMD_0080019 "Fläche"@de)
AnnotationAssertion(rdfs:label co:PMD_0080019 "area"@en)
AnnotationAssertion(skos:definition co:PMD_0080019 "Area signifies a 2-D extent quality inhering by virtue of the bearer's two-dimensional extent"@en)
AnnotationAssertion(skos:definition co:PMD_0080019 "Fläche bedeutet eine zweidimensionale Ausdehnungsqualität, die aufgrund der zweidimensionalen Ausdehnung des Trägers inhärent ist"@de)
AnnotationAssertion(skos:example co:PMD_0080019 "The cross-sectional area of a tensile specimen at the gauge section is 50 mm2"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080019 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080019 co:PMD_0020132)

# Class: co:PMD_0080021 (sound reflection coefficient)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080021 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080021 "Necessary and sufficient conditions for 'sound reflection coefficient' have not yet been formalized. The term is defined as a specific subtype of 'acoustic quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080021 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080021 "Schallreflexionsgrad"@de)
AnnotationAssertion(rdfs:label co:PMD_0080021 "sound reflection coefficient"@en)
AnnotationAssertion(skos:definition co:PMD_0080021 "Schallreflexionsgrad quantifiziert den Anteil der Schallenergie, die von einer Oberfläche reflektiert wird"@de)
AnnotationAssertion(skos:definition co:PMD_0080021 "Sound reflection coefficient quantifies the proportion of sound energy reflected by a surface"@en)
AnnotationAssertion(skos:example co:PMD_0080021 "A concrete wall has a sound reflection coefficient near 0.99 at 500 Hz, acting nearly as a perfect reflector"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080021 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080021 co:PMD_0020309)
SubClassOf(co:PMD_0080021 ObjectIntersectionOf(co:PMD_0000506 ObjectSomeValuesFrom(obo:RO_0000052 obo:BFO_0000146)))
SubClassOf(co:PMD_0080021 ObjectSomeValuesFrom(obo:RO_0000052 ObjectIntersectionOf(obo:BFO_0000146 ObjectSomeValuesFrom(obo:RO_0000056 co:PMD_0000517))))

# Class: co:PMD_0080022 (elektrische Ladung)

AnnotationAssertion(obo:IAO_0000117 co:PMD_0080022 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080022 "electric charge"@en)
AnnotationAssertion(rdfs:label co:PMD_0080022 "elektrische Ladung"@de)
AnnotationAssertion(skos:definition co:PMD_0080022 "Electric charge refers to the physical property of matter causing it to experience a force when placed in an electromagnetic field"@en)
AnnotationAssertion(skos:example co:PMD_0080022 "A capacitor stores 10 µC of electric charge at a voltage of 5 V"@en)
SubClassOf(co:PMD_0080022 obo:BFO_0000019)
SubClassOf(co:PMD_0080022 ObjectIntersectionOf(co:PMD_0020312 ObjectSomeValuesFrom(obo:RO_0000080 ObjectUnionOf(obo:BFO_0000027 obo:BFO_0000030))))

# Class: co:PMD_0080023 (elektrische Feldstärke)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080023 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080023 "Necessary and sufficient conditions for 'electric field strength' have not yet been formalized. The term is defined as a specific subtype of 'electrical quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://www.britannica.com/science/electric-field."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080023 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080023 <https://www.britannica.com/science/electric-field>)
AnnotationAssertion(rdfs:label co:PMD_0080023 "electric field strength"@en)
AnnotationAssertion(rdfs:label co:PMD_0080023 "elektrische Feldstärke"@de)
AnnotationAssertion(skos:definition co:PMD_0080023 "Die Stärke oder Intensität des elektrischen Feldes bezieht sich auf die Stärke und Richtung des elektrischen Feldes an einem Punkt und ist entscheidend für die Bestimmung der Auswirkungen auf elektrische Ladungen in der Nähe dieses Punktes"@de)
AnnotationAssertion(skos:definition co:PMD_0080023 "Electric field strength, or intensity, refers to the magnitude and direction of the electric field at a point, crucial for determining effects on electric charges near that point"@en)
AnnotationAssertion(skos:example co:PMD_0080023 "Between parallel capacitor plates separated by 1 mm at 100 V, the electric field strength is 1e5 V/m"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080023 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080023 co:PMD_0020353)

# Class: co:PMD_0080024 (dielectric strength)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080024 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080024 "Necessary and sufficient conditions for 'dielectric strength' have not yet been formalized. The term is defined as a specific subtype of 'electrical quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080024 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080024 "Durchschlagsfestigkeit"@de)
AnnotationAssertion(rdfs:label co:PMD_0080024 "dielectric strength"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080024 "Dielektrische Festigkeit"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080024 "E_ds"@en)
AnnotationAssertion(skos:definition co:PMD_0080024 "Dielectric strength is an electrical quality of an insulating material that specifies the maximum electric field intensity the material can sustain without undergoing electrical breakdown"@en)
AnnotationAssertion(skos:definition co:PMD_0080024 "Durchschlagsfestigkeit ist eine elektrische Qualität eines Isoliermaterials, die die maximale elektrische Feldstärke angibt, die das Material aushalten kann, ohne einen elektrischen Durchschlag zu erleiden"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080024 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080024 obo:BFO_0000019)
SubClassOf(co:PMD_0080024 co:PMD_0023004)
SubClassOf(co:PMD_0080024 ObjectIntersectionOf(co:PMD_0020353 ObjectSomeValuesFrom(obo:RO_0000080 co:PMD_0000001)))

# Class: co:PMD_0080025 (magnetic flux)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080025 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080025 "Necessary and sufficient conditions for 'magnetic flux' have not yet been formalized. The term is defined as a specific subtype of 'magnetic quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080025 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080025 "magnetic flux"@en)
AnnotationAssertion(rdfs:label co:PMD_0080025 "magnetischer Fluss"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080025 "Magnetfeld"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080025 "magnetic field"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080025 "magnetic flux"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080025 "magnetischer Fluss"@de)
AnnotationAssertion(skos:definition co:PMD_0080025 "Magnetischer Fluss ist die Gesamtanzahl der Magnetfeldlinien, die durch eine bestimmte Fläche verlaufen"@de)
AnnotationAssertion(skos:definition co:PMD_0080025 "magnetic quality that represents the total number of magnetic field lines passing through a given area"@en)
AnnotationAssertion(skos:example co:PMD_0080025 "A transformer core carries a magnetic flux of 1 mWb through its cross-section at rated voltage"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080025 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080025 co:PMD_0020353)

# Class: co:PMD_0080026 (magnetische Permeabilität)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080026 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080026 "Necessary and sufficient conditions for 'magnetic permeability' have not yet been formalized. The term is defined as a specific subtype of 'magnetic quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080026 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080026 "magnetic permeability"@en)
AnnotationAssertion(rdfs:label co:PMD_0080026 "magnetische Permeabilität"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080026 "Permeabilität"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080026 "permeability"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080026 "μ"@en)
AnnotationAssertion(skos:definition co:PMD_0080026 "Magnetic permeability is a magnetic quality of a material that quantifies its ability to support the formation of a magnetic field within itself, expressed as the ratio of magnetic flux density to the applied magnetic field intensity"@en)
AnnotationAssertion(skos:definition co:PMD_0080026 "Magnetische Permeabilität ist eine magnetische Qualität eines Materials, die seine Fähigkeit quantifiziert, ein Magnetfeld in seinem Inneren zu unterstützen, ausgedrückt als Verhältnis der magnetischen Flussdichte zur aufgebrachten magnetischen Feldstärke"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080026 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080026 co:PMD_0020353)

# Class: co:PMD_0080027 (coercivity)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080027 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080027 "Necessary and sufficient conditions for 'coercivity' have not yet been formalized. The term is defined as a specific subtype of 'magnetic quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080027 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080027 "Koerzitivfeldstärke"@de)
AnnotationAssertion(rdfs:label co:PMD_0080027 "coercivity"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080027 "H_c"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080027 "Koerzitivkraft"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080027 "coercive field"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080027 "coercive force"@en)
AnnotationAssertion(skos:definition co:PMD_0080027 "Coercivity is a magnetic quality of a ferromagnetic material that specifies the magnitude of the applied magnetic field required to reduce its magnetization to zero after it has been fully magnetised"@en)
AnnotationAssertion(skos:definition co:PMD_0080027 "Koerzitivfeldstärke ist eine magnetische Qualität eines ferromagnetischen Materials, die die Stärke des aufzubringenden Magnetfelds angibt, das erforderlich ist, um seine Magnetisierung nach vollständiger Magnetisierung auf null zu reduzieren"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080027 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080027 co:PMD_0020353)

# Class: co:PMD_0080029 (strain)

AnnotationAssertion(obo:IAO_0000117 co:PMD_0080029 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080029 "Dehnung"@de)
AnnotationAssertion(rdfs:label co:PMD_0080029 "strain"@en)
AnnotationAssertion(skos:definition co:PMD_0080029 "Strain is defined as relative deformation, compared to a reference position configuration"@en)
AnnotationAssertion(skos:example co:PMD_0080029 "Under a tensile load, a polymer film exhibits a strain of 2 % before yielding"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080029 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080029 co:PMD_0020311)
SubClassOf(co:PMD_0080029 co:PMD_0023004)
SubClassOf(co:PMD_0080029 ObjectIntersectionOf(ObjectSomeValuesFrom(obo:RO_0000052 co:PMD_0000001) ObjectSomeValuesFrom(obo:RO_0002328 co:PMD_0020132)))

# Class: co:PMD_0080030 (technische Dehnung)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080030 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080030 "Necessary and sufficient conditions for 'engineering strain' have not yet been formalized. The term is defined as a specific subtype of 'strain'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Strain_(mechanics)."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080030 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080030 <https://en.wikipedia.org/wiki/Strain_(mechanics)>)
AnnotationAssertion(rdfs:label co:PMD_0080030 "engineering strain"@en)
AnnotationAssertion(rdfs:label co:PMD_0080030 "technische Dehnung"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080030 "Cauchy strain"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080030 "technical strain"@en)
AnnotationAssertion(skos:definition co:PMD_0080030 "Die technische Dehnung oder Cauchy-Dehnung drückt die Gesamtverformung relativ zur ursprünglichen Abmessung des Materials unter Last aus und spiegelt die Dehnung bei axialer Belastung wider"@de)
AnnotationAssertion(skos:definition co:PMD_0080030 "Engineering strain, or Cauchy strain, expresses total deformation relative to the initial dimension of the material under load, reflecting elongation in axial loading"@en)
AnnotationAssertion(skos:example co:PMD_0080030 "A tensile specimen elongates from 50 mm to 55 mm gauge length, giving an engineering strain of 10 %"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080030 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080030 co:PMD_0080029)

# Class: co:PMD_0080031 (Kriechdehnung)

AnnotationAssertion(obo:IAO_0000117 co:PMD_0080031 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080031 "Kriechdehnung"@de)
AnnotationAssertion(rdfs:label co:PMD_0080031 "creep strain"@en)
AnnotationAssertion(skos:definition co:PMD_0080031 "Creep strain occurs when a material is subjected to constant stress over a long period of time"@en)
AnnotationAssertion(skos:example co:PMD_0080031 "A nickel alloy turbine blade accumulates 0.5 % creep strain after 10000 hours at 900 C"@en)
SubClassOf(co:PMD_0080031 ObjectIntersectionOf(co:PMD_0080029 ObjectSomeValuesFrom(obo:RO_0002328 ObjectIntersectionOf(co:PMD_0020132 ObjectSomeValuesFrom(obo:RO_0000080 ObjectIntersectionOf(obo:BFO_0000004 ObjectSomeValuesFrom(obo:RO_0000056 co:PMD_0000596)))))))

# Class: co:PMD_0080032 (true strain)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080032 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080032 "Necessary and sufficient conditions for 'true strain' have not yet been formalized. The term is defined as a specific subtype of 'strain'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Strain_(mechanics)."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080032 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080032 <https://en.wikipedia.org/wiki/Strain_(mechanics)>)
AnnotationAssertion(rdfs:label co:PMD_0080032 "true strain"@en)
AnnotationAssertion(rdfs:label co:PMD_0080032 "wahre Dehnung"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080032 "Hencky strain"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080032 "logarithmic strain"@en)
AnnotationAssertion(skos:definition co:PMD_0080032 "True strain, or logarithmic strain, integrates incrementally over deformation; related to engineering strain as ε=ln(1+e)"@en)
AnnotationAssertion(skos:definition co:PMD_0080032 "Wahre Dehnung, auch als logarithmische Dehnung bekannt, integriert sich schrittweise über die Verformung; in Beziehung zum technischen Dehnungsmaß als ε=ln(1+e)"@de)
AnnotationAssertion(skos:example co:PMD_0080032 "At a cross-section reduction of 50 %, the true strain is ln(2) = 0.693"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080032 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080032 co:PMD_0080029)

# Class: co:PMD_0080033 (Bruchdehnung)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080033 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080033 "StrainAtBreak(x) ↔ Strain(x) ∧ ∃b∃p∃i(obo:BFO_0000040(b) ∧ MeasurementProcess(p) ∧ MeasurementInformationContentEntity(i) ∧ bearerOf(b, x) ∧ describes(i, x) ∧ isOutputOf(i, p) ∧ ∃t(TimeOfBreak(t) ∧ occupiesTemporalRegion(p, t)))"@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080033 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080033 "Bruchdehnung"@de)
AnnotationAssertion(rdfs:label co:PMD_0080033 "strain at break"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080033 "elongation at break"@en)
AnnotationAssertion(skos:definition co:PMD_0080033 "Bruchdehnung ist die Dehnung einer Probe im Moment des Bruchs, bestimmt unter Zugbelastung gemäß anwendbaren Prüfnormen"@de)
AnnotationAssertion(skos:definition co:PMD_0080033 "Strain at break is the strain of a specimen at the moment of fracture, determined under tensile load according to applicable test standards"@en)
AnnotationAssertion(skos:example co:PMD_0080033 "Strain at break of a thermoplastic polyurethane specimen measured as 450% under ISO 527 test conditions."@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080033 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080033 obo:BFO_0000017)
SubClassOf(co:PMD_0080033 co:PMD_0020335)
SubClassOf(co:PMD_0080033 co:PMD_0023004)
SubClassOf(co:PMD_0080033 ObjectSomeValuesFrom(obo:BFO_0000054 co:PMD_0020339))
SubClassOf(co:PMD_0080033 ObjectSomeValuesFrom(obo:RO_0000052 co:PMD_0000001))

# Class: co:PMD_0080034 (elastische Deformation)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080034 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080034 "Necessary and sufficient conditions for 'elastic strain' have not yet been formalized. The term is defined as a specific subtype of 'strain'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Plasticity_(physics)."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080034 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080034 <https://en.wikipedia.org/wiki/Plasticity_(physics)>)
AnnotationAssertion(rdfs:label co:PMD_0080034 "elastic strain"@en)
AnnotationAssertion(rdfs:label co:PMD_0080034 "elastische Deformation"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080034 "elastic deformation"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080034 "elastische Verformung"@de)
AnnotationAssertion(skos:definition co:PMD_0080034 "Bei der elastischen Dehnung handelt es sich um eine Dehnungsqualität eines Materialgebildes, die durch eine reversible Verformung gekennzeichnet ist, die bei Wegnahme der aufgebrachten Last verschwindet"@de)
AnnotationAssertion(skos:definition co:PMD_0080034 "Elastic strain is a strain quality of a material entity characterized by reversible deformation that disappears upon removal of the applied load"@en)
AnnotationAssertion(skos:example co:PMD_0080034 "Steel loaded to 200 MPa exhibits an elastic strain of about 0.001, fully recovered upon unloading"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080034 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080034 co:PMD_0080029)

# Class: co:PMD_0080035 (plastic strain)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080035 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080035 "Necessary and sufficient conditions for 'plastic strain' have not yet been formalized. The term is defined as a specific subtype of 'strain'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Plasticity_(physics)."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080035 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080035 <https://en.wikipedia.org/wiki/Plasticity_(physics)>)
AnnotationAssertion(rdfs:label co:PMD_0080035 "plastic strain"@en)
AnnotationAssertion(rdfs:label co:PMD_0080035 "plastische Deformation"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080035 "plastic deformation"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080035 "plastische Verformung"@de)
AnnotationAssertion(skos:definition co:PMD_0080035 "Plastic strain describes permanent deformation occurring when a material is subjected to stress beyond its elastic limit"@en)
AnnotationAssertion(skos:definition co:PMD_0080035 "Plastische Deformation beschreibt die dauerhafte Verformung, die auftritt, wenn ein Material einer Belastung ausgesetzt wird, die über seine elastische Grenze hinausgeht"@de)
AnnotationAssertion(skos:example co:PMD_0080035 "After exceeding yield strength, a steel rod undergoes 5 % plastic strain that remains after unloading"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080035 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080035 co:PMD_0080029)

# Class: co:PMD_0080036 (luminous intensity)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080036 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080036 "Necessary and sufficient conditions for 'luminous intensity' have not yet been formalized. The term is defined as a specific subtype of 'optical quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080036 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080036 "Lichtstärke in cd gemessen"@de)
AnnotationAssertion(rdfs:label co:PMD_0080036 "luminous intensity"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080036 "Leuchtintensität"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080036 "Lichtintensität"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080036 "luminous intensity"@en)
AnnotationAssertion(skos:definition co:PMD_0080036 "Lichtstärke ist die Menge des sichtbaren Lichts, das pro Einheitswinkel in eine bestimmte Richtung von einer Quelle abgestrahlt wird, gemessen in Candela (cd)"@de)
AnnotationAssertion(skos:definition co:PMD_0080036 "Luminous intensity quantifies the visible light emitted per unit solid angle in a particular direction from a source, measured in candela (cd)"@en)
AnnotationAssertion(skos:example co:PMD_0080036 "A standard LED lamp emits a luminous intensity of 800 cd in the forward direction"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080036 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080036 co:PMD_0000008)

# Class: co:PMD_0080037 (Belichtungszeit)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080037 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080037 "Necessary and sufficient conditions for 'exposure' have not yet been formalized. The term is defined as a specific subtype of 'optical quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Exposure_(photography)."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080037 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080037 <https://en.wikipedia.org/wiki/Exposure_(photography)>)
AnnotationAssertion(rdfs:label co:PMD_0080037 "Belichtungszeit"@de)
AnnotationAssertion(rdfs:label co:PMD_0080037 "light exposure"@en)
AnnotationAssertion(skos:definition co:PMD_0080037 "Exposure in photography refers to the amount of light per unit area reaching film or sensor, determined by shutter speed, lens F-number, and scene luminance"@en)
AnnotationAssertion(skos:definition co:PMD_0080037 "Unter Belichtung versteht man in der Fotografie die Lichtmenge pro Flächeneinheit, die den Film oder Sensor erreicht, bestimmt durch Verschlusszeit, Blendenzahl des Objektivs und Helligkeit der Szene"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080037 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080037 co:PMD_0000143)

# Class: co:PMD_0080038 (Curie temperature)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080038 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080038 "Necessary and sufficient conditions for 'Curie temperature' have not yet been formalized. The term is defined as a specific subtype of 'thermo dynamic quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080038 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080038 "Curie temperature"@en)
AnnotationAssertion(rdfs:label co:PMD_0080038 "Curie-Temperatur"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080038 "Curie point"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080038 "Curie-Punkt"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080038 "T_C"@en)
AnnotationAssertion(skos:definition co:PMD_0080038 "Curie temperature is a thermodynamic quality of a ferromagnetic material that specifies the temperature above which it loses its permanent magnetic ordering and becomes paramagnetic"@en)
AnnotationAssertion(skos:definition co:PMD_0080038 "Curie-Temperatur ist eine thermodynamische Qualität eines ferromagnetischen Materials, die die Temperatur angibt, oberhalb derer das Material seine permanente magnetische Ordnung verliert und paramagnetisch wird"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080038 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080038 co:PMD_0020353)

# Class: co:PMD_0080039 (spezifische Wärmekapazität)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080039 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080039 "Necessary and sufficient conditions for 'specific heat capacity' have not yet been formalized. The term is defined as a specific subtype of 'thermo dynamic quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080039 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080039 "specific heat capacity"@en)
AnnotationAssertion(rdfs:label co:PMD_0080039 "spezifische Wärmekapazität"@de)
AnnotationAssertion(skos:definition co:PMD_0080039 "Specific heat capacity is the heat capacity of a sample divided by its mass, representing the heat required to raise temperature by one unit"@en)
AnnotationAssertion(skos:definition co:PMD_0080039 "Spezifische Wärmekapazität ist die Wärmekapazität einer Probe geteilt durch ihre Masse und repräsentiert die erforderliche Wärme, um die Temperatur um eine Einheit zu erhöhen"@de)
AnnotationAssertion(skos:example co:PMD_0080039 "Water has a specific heat capacity of 4182 J/(kg·K), making it an effective coolant"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080039 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080039 co:PMD_0020313)

# Class: co:PMD_0080040 (eutectic point)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080040 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080040 "Necessary and sufficient conditions for 'eutectic point' have not yet been formalized. The term is defined as a specific subtype of 'thermo dynamic quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080040 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080040 "eutectic point"@en)
AnnotationAssertion(rdfs:label co:PMD_0080040 "eutektischer Punkt"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080040 "eutectic temperature"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080040 "eutektische Temperatur"@de)
AnnotationAssertion(skos:definition co:PMD_0080040 "Eutectic point is a thermodynamic quality of a multi-component material system that specifies the composition and temperature at which all components simultaneously solidify from a liquid mixture at the lowest possible melting temperature"@en)
AnnotationAssertion(skos:definition co:PMD_0080040 "Eutektischer Punkt ist eine thermodynamische Qualität eines Mehrkomponentenmaterialsystems, die die Zusammensetzung und Temperatur angibt, bei der alle Komponenten gleichzeitig aus einer flüssigen Mischung bei der niedrigstmöglichen Schmelztemperatur erstarren"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080040 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080040 co:PMD_0020164)

# Class: co:PMD_0080041 (kritischer Druck)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080041 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080041 "Necessary and sufficient conditions for 'critical pressure' have not yet been formalized. The term is defined as a specific subtype of 'thermo dynamic quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080041 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080041 "critical pressure"@en)
AnnotationAssertion(rdfs:label co:PMD_0080041 "kritischer Druck"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080041 "p_c"@en)
AnnotationAssertion(skos:definition co:PMD_0080041 "Critical pressure is a thermodynamic quality of a pure substance that specifies the minimum pressure required to liquefy the substance at its critical temperature"@en)
AnnotationAssertion(skos:definition co:PMD_0080041 "Kritischer Druck ist eine thermodynamische Qualität einer reinen Substanz, die den Mindestdruck angibt, der erforderlich ist, um die Substanz bei ihrer kritischen Temperatur zu verflüssigen"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080041 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080041 co:PMD_0020353)

# Class: co:PMD_0080042 (kritische Temperatur)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080042 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080042 "Necessary and sufficient conditions for 'critical temperature' have not yet been formalized. The term is defined as a specific subtype of 'thermo dynamic quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080042 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080042 "critical temperature"@en)
AnnotationAssertion(rdfs:label co:PMD_0080042 "kritische Temperatur"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080042 "T_c"@en)
AnnotationAssertion(skos:definition co:PMD_0080042 "Critical temperature is a thermodynamic quality of a pure substance that specifies the temperature above which the substance cannot exist as a liquid regardless of applied pressure"@en)
AnnotationAssertion(skos:definition co:PMD_0080042 "Kritische Temperatur ist eine thermodynamische Qualität einer reinen Substanz, die die Temperatur angibt, oberhalb derer die Substanz unabhängig vom aufgebrachten Druck nicht als Flüssigkeit existieren kann"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080042 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080042 co:PMD_0020353)

# Class: co:PMD_0080044 (aging temperature)

AnnotationAssertion(rdfs:label co:PMD_0080044 "aging temperature"@en)
AnnotationAssertion(skos:definition co:PMD_0080044 "Aging temperature refers to variable temperature during an aging process depending on the desired deposition formations"@en)
AnnotationAssertion(skos:example co:PMD_0080044 "Al-Cu alloys are artificially aged at 175 C to precipitate strengthening phases"@en)
SubClassOf(co:PMD_0080044 co:PMD_0000008)
SubClassOf(co:PMD_0080044 ObjectSomeValuesFrom(owl:topObjectProperty ObjectIntersectionOf(obo:BFO_0000040 ObjectSomeValuesFrom(obo:RO_0000056 obo:BFO_0000015) ObjectSomeValuesFrom(obo:RO_0000086 co:PMD_0000967))))
SubClassOf(co:PMD_0080044 ObjectSomeValuesFrom(co:PMD_0025006 co:PMD_0000513))

# Class: co:PMD_0080045 (Umgebungstemperatur)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080045 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080045 "Necessary and sufficient conditions for 'environmental temperature' have not yet been formalized. The term is defined as a specific subtype of 'temperature'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080045 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080045 "Umgebungstemperatur"@de)
AnnotationAssertion(rdfs:label co:PMD_0080045 "environmental temperature"@en)
AnnotationAssertion(skos:definition co:PMD_0080045 "Environmental temperature describes the observed temperature surrounding a tangible object, including room temperature and temperatures measured in test chambers"@en)
AnnotationAssertion(skos:definition co:PMD_0080045 "Umgebungstemperatur ist die Eigenschaft, die die beobachtete Temperatur in der Umgebung eines betrachteten materiellen Objekts beschreibt. Dazu gehören Raumtemperatur und die in Prüfkammern gemessenen Temperaturen"@de)
AnnotationAssertion(skos:example co:PMD_0080045 "A circuit board operates at an environmental temperature of 85 C in a high-reliability application"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080045 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080045 co:PMD_0020353)

# Class: co:PMD_0080046 (Dampfdruck)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080046 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080046 "Necessary and sufficient conditions for 'vapor pressure' have not yet been formalized. The term is defined as a specific subtype of 'thermo dynamic quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080046 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080046 "Dampfdruck"@de)
AnnotationAssertion(rdfs:label co:PMD_0080046 "vapor pressure"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080046 "p*"@en)
AnnotationAssertion(skos:definition co:PMD_0080046 "Dampfdruck ist eine thermodynamische Qualität eines Stoffes, die den Druck angibt, den sein Dampf ausübt, wenn er sich bei einer gegebenen Temperatur im thermodynamischen Gleichgewicht mit seiner kondensierten Phase befindet"@de)
AnnotationAssertion(skos:definition co:PMD_0080046 "Vapor pressure is a thermodynamic quality of a substance that specifies the pressure exerted by its vapor when in thermodynamic equilibrium with its condensed phase at a given temperature"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080046 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080046 co:PMD_0020353)

# Class: co:PMD_0080047 (flash point)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080047 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080047 "Necessary and sufficient conditions for 'flash point' have not yet been formalized. The term is defined as a specific subtype of 'thermo dynamic quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080047 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080047 "Flammpunkt"@de)
AnnotationAssertion(rdfs:label co:PMD_0080047 "flash point"@en)
AnnotationAssertion(skos:definition co:PMD_0080047 "Flammpunkt ist eine thermodynamische Qualität eines flüchtigen Materials, die die niedrigste Temperatur angibt, bei der sein Dampf an der Materialoberfläche ein zündfähiges Gemisch mit Luft bildet"@de)
AnnotationAssertion(skos:definition co:PMD_0080047 "Flash point is a thermodynamic quality of a volatile material that specifies the lowest temperature at which its vapour forms an ignitable mixture with air near the surface of the material"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080047 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080047 co:PMD_0020353)

# Class: co:PMD_0080048 (ductile-brittle transition temperature)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080048 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080048 "Necessary and sufficient conditions for 'ductile-brittle transition temperature' have not yet been formalized. The term is defined as a specific subtype of 'thermo dynamic quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080048 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080048 "Duktil-Spröd-Übergangstemperatur"@de)
AnnotationAssertion(rdfs:label co:PMD_0080048 "ductile-brittle transition temperature"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080048 "Nullduktilitäts-Übergangstemperatur"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080048 "T_DBTT"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080048 "nil ductility transition temperature"@en)
AnnotationAssertion(skos:definition co:PMD_0080048 "Ductile-brittle transition temperature is a thermodynamic quality of a material that specifies the temperature below which the material exhibits brittle fracture behaviour rather than ductile deformation under impact loading"@en)
AnnotationAssertion(skos:definition co:PMD_0080048 "Duktil-Spröd-Übergangstemperatur ist eine thermodynamische Qualität eines Materials, die die Temperatur angibt, unterhalb derer das Material unter Schlagbelastung ein sprödes Bruchverhalten anstelle einer duktilen Verformung zeigt"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080048 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080048 co:PMD_0020353)

# Class: co:PMD_0080049 (Glasübergangstemperatur)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080049 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080049 "Necessary and sufficient conditions for 'glass transition temperature' have not yet been formalized. The term is defined as a specific subtype of 'ductile-brittle transition temperature' specific to amorphous and semi-crystalline materials. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Glass_transition."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080049 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080049 <https://en.wikipedia.org/wiki/Glass_transition>)
AnnotationAssertion(rdfs:label co:PMD_0080049 "Glasübergangstemperatur"@de)
AnnotationAssertion(rdfs:label co:PMD_0080049 "glass transition temperature"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080049 "Tg"@en)
AnnotationAssertion(skos:definition co:PMD_0080049 "Glass transition temperature is a ductile-brittle transition temperature of an amorphous or semi-crystalline material that specifies the temperature at which the material transitions from a hard, glassy state to a soft, rubbery state upon heating"@en)
AnnotationAssertion(skos:definition co:PMD_0080049 "Glasübergangstemperatur ist eine Duktil-Spröd-Übergangstemperatur eines amorphen oder teilkristallinen Materials, die die Temperatur beschreibt, bei der das Material beim Erwärmen von einem harten, glasartigen in einen weichen, gummiartigen Zustand übergeht"@de)
AnnotationAssertion(skos:example co:PMD_0080049 "Glass transition temperature of polycarbonate measured at approximately 147 °C, above which the material softens and loses rigidity, determined according to ISO 11357-2."@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080049 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080049 co:PMD_0080048)

# Class: co:PMD_0080050 (entropy)

AnnotationAssertion(obo:IAO_0000117 co:PMD_0080050 "Philipp von Hartrott")
AnnotationAssertion(rdfs:comment co:PMD_0080050 "SI unit: joules per kelvin (J/K)

Statistical definition (Boltzmann):
S=k_B ln(W)
where k_B​ is the Boltzmann constant and W is the number of microstates."@en)
AnnotationAssertion(rdfs:label co:PMD_0080050 "entropy"@en)
AnnotationAssertion(skos:definition co:PMD_0080050 "Entropy is a measure of the disorder or randomness of a system — more precisely, the number of microscopic arrangements (microstates) consistent with the system's macroscopic state."@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080050 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080050 ObjectIntersectionOf(co:PMD_0020142 ObjectSomeValuesFrom(obo:RO_0000080 co:PMD_0020128)))

# Class: co:PMD_0080051 (surface energy)

AnnotationAssertion(obo:IAO_0000116 co:PMD_0080051 "The surface energy is the difference of inner energy of the object that is caused by the peseence or absence of the fiat surface"@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080051 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080051 "surface energy"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080051 "surface free energy"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080051 "γ"@en)
AnnotationAssertion(skos:definition co:PMD_0080051 "Surface energy is an energy quality of a material that quantifies the excess energy at its surface relative to the bulk, arising from unsatisfied molecular bonds at the interface"@en)
SubClassOf(co:PMD_0080051 co:PMD_0020142)
SubClassOf(co:PMD_0080051 co:PMD_0020317)
SubClassOf(co:PMD_0080051 ObjectSomeValuesFrom(obo:RO_0000080 ObjectIntersectionOf(obo:BFO_0000030 ObjectSomeValuesFrom(obo:BFO_0000051 obo:BFO_0000146))))

# Class: co:PMD_0080052 (enthalpy)

AnnotationAssertion(rdfs:label co:PMD_0080052 "enthalpy"@en)
AnnotationAssertion(skos:definition co:PMD_0080052 "enthalpy H is the sum of internal energy and the product of pressure and volume"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080052 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080052 co:PMD_0020142)
SubClassOf(co:PMD_0080052 ObjectIntersectionOf(ObjectSomeValuesFrom(obo:RO_0002328 co:PMD_0000896) ObjectSomeValuesFrom(obo:RO_0002328 co:PMD_0020150) ObjectSomeValuesFrom(obo:RO_0002328 co:PMD_0020151)))

# Class: co:PMD_0080053 (melting enthalpy)

AnnotationAssertion(rdfs:label co:PMD_0080053 "melting enthalpy"@en)
AnnotationAssertion(skos:definition co:PMD_0080053 "the amount of energy required to convert an entity from solid to liquid aggregtate state at constant temperature and pressure"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080053 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080053 co:PMD_0080052)

# Class: co:PMD_0080054 (enthalpy of vaporization)

AnnotationAssertion(rdfs:label co:PMD_0080054 "enthalpy of vaporization"@en)
AnnotationAssertion(skos:definition co:PMD_0080054 "the amount of energy required to convert an entity from liquid to gaseous aggregtate state at constant temperature and pressure"@en)
SubClassOf(co:PMD_0080054 co:PMD_0080052)

# Class: co:PMD_0080055 (auto-ignition temperature)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080055 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080055 "Necessary and sufficient conditions for 'auto-ignition temperature' have not yet been formalized. The term is defined as a specific subtype of 'thermo dynamic quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080055 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080055 "Selbstzündungstemperatur"@de)
AnnotationAssertion(rdfs:label co:PMD_0080055 "auto-ignition temperature"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080055 "T_AIT"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080055 "Zündtemperatur"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080055 "spontaneous ignition temperature"@en)
AnnotationAssertion(skos:definition co:PMD_0080055 "Auto-ignition temperature is a thermodynamic quality of a substance that specifies the lowest temperature at which it spontaneously ignites in a normal atmosphere without an external ignition source"@en)
AnnotationAssertion(skos:definition co:PMD_0080055 "Selbstzündungstemperatur ist eine thermodynamische Qualität eines Stoffes, die die niedrigste Temperatur angibt, bei der er sich in normaler Atmosphäre ohne externe Zündquelle selbst entzündet"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080055 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080055 co:PMD_0020353)

# Class: co:PMD_0080056 (Reynolds-Zahl)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080056 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080056 "Might be a process attribute of a viscous fluid flowing (in a channel)"@en)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080056 "Necessary and sufficient conditions for 'Reynolds number' have not yet been formalized. The term is defined as a specific subtype of 'FluidDynamicQuality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Reynolds_number."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080056 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080056 <https://en.wikipedia.org/wiki/Reynolds_number>)
AnnotationAssertion(rdfs:label co:PMD_0080056 "Reynolds number"@en)
AnnotationAssertion(rdfs:label co:PMD_0080056 "Reynolds-Zahl"@de)
AnnotationAssertion(skos:definition co:PMD_0080056 "Reynolds number is a dimensionless quantity predicting fluid flow patterns, measuring the ratio between inertial and viscous forces"@en)
AnnotationAssertion(skos:definition co:PMD_0080056 "Reynolds-Zahl ist eine dimensionslose Größe zur Vorhersage von Strömungsmustern in Flüssigkeiten, die das Verhältnis zwischen Trägheits- und Viskosekräften misst"@de)
AnnotationAssertion(skos:example co:PMD_0080056 "Flow in a 25 mm pipe at 2 m/s has a Reynolds number of about 50000, indicating turbulent regime"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080056 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080056 co:PMD_0020316)

# Class: co:PMD_0080057 (Geruch)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080057 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080057 "Necessary and sufficient conditions for 'odor' have not yet been formalized. The term is defined as a specific subtype of 'olfactoric quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0000058."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080057 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080057 obo:PATO_0000058)
AnnotationAssertion(rdfs:label co:PMD_0080057 "Geruch"@de)
AnnotationAssertion(rdfs:label co:PMD_0080057 "odor"@en)
AnnotationAssertion(skos:definition co:PMD_0080057 "Geruch ist eine morphologische Eigenschaft, die einem Träger innewohnt, dessen Moleküle von einem Geruchsrezeptor verteilt und wahrgenommen werden"@de)
AnnotationAssertion(skos:definition co:PMD_0080057 "Odor is a morphologic quality inhering in a bearer whose molecules are dispersed and perceived by an odorant receptor"@en)
AnnotationAssertion(skos:example co:PMD_0080057 "The characteristic odor of acetic acid is detectable in dilute vinegar solutions"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080057 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080057 co:PMD_0020353)

# Class: co:PMD_0080061 (radius)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080061 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080061 "Necessary and sufficient conditions for 'radius' have not yet been formalized. The term is defined as a specific subtype of 'length'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0002390."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080061 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080061 obo:PATO_0002390)
AnnotationAssertion(rdfs:label co:PMD_0080061 "Radius"@de)
AnnotationAssertion(rdfs:label co:PMD_0080061 "radius"@en)
AnnotationAssertion(skos:definition co:PMD_0080061 "Radius is a length quality equal to the distance from the center of a circle to any endpoint on the circular boundary"@en)
AnnotationAssertion(skos:definition co:PMD_0080061 "Radius ist eine Längeneigenschaft, die gleich der Entfernung vom Mittelpunkt eines Kreises zu einem beliebigen Endpunkt auf der Kreisgrenze ist"@de)
AnnotationAssertion(skos:example co:PMD_0080061 "A cylindrical specimen has a radius of 5 mm, giving a cross-sectional area of 78.5 mm2"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080061 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080061 co:PMD_0040001)

# Class: co:PMD_0080065 (Wellenlänge)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080065 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080065 "Necessary and sufficient conditions for 'wavelength' have not yet been formalized. The term is defined as a specific subtype of 'length'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://www.oxfordreference.com/display/10.1093/oi/authority.20110803121421585."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080065 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080065 <https://www.oxfordreference.com/display/10.1093/oi/authority.20110803121421585>)
AnnotationAssertion(rdfs:label co:PMD_0080065 "Wellenlänge"@de)
AnnotationAssertion(rdfs:label co:PMD_0080065 "wavelength"@en)
AnnotationAssertion(skos:definition co:PMD_0080065 "Wavelength is the distance between successive peaks or troughs of a wave, equal to wave speed divided by frequency"@en)
AnnotationAssertion(skos:definition co:PMD_0080065 "Wellenlänge ist die Entfernung zwischen aufeinanderfolgenden Gipfeln oder Tälern einer Welle, gleich der Wellenbewegungsgeschwindigkeit geteilt durch die Frequenz"@de)
AnnotationAssertion(skos:example co:PMD_0080065 "A green laser pointer emits light at a wavelength of 532 nm"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080065 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080065 co:PMD_0000008)

# Class: co:PMD_0080066 (Höhe)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080066 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080066 "Necessary and sufficient conditions for 'height' have not yet been formalized. The term is defined as a specific subtype of 'length'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0000119."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080066 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080066 obo:PATO_0000119)
AnnotationAssertion(rdfs:label co:PMD_0080066 "Höhe"@de)
AnnotationAssertion(rdfs:label co:PMD_0080066 "height"@en)
AnnotationAssertion(skos:definition co:PMD_0080066 "Die Höhe ist eine eindimensionale Ausdehnungsqualität, die die vertikale Abmessung eines Objekts oder Raums beschreibt, gemessen von der Basis bis zur Spitze"@de)
AnnotationAssertion(skos:definition co:PMD_0080066 "Height is a 1-D extent quality describing the vertical dimension of an object or space, measured from the base to the top"@en)
AnnotationAssertion(skos:example co:PMD_0080066 "A steel column has a height of 3.6 m between floor and ceiling connections"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080066 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080066 co:PMD_0040001)

# Class: co:PMD_0080067 (Umfang)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080067 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080067 "Necessary and sufficient conditions for 'perimeter' have not yet been formalized. The term is defined as a specific subtype of 'length'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0001711."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080067 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080067 obo:PATO_0001711)
AnnotationAssertion(rdfs:label co:PMD_0080067 "Umfang"@de)
AnnotationAssertion(rdfs:label co:PMD_0080067 "perimeter"@en)
AnnotationAssertion(skos:definition co:PMD_0080067 "Der Umfang misst eine eindimensionale Ausdehnung, die einem zweidimensionalen Träger innewohnt und die Entfernung um ihn herum darstellt"@de)
AnnotationAssertion(skos:definition co:PMD_0080067 "Perimeter measures a 1-D extent inhering in a two-dimensional bearer, representing the distance around it"@en)
AnnotationAssertion(skos:example co:PMD_0080067 "The perimeter of a square cross-section beam of 50 mm side length is 200 mm"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080067 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080067 co:PMD_0040001)

# Class: co:PMD_0080068 (Kreisumfang)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080068 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080068 "Necessary and sufficient conditions for 'circumference' have not yet been formalized. The term is defined as a specific subtype of 'perimeter'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0001648."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080068 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080068 obo:PATO_0001648)
AnnotationAssertion(rdfs:label co:PMD_0080068 "Kreisumfang"@de)
AnnotationAssertion(rdfs:label co:PMD_0080068 "circumference"@en)
AnnotationAssertion(skos:definition co:PMD_0080068 "Circumference characterizes a 1-D extent equal to the length of the closed curve of a circle"@en)
AnnotationAssertion(skos:definition co:PMD_0080068 "Der Umfang charakterisiert eine eindimensionale Ausdehnung, die der Länge der geschlossenen Kurve eines Kreises entspricht"@de)
AnnotationAssertion(skos:example co:PMD_0080068 "A wire of 2 mm diameter has a circumference of 6.28 mm"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080068 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080068 co:PMD_0080067)

# Class: co:PMD_0080069 (physisch relative Qualität)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080069 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080069 "Necessary and sufficient conditions for 'physical relational quality' have not yet been formalized. The term is defined as a specific subtype of 'BFO_0000145'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080069 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080069 "physical relational quality"@en)
AnnotationAssertion(rdfs:label co:PMD_0080069 "physisch relative Qualität"@de)
AnnotationAssertion(skos:definition co:PMD_0080069 "Die physische Beziehungsqualität bezieht sich auf Eigenschaften oder Merkmale einer Entität, die von ihrer Beziehung zu anderen Entitäten abhängig sind"@de)
AnnotationAssertion(skos:definition co:PMD_0080069 "Physical relational quality pertains to properties or characteristics of an entity dependent on its relation to other entities"@en)
AnnotationAssertion(skos:example co:PMD_0080069 "The coefficient of friction between two surfaces is a physical relational quality inhering in both contacting materials"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080069 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080069 co:PMD_0020353)

# Class: co:PMD_0080070 (physical rate quality)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080070 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080070 "Necessary and sufficient conditions for 'physical rate quality' have not yet been formalized. The term is defined as a specific subtype of 'physical relational quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080070 "Rate =(def.) a measure, quantity, or frequency, typically one measured against some other quantity or measure"@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080070 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080070 "physical rate quality"@en)
AnnotationAssertion(rdfs:label co:PMD_0080070 "physische Geschwindigkeitsqualität"@de)
AnnotationAssertion(skos:definition co:PMD_0080070 "Die physikalische Geschwindigkeitsqualität bezeichnet den Quotienten zweier physikalischer Größen in unterschiedlichen Einheiten, der die Änderungsrate einer Größe im Verhältnis zu einer anderen darstellt"@de)
AnnotationAssertion(skos:definition co:PMD_0080070 "Physical rate quality denotes the quotient of two physical quantities in different units, representing one quantity's rate of change in relation to another"@en)
AnnotationAssertion(skos:example co:PMD_0080070 "The rate of thermal expansion of a metal rod during quenching is a physical rate quality"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080070 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080070 co:PMD_0080069)

# Class: co:PMD_0080071 (emissivity)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080071 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080071 "Necessary and sufficient conditions for 'emissivity' have not yet been formalized. The term is defined as a specific subtype of 'physical rate quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080071 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080071 "Emissionsgrad"@de)
AnnotationAssertion(rdfs:label co:PMD_0080071 "emissivity"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080071 "Emissivität"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080071 "ε"@en)
AnnotationAssertion(skos:definition co:PMD_0080071 "Emissionsgrad ist eine physikalische Ratenqualität einer Materialoberfläche, die das Verhältnis der von der Oberfläche emittierten Wärmestrahlung zu der eines idealen schwarzen Körpers bei gleicher Temperatur ausdrückt"@de)
AnnotationAssertion(skos:definition co:PMD_0080071 "Emissivity is a physical rate quality of a material surface that expresses the ratio of thermal radiation emitted by the surface to that emitted by a perfect blackbody at the same temperature"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080071 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080071 co:PMD_0020353)

# Class: co:PMD_0080072 (relative isotopic mass)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080072 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080072 "Necessary and sufficient conditions for 'relative isotopic mass' have not yet been formalized. The term is defined as a specific subtype of 'physical rate quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Atomic_mass."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080072 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080072 <https://en.wikipedia.org/wiki/Atomic_mass>)
AnnotationAssertion(rdfs:label co:PMD_0080072 "relative Isotopenmasse"@de)
AnnotationAssertion(rdfs:label co:PMD_0080072 "relative isotopic mass"@en)
AnnotationAssertion(skos:definition co:PMD_0080072 "Relative Isotopenmasse bezieht sich auf die Masse eines einzelnen Isotops im Vergleich zu 1/12 der Masse eines Kohlenstoff-12-Atoms"@de)
AnnotationAssertion(skos:definition co:PMD_0080072 "Relative isotopic mass refers to the mass of a single isotope compared to 1/12 of the mass of a carbon-12 atom"@en)
AnnotationAssertion(skos:example co:PMD_0080072 "The relative isotopic mass of carbon-13 is 13.003 u, slightly heavier than carbon-12"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080072 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080072 co:PMD_0020353)

# Class: co:PMD_0080073 (Lichtausbeute)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080073 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080073 "Necessary and sufficient conditions for 'luminous efficacy' have not yet been formalized. The term is defined as a specific subtype of 'physical rate quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Luminous_efficacy."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080073 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080073 <https://en.wikipedia.org/wiki/Luminous_efficacy>)
AnnotationAssertion(rdfs:label co:PMD_0080073 "Lichtausbeute"@de)
AnnotationAssertion(rdfs:label co:PMD_0080073 "luminous efficacy"@en)
AnnotationAssertion(skos:definition co:PMD_0080073 "Die Lichtausbeute misst, wie gut eine Lichtquelle sichtbares Licht erzeugt, berechnet als Lichtstrom geteilt durch Leistung, ausgedrückt in Lumen pro Watt"@de)
AnnotationAssertion(skos:definition co:PMD_0080073 "Luminous efficacy measures how well a light source produces visible light, calculated as luminous flux divided by power, expressed in lumens per watt"@en)
AnnotationAssertion(skos:example co:PMD_0080073 "A modern LED achieves a luminous efficacy of 200 lm/W, far exceeding incandescent bulbs"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080073 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080073 co:PMD_0020353)

# Class: co:PMD_0080074 (optical absorptance)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080074 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080074 "Necessary and sufficient conditions for 'optical absorptance' have not yet been formalized. The term is defined as a specific subtype of 'physical rate quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080074 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080074 "optical absorptance"@en)
AnnotationAssertion(rdfs:label co:PMD_0080074 "optische Absorption"@de)
AnnotationAssertion(skos:definition co:PMD_0080074 "Die optische Absorption definiert das Verhältnis der absorbierten Strahlungsleistung zur einfallenden Strahlungsleistung und gibt Aufschluss über die Absorptionsfähigkeit eines Mediums"@de)
AnnotationAssertion(skos:definition co:PMD_0080074 "Optical absorptance defines the ratio of absorbed radiant power to incident radiant power, indicating a medium's absorption capability"@en)
AnnotationAssertion(skos:example co:PMD_0080074 "A solar absorber coating has an optical absorptance of 0.96, converting most sunlight to heat"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080074 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080074 co:PMD_0020353)

# Class: co:PMD_0080075 (optical transmittance)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080075 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080075 "Necessary and sufficient conditions for 'optical transmittance' have not yet been formalized. The term is defined as a specific subtype of 'physical rate quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080075 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080075 "optical transmittance"@en)
AnnotationAssertion(rdfs:label co:PMD_0080075 "optische Transmittance"@de)
AnnotationAssertion(skos:definition co:PMD_0080075 "Die optische Durchlässigkeit wird durch das Verhältnis der übertragenen Strahlungsleistung zur einfallenden Strahlungsleistung definiert und dient der Beurteilung der Übertragungseffizienz"@de)
AnnotationAssertion(skos:definition co:PMD_0080075 "Optical transmittance is defined by the ratio of transmitted radiant power to incident radiant power, assessing transmission efficiency"@en)
AnnotationAssertion(skos:example co:PMD_0080075 "A 3 mm thick soda-lime glass pane has an optical transmittance of 90 % in the visible range"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080075 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080075 co:PMD_0020353)

# Class: co:PMD_0080076 (Massendiffusivität)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080076 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080076 "Necessary and sufficient conditions for 'mass diffusivity' have not yet been formalized. The term is defined as a specific subtype of 'physical rate quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080076 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080076 "Massendiffusivität"@de)
AnnotationAssertion(rdfs:label co:PMD_0080076 "mass diffusivity"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080076 "D"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080076 "Diffusionskoeffizient"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080076 "diffusion coefficient"@en)
AnnotationAssertion(skos:definition co:PMD_0080076 "Mass diffusivity is a physical rate quality of a material that quantifies the rate at which a diffusing substance moves through it per unit concentration gradient, as described by Fick's first law"@en)
AnnotationAssertion(skos:definition co:PMD_0080076 "Massendiffusivität ist eine physikalische Ratenqualität eines Materials, die die Geschwindigkeit beschreibt, mit der eine diffundierende Substanz pro Konzentrationsgradienten durch das Material transportiert wird, gemäß dem ersten Fickschen Gesetz"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080076 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080076 co:PMD_0020353)

# Class: co:PMD_0080077 (optical reflectance)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080077 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080077 "Necessary and sufficient conditions for 'optical reflectance' have not yet been formalized. The term is defined as a specific subtype of 'physical rate quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080077 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080077 "optical reflectance"@en)
AnnotationAssertion(rdfs:label co:PMD_0080077 "optische Reflexion"@de)
AnnotationAssertion(skos:definition co:PMD_0080077 "Der optische Reflexionsgrad wird durch das Verhältnis der reflektierten Strahlungsleistung zur einfallenden Strahlungsleistung definiert und bewertet die Reflexionsfähigkeit"@de)
AnnotationAssertion(skos:definition co:PMD_0080077 "Optical reflectance is defined by the ratio of reflected radiant power to incident radiant power, assessing reflective capacity"@en)
AnnotationAssertion(skos:example co:PMD_0080077 "A silver mirror has an optical reflectance of 98 % at 600 nm wavelength"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080077 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080077 co:PMD_0020353)

# Class: co:PMD_0080078 (electromotive force)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080078 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080078 "Necessary and sufficient conditions for 'electromotive force' have not yet been formalized. The term is defined as a specific subtype of 'physical rate quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Electromotive_force."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080078 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080078 <https://en.wikipedia.org/wiki/Electromotive_force>)
AnnotationAssertion(rdfs:label co:PMD_0080078 "Quellenspannung"@de)
AnnotationAssertion(rdfs:label co:PMD_0080078 "electromotive force"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080078 "EMP"@en)
AnnotationAssertion(skos:definition co:PMD_0080078 "Electromotive force refers to energy transferred to an electric circuit per unit charge, measured in volts, produced by transducers converting forms of energy to electrical energy"@en)
AnnotationAssertion(skos:definition co:PMD_0080078 "Unter elektromotorischer Kraft versteht man die Energie, die pro Ladungseinheit auf einen Stromkreis übertragen wird. Sie wird in Volt gemessen und von Wandlern erzeugt, die Energieformen in elektrische Energie umwandeln"@de)
AnnotationAssertion(skos:example co:PMD_0080078 "A standard zinc-copper galvanic cell produces an electromotive force of 1.1 V"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080078 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080078 co:PMD_0020353)

# Class: co:PMD_0080079 (Feuchtigkeit)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080079 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080079 "Necessary and sufficient conditions for 'humidity' have not yet been formalized. The term is defined as a specific subtype of 'physical rate quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080079 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080079 "Feuchtigkeit"@de)
AnnotationAssertion(rdfs:label co:PMD_0080079 "humidity"@en)
AnnotationAssertion(skos:definition co:PMD_0080079 "Die Luftfeuchtigkeit charakterisiert den Partialdruck der Luft, der durch den Wasserdampfgehalt entsteht, definiert als das Verhältnis von Wassermasse zu Volumen des Medium-Wasser-Gemisches"@de)
AnnotationAssertion(skos:definition co:PMD_0080079 "Humidity characterizes air's partial pressure exerted by water vapor content, defined as the mass of water to volume of the medium-water mixture"@en)
AnnotationAssertion(skos:example co:PMD_0080079 "A drying oven maintains relative humidity below 5 % to prevent moisture absorption in polymer samples"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080079 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080079 co:PMD_0020353)

# Class: co:PMD_0080080 (Temperaturleitfähigkeit)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080080 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080080 "Necessary and sufficient conditions for 'thermal diffusivity' have not yet been formalized. Although thermal diffusivity is defined as a ratio of thermal conductivity to the product of density and specific heat capacity, a co-inherence axiom cannot uniquely identify this quality among all rate qualities of the same bearer. The term is defined as a specific subtype of 'physical rate quality'."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080080 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080080 "Temperaturleitfähigkeit"@de)
AnnotationAssertion(rdfs:label co:PMD_0080080 "thermal diffusivity"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080080 "Thermische Diffusivität"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080080 "α"@en)
AnnotationAssertion(skos:definition co:PMD_0080080 "Temperaturleitfähigkeit ist eine physikalische Ratenqualität eines Materials, die die Geschwindigkeit beschreibt, mit der Wärmeenergie im Verhältnis zur Wärmespeicherkapazität geleitet wird, ausgedrückt als Verhältnis der Wärmeleitfähigkeit zum Produkt aus Dichte und spezifischer Wärmekapazität"@de)
AnnotationAssertion(skos:definition co:PMD_0080080 "Thermal diffusivity is a physical rate quality of a material that quantifies the rate at which thermal energy is conducted relative to its capacity to store heat, expressed as the ratio of thermal conductivity to the product of density and specific heat capacity"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080080 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080080 co:PMD_0020353)

# Class: co:PMD_0080081 (work hardening coefficient)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080081 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080081 "Necessary and sufficient conditions for 'work hardening coefficient' have not yet been formalized. The term is defined as a specific subtype of 'physical rate quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080081 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080081 "Verfestigungsexponent"@de)
AnnotationAssertion(rdfs:label co:PMD_0080081 "work hardening coefficient"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080081 "Kaltverfestigungsexponent"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080081 "n"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080081 "strain hardening exponent"@en)
AnnotationAssertion(skos:definition co:PMD_0080081 "Verfestigungsexponent ist eine physikalische Ratenqualität eines Materials, die die Geschwindigkeit beschreibt, mit der die Fließspannung bei plastischer Verformung während der Kaltumformung zunimmt, ausgedrückt als Exponent n in der Hollomon-Potenzgesetzbeziehung"@de)
AnnotationAssertion(skos:definition co:PMD_0080081 "Work hardening coefficient is a physical rate quality of a material that quantifies the rate at which flow stress increases with plastic strain during cold working, expressed as the exponent n in the Hollomon power-law relation"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080081 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080081 co:PMD_0020353)

# Class: co:PMD_0080082 (coefficient of friction)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080082 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080082 "Necessary and sufficient conditions for 'coefficient of friction' have not yet been formalized. The term is defined as a specific subtype of 'physical relational quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080082 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080082 "Reibungskoeffizient"@de)
AnnotationAssertion(rdfs:label co:PMD_0080082 "coefficient of friction"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080082 "Reibwert"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080082 "friction coefficient"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080082 "μ"@en)
AnnotationAssertion(skos:definition co:PMD_0080082 "Coefficient of friction is a dimensionless scalar quality of a pair of surfaces in contact that expresses the ratio of the friction force between them to the normal force pressing them together"@en)
AnnotationAssertion(skos:definition co:PMD_0080082 "Der Reibungskoeffizient ist eine dimensionslose skalare Qualität eines Paars in Kontakt stehender Oberflächen, die das Verhältnis der Reibungskraft zwischen ihnen zur Normalkraft ausdrückt, die sie zusammendrückt"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080082 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080082 co:PMD_0020309)
SubClassOf(co:PMD_0080082 co:PMD_0020311)
SubClassOf(co:PMD_0080082 ObjectSomeValuesFrom(obo:RO_0000052 ObjectIntersectionOf(obo:BFO_0000146 ObjectSomeValuesFrom(obo:RO_0002000 co:PMD_0020293))))

# Class: co:PMD_0080083 (Induktion)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080083 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080083 "Necessary and sufficient conditions for 'inductance' have not yet been formalized. The term is defined as a specific subtype of 'physical relational quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Inductance."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080083 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080083 <https://en.wikipedia.org/wiki/Inductance>)
AnnotationAssertion(rdfs:label co:PMD_0080083 "Induktion"@de)
AnnotationAssertion(rdfs:label co:PMD_0080083 "inductance"@en)
AnnotationAssertion(skos:definition co:PMD_0080083 "Inductance is the tendency of an electrical conductor to oppose a change in electric current through electromagnetic induction, creating back electromotive force"@en)
AnnotationAssertion(skos:definition co:PMD_0080083 "Induktivität ist die Tendenz eines elektrischen Leiters, einer Änderung des elektrischen Stroms durch elektromagnetische Induktion entgegenzuwirken und so eine elektromotorische Gegenkraft zu erzeugen"@de)
AnnotationAssertion(skos:example co:PMD_0080083 "A solenoid coil of 100 turns has an inductance of 1 mH, opposing rapid current changes"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080083 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080083 co:PMD_0020353)

# Class: co:PMD_0080085 (Gewichtskraft)

AnnotationAssertion(obo:IAO_0000117 co:PMD_0080085 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080085 <https://en.wikipedia.org/wiki/Weight>)
AnnotationAssertion(rdfs:label co:PMD_0080085 "Gewichtskraft"@de)
AnnotationAssertion(rdfs:label co:PMD_0080085 "weight"@en)
AnnotationAssertion(skos:definition co:PMD_0080085 "In science and engineering, the weight of an object, is the force acting on the object due to acceleration of gravity."@en)
AnnotationAssertion(skos:example co:PMD_0080085 "A concrete block has a weight of 2.5 kN in the gravitational field at sea level"@en)
SubClassOf(co:PMD_0080085 co:PMD_0020200)
SubClassOf(co:PMD_0080085 ObjectSomeValuesFrom(co:PMD_0025999 ObjectIntersectionOf(obo:BFO_0000030 ObjectSomeValuesFrom(obo:RO_0000086 co:PMD_0080118))))

# Class: co:PMD_0080087 (Schubkraft)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080087 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080087 "Necessary and sufficient conditions for 'thrust' have not yet been formalized. The term is defined as a specific subtype of 'force'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Thrust."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080087 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080087 <https://en.wikipedia.org/wiki/Thrust>)
AnnotationAssertion(rdfs:label co:PMD_0080087 "Schubkraft"@de)
AnnotationAssertion(rdfs:label co:PMD_0080087 "thrust"@en)
AnnotationAssertion(skos:definition co:PMD_0080087 "Schubkraft ist eine von Newtons drittem Gesetz beschriebene Kraft, bei der Massenbeschleunigung in eine Richtung eine gleich große Kraft in die entgegengesetzte Richtung verursacht"@de)
AnnotationAssertion(skos:definition co:PMD_0080087 "Thrust is a force described by Newton's third law, where mass expulsion in one direction causes an equal force in the opposite direction"@en)
AnnotationAssertion(skos:example co:PMD_0080087 "A jet engine produces 150 kN of thrust at takeoff conditions"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080087 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080087 co:PMD_0020353)

# Class: co:PMD_0080088 (Äquivalentdosis)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080088 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080088 "Necessary and sufficient conditions for 'dose equivalent' have not yet been formalized. The term is defined as a specific subtype of 'physical relational quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://www.nrc.gov/reading-rm/basic-ref/glossary/dose-equivalent.html."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080088 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080088 <https://www.nrc.gov/reading-rm/basic-ref/glossary/dose-equivalent.html>)
AnnotationAssertion(rdfs:label co:PMD_0080088 "dose equivalent"@en)
AnnotationAssertion(rdfs:label co:PMD_0080088 "Äquivalentdosis"@de)
AnnotationAssertion(skos:definition co:PMD_0080088 "Das Dosisäquivalent misst die biologische Schädigung lebenden Gewebes durch Strahlenexposition, berechnet als absorbierte Dosis multipliziert mit einem Qualitätsfaktor und ausgedrückt in Rems oder Sievert"@de)
AnnotationAssertion(skos:definition co:PMD_0080088 "Dose equivalent measures biological damage to living tissue from radiation exposure, calculated as absorbed dose multiplied by a quality factor, and expressed in rems or sieverts"@en)
AnnotationAssertion(skos:example co:PMD_0080088 "A radiation worker receives a dose equivalent of 2 mSv per year from occupational exposure"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080088 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080088 co:PMD_0020353)

# Class: co:PMD_0080089 (radiant energy density)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080089 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080089 "Necessary and sufficient conditions for 'radiant energy density' have not yet been formalized. The term is defined as a specific subtype of 'density'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Radiant_energy."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080089 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080089 <https://en.wikipedia.org/wiki/Radiant_energy>)
AnnotationAssertion(rdfs:label co:PMD_0080089 "Strahlungsenergiedichte"@de)
AnnotationAssertion(rdfs:label co:PMD_0080089 "radiant energy density"@en)
AnnotationAssertion(skos:definition co:PMD_0080089 "Radiant energy density quantifies radiant energy per unit volume"@en)
AnnotationAssertion(skos:definition co:PMD_0080089 "Strahlungsenergiedichte misst die Strahlungsenergie pro Volumeneinheit"@de)
AnnotationAssertion(skos:example co:PMD_0080089 "The radiant energy density at the focal spot of a laser is 1 GJ/m3 during material processing"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080089 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080089 co:PMD_0020353)

# Class: co:PMD_0080091 (pixel density)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080091 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080091 "Necessary and sufficient conditions for 'pixel density' have not yet been formalized. The term is defined as a specific subtype of 'number density'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080091 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080091 "Pixeldichte"@de)
AnnotationAssertion(rdfs:label co:PMD_0080091 "pixel density"@en)
AnnotationAssertion(skos:definition co:PMD_0080091 "Pixel density describes the relationship between the number of pixels and the area they occupy on a related entity"@en)
AnnotationAssertion(skos:definition co:PMD_0080091 "Pixeldichte beschreibt das Verhältnis zwischen der Anzahl der Pixel und der Fläche, die sie auf einer verwandten Entität einnehmen"@de)
AnnotationAssertion(skos:example co:PMD_0080091 "A 4K display panel has a pixel density of 210 ppi, providing sharp text rendering"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080091 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080091 co:PMD_0020353)

# Class: co:PMD_0080092 (electric flux density)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080092 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080092 "Necessary and sufficient conditions for 'electric flux density' have not yet been formalized. The term is defined as a specific subtype of 'density'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://www.britannica.com/science/electric-flux."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080092 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080092 <https://www.britannica.com/science/electric-flux>)
AnnotationAssertion(rdfs:label co:PMD_0080092 "electric flux density"@en)
AnnotationAssertion(rdfs:label co:PMD_0080092 "elektrische Flussdichte"@de)
AnnotationAssertion(skos:definition co:PMD_0080092 "Die elektrische Flussdichte misst die Gesamtzahl der elektrischen Kraftlinien, die ein bestimmtes Gebiet schneiden, von positiven Ladungen ausgehen und bei negativen Ladungen enden"@de)
AnnotationAssertion(skos:definition co:PMD_0080092 "Electric flux density measures the total number of electric lines of force intersecting a given area, originating on positive charges and terminating on negative charges"@en)
AnnotationAssertion(skos:example co:PMD_0080092 "Near a charged plate, the electric flux density is 8.85e-12 C/m2 per V/m of field strength"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080092 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080092 co:PMD_0020353)

# Class: co:PMD_0080093 (birefringence)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080093 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080093 "Necessary and sufficient conditions for 'birefringence' have not yet been formalized. The term is defined as a specific subtype of 'physical relational quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080093 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080093 "Doppelbrechung"@de)
AnnotationAssertion(rdfs:label co:PMD_0080093 "birefringence"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080093 "Zweistrahl-Brechung"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080093 "double refraction"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080093 "Δn"@en)
AnnotationAssertion(skos:definition co:PMD_0080093 "Birefringence is a physical relational quality of an optically anisotropic material that specifies the difference in refractive indices along two principal optical axes, causing incident light to split into two rays with different velocities"@en)
AnnotationAssertion(skos:definition co:PMD_0080093 "Doppelbrechung ist eine physikalische relationale Qualität eines optisch anisotropen Materials, die die Differenz der Brechungsindizes entlang zweier optischer Hauptachsen angibt und bewirkt, dass einfallendes Licht in zwei Strahlen mit unterschiedlichen Geschwindigkeiten aufgespalten wird"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080093 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080093 co:PMD_0020353)

# Class: co:PMD_0080094 (stress relaxation)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080094 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080094 "Necessary and sufficient conditions for 'stress relaxation' have not yet been formalized. The term is defined as a specific subtype of 'physical relational quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080094 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080094 "Spannungsrelaxation"@de)
AnnotationAssertion(rdfs:label co:PMD_0080094 "stress relaxation"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080094 "Relaxationsgrad"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080094 "relaxation ratio"@en)
AnnotationAssertion(skos:definition co:PMD_0080094 "Stress relaxation is a physical relational quality of a material that expresses the ratio of residual stress to initial applied stress after a defined time interval under constant strain, quantifying the material's tendency to internally redistribute stress over time"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080094 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080094 co:PMD_0020353)
SubClassOf(co:PMD_0080094 co:PMD_0023004)
SubClassOf(co:PMD_0080094 ObjectSomeValuesFrom(obo:RO_0000052 ObjectIntersectionOf(co:PMD_0000000 ObjectSomeValuesFrom(obo:RO_0000056 co:PMD_0023046) ObjectSomeValuesFrom(obo:RO_0000086 co:PMD_0080108))))

# Class: co:PMD_0080095 (Kontaktwinkel)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080095 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080095 "Necessary and sufficient conditions for 'contact angle' have not yet been formalized. The term is defined as a specific subtype of 'physical relational quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080095 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080095 "Kontaktwinkel"@de)
AnnotationAssertion(rdfs:label co:PMD_0080095 "contact angle"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080095 "Benetzungswinkel"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080095 "wetting angle"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080095 "θ"@en)
AnnotationAssertion(skos:definition co:PMD_0080095 "Contact angle is a physical relational quality of a solid surface that quantifies the angle formed at the three-phase contact line between a liquid droplet, the solid surface, and the surrounding gas phase, characterizing the wettability of the surface by the liquid"@en)
AnnotationAssertion(skos:definition co:PMD_0080095 "Kontaktwinkel ist eine physikalische relationale Qualität einer festen Oberfläche, die den Winkel an der Dreiphasengrenzlinie zwischen einem Flüssigkeitstropfen, der festen Oberfläche und der umgebenden Gasphase beschreibt und die Benetzbarkeit der Oberfläche durch die Flüssigkeit charakterisiert"@de)
AnnotationAssertion(skos:example co:PMD_0080095 "A hydrophobic polymer coating shows a water contact angle of 110 degrees, indicating poor wettability"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080095 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080095 co:PMD_0020309)
SubClassOf(co:PMD_0080095 co:PMD_0020335)
SubClassOf(co:PMD_0080095 ObjectSomeValuesFrom(co:PMD_0025999 ObjectIntersectionOf(obo:BFO_0000146 ObjectSomeValuesFrom(obo:RO_0002000 co:PMD_0020290) ObjectSomeValuesFrom(obo:RO_0002000 co:PMD_0020293))))

# Class: co:PMD_0080098 (Massenmischungsverhältnis)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080098 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080098 "Necessary and sufficient conditions for 'mass mix ratio' have not yet been formalized. The term is defined as a specific subtype of 'mass ratio'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://de.wikipedia.org/wiki/Massenverh%C3%A4ltnis."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080098 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080098 <https://de.wikipedia.org/wiki/Massenverh%C3%A4ltnis>)
AnnotationAssertion(rdfs:label co:PMD_0080098 "Massenmischungsverhältnis"@de)
AnnotationAssertion(rdfs:label co:PMD_0080098 "mass mix ratio"@en)
AnnotationAssertion(skos:definition co:PMD_0080098 "Das Massenmischungsverhältnis stellt das Verhältnis der Massen zweier Mischungskomponenten dar und liefert eine quantitative Beschreibung der Zusammensetzung"@de)
AnnotationAssertion(skos:definition co:PMD_0080098 "mass ratio that represents the ratio of masses of two mixture components, providing a quantitative composition description"@en)
AnnotationAssertion(skos:example co:PMD_0080098 "A concrete mix uses a mass mix ratio of cement to aggregate of 1:4 for standard structural applications"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080098 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080098 co:PMD_0020102)

# Class: co:PMD_0080099 (dry mass)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080099 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080099 "Necessary and sufficient conditions for 'dry mass' have not yet been formalized. The term is defined as a specific subtype of 'mass ratio'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080099 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080099 "Trockenmasse"@de)
AnnotationAssertion(rdfs:label co:PMD_0080099 "dry mass"@en)
AnnotationAssertion(skos:definition co:PMD_0080099 "Trockenmasse bezeichnet die Masse, nachdem einem Objekt die gesamte Feuchtigkeit entzogen wurde, typischerweise durch geeignete Erhitzungsmethoden in einem Ofen"@de)
AnnotationAssertion(skos:definition co:PMD_0080099 "mass ratio that represents the mass after removing all humidity from an object, typically using qualified heating methods in an oven"@en)
AnnotationAssertion(skos:example co:PMD_0080099 "A fiber composite sample has a dry mass of 48.5 g after 24 hours in a drying oven at 80 C"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080099 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080099 co:PMD_0020353)

# Class: co:PMD_0080100 (Massenanteil)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080100 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080100 "Necessary and sufficient conditions for 'mass fraction' have not yet been formalized. The term is defined as a specific subtype of 'mass ratio'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://de.wikipedia.org/wiki/Massenanteil."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080100 "PERSON: Thomas Hanke")

############################

# Individual: <http://qudt.org/vocab/unit/PER-MOL> (<http://qudt.org/vocab/unit/PER-MOL>)

ClassAssertion(<http://qudt.org/schema/qudt/Unit> <http://qudt.org/vocab/unit/PER-MOL>)

# Individual: co:PMD_0020006 (Triklines Primitiv des Bravais-Gitters)

AnnotationAssertion(rdfs:label co:PMD_0020006 "OBSOLETE bravais lattice triclinic primitive"@en)
AnnotationAssertion(rdfs:label co:PMD_0020006 "Triklines Primitiv des Bravais-Gitters"@de)
AnnotationAssertion(owl:deprecated co:PMD_0020006 "true"^^xsd:boolean)
AnnotationAssertion(skos:definition co:PMD_0020006 "triclinic Bravais lattice with primitive centering (aP), having no rotational symmetry and all three unit cell axes of unequal length meeting at oblique angles"@en)
AnnotationAssertion(skos:definition co:PMD_0020006 "triklines Bravais-Gitter mit primitiver Zentrierung (aP), keine Rotationssymmetrie und alle drei Elementarzellenachsen ungleicher Länge treffen sich in schrägen Winkeln"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0020006 "true"^^xsd:boolean)

# Individual: co:PMD_0020007 (OBSOLETE bravais lattice monoclinic primitive)

AnnotationAssertion(rdfs:label co:PMD_0020007 "OBSOLETE bravais lattice monoclinic primitive"@en)
AnnotationAssertion(rdfs:label co:PMD_0020007 "monoklines Grundelement des Bravais-Gitters"@de)
AnnotationAssertion(owl:deprecated co:PMD_0020007 "true"^^xsd:boolean)
AnnotationAssertion(skos:definition co:PMD_0020007 "Monoklines Bravais-Gitter mit primitiver Zentrierung (mP) mit einer zweizähligen Rotationsachse mit einem schiefen Winkel und zwei rechten Winkeln zwischen den Achsen der Elementarzellen"@de)
AnnotationAssertion(skos:definition co:PMD_0020007 "monoclinic Bravais lattice with primitive centering (mP), having one 2-fold rotation axis with one oblique angle and two right angles between unit cell axes"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0020007 "true"^^xsd:boolean)

# Individual: co:PMD_0020008 (OBSOLETE bravais lattice monoclinic base-centered)

AnnotationAssertion(rdfs:label co:PMD_0020008 "Bravais-Gitter monoklin basiszentriert"@de)
AnnotationAssertion(rdfs:label co:PMD_0020008 "OBSOLETE bravais lattice monoclinic base-centered"@en)
AnnotationAssertion(owl:deprecated co:PMD_0020008 "true"^^xsd:boolean)
AnnotationAssertion(skos:definition co:PMD_0020008 "monoclinic Bravais lattice with base-centered centering (mC), having one 2-fold rotation axis and additional lattice points at the center of one pair of faces"@en)
AnnotationAssertion(skos:definition co:PMD_0020008 "monoklines Bravais-Gitter mit basiszentrierter Zentrierung (mC), einer zweizähligen Rotationsachse und zusätzlichen Gitterpunkten in der Mitte eines Flächenpaares"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0020008 "true"^^xsd:boolean)

# Individual: co:PMD_0020009 (Bravais-Gitter orthorombisches Grundelement)

AnnotationAssertion(rdfs:label co:PMD_0020009 "Bravais-Gitter orthorombisches Grundelement"@de)
AnnotationAssertion(rdfs:label co:PMD_0020009 "OBSOLETE bravais lattice orthorombic primitive"@en)
AnnotationAssertion(owl:deprecated co:PMD_0020009 "true"^^xsd:boolean)
AnnotationAssertion(skos:definition co:PMD_0020009 "orthorhombic Bravais lattice with primitive centering (oP), having three mutually perpendicular 2-fold rotation axes and one lattice point per unit cell"@en)
AnnotationAssertion(skos:definition co:PMD_0020009 "orthorhombisches Bravais-Gitter mit primitiver Zentrierung (oP), mit drei zueinander senkrechten zweizähligen Rotationsachsen und einem Gitterpunkt pro Elementarzelle"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0020009 "true"^^xsd:boolean)

# Individual: co:PMD_0020010 (OBSOLETE bravais lattice orthorhombic base-centered)

AnnotationAssertion(rdfs:label co:PMD_0020010 "Bravais-Gitter orthorhombisch basiszentriert"@de)
AnnotationAssertion(rdfs:label co:PMD_0020010 "OBSOLETE bravais lattice orthorhombic base-centered"@en)
AnnotationAssertion(owl:deprecated co:PMD_0020010 "true"^^xsd:boolean)
AnnotationAssertion(skos:definition co:PMD_0020010 "orthorhombic Bravais lattice with base-centered centering (oC), having three perpendicular 2-fold axes and additional lattice points at the centers of one pair of faces"@en)
AnnotationAssertion(skos:definition co:PMD_0020010 "orthorhombisches Bravais-Gitter mit basiszentrierter Zentrierung (oC), mit drei senkrechten zweizähligen Achsen und zusätzlichen Gitterpunkten in den Mittelpunkten eines Flächenpaares"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0020010 "true"^^xsd:boolean)

# Individual: co:PMD_0020011 (OBSOLETE bravais lattice orthorhombic body-centered)

AnnotationAssertion(rdfs:label co:PMD_0020011 "Bravais-Gitter orthorhombisch körperzentriert"@de)
AnnotationAssertion(rdfs:label co:PMD_0020011 "OBSOLETE bravais lattice orthorhombic body-centered"@en)
AnnotationAssertion(owl:deprecated co:PMD_0020011 "true"^^xsd:boolean)
AnnotationAssertion(skos:definition co:PMD_0020011 "orthorhombic Bravais lattice with body-centered centering (oI), having three perpendicular 2-fold axes and an additional lattice point at the center of the unit cell"@en)
AnnotationAssertion(skos:definition co:PMD_0020011 "orthorhombisches Bravais-Gitter mit körperzentrierter Zentrierung (oI), mit drei senkrechten zweizähligen Achsen und einem zusätzlichen Gitterpunkt in der Mitte der Elementarzelle"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0020011 "true"^^xsd:boolean)

# Individual: co:PMD_0020012 (OBSOLETE bravais lattice orthorhombic face-centered)

AnnotationAssertion(rdfs:label co:PMD_0020012 "Bravais-Gitter orthorhombisch flächenzentriert"@de)
AnnotationAssertion(rdfs:label co:PMD_0020012 "OBSOLETE bravais lattice orthorhombic face-centered"@en)
AnnotationAssertion(owl:deprecated co:PMD_0020012 "true"^^xsd:boolean)
AnnotationAssertion(skos:definition co:PMD_0020012 "orthorhombic Bravais lattice with face-centered centering (oF), having three perpendicular 2-fold axes and additional lattice points at the centers of all faces"@en)
AnnotationAssertion(skos:definition co:PMD_0020012 "orthorhombisches Bravais-Gitter mit flächenzentrierter Zentrierung (oF), mit drei senkrechten zweizähligen Achsen und zusätzlichen Gitterpunkten in den Mittelpunkten aller Flächen"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0020012 "true"^^xsd:boolean)

# Individual: co:PMD_0020013 (OBSOLETE bravais lattice tetragonal primitive)

AnnotationAssertion(rdfs:label co:PMD_0020013 "Bravais-Gitter tetragonaler Grundkörper"@de)
AnnotationAssertion(rdfs:label co:PMD_0020013 "OBSOLETE bravais lattice tetragonal primitive"@en)
AnnotationAssertion(owl:deprecated co:PMD_0020013 "true"^^xsd:boolean)
AnnotationAssertion(skos:definition co:PMD_0020013 "tetragonal Bravais lattice with primitive centering (tP), having one 4-fold rotation axis with two equal unit cell axes perpendicular to a third unequal axis"@en)
AnnotationAssertion(skos:definition co:PMD_0020013 "tetragonales Bravais-Gitter mit primitiver Zentrierung (tP), mit einer vierzähligen Rotationsachse mit zwei gleichen Elementarzellenachsen senkrecht zu einer dritten ungleichen Achse"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0020013 "true"^^xsd:boolean)

# Individual: co:PMD_0020014 (Bravais-Gitter tetragonal körperzentriert)

AnnotationAssertion(rdfs:label co:PMD_0020014 "Bravais-Gitter tetragonal körperzentriert"@de)
AnnotationAssertion(rdfs:label co:PMD_0020014 "OBSOLETE bravais lattice tetragonal body-centered"@en)
AnnotationAssertion(owl:deprecated co:PMD_0020014 "true"^^xsd:boolean)
AnnotationAssertion(skos:definition co:PMD_0020014 "tetragonal Bravais lattice with body-centered centering (tI), having one 4-fold rotation axis and an additional lattice point at the center of the unit cell"@en)
AnnotationAssertion(skos:definition co:PMD_0020014 "tetragonales Bravais-Gitter mit körperzentrierter Zentrierung (tI), einer 4-zähligen Rotationsachse und einem zusätzlichen Gitterpunkt im Zentrum der Elementarzelle"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0020014 "true"^^xsd:boolean)

# Individual: co:PMD_0020015 (Bravais-Gitter, sechseckiges, rhomboedrisches Grundelement)

AnnotationAssertion(rdfs:label co:PMD_0020015 "Bravais-Gitter, sechseckiges, rhomboedrisches Grundelement"@de)
AnnotationAssertion(rdfs:label co:PMD_0020015 "OBSOLETE bravais lattice hexagonal rhombohedral primitive"@en)
AnnotationAssertion(owl:deprecated co:PMD_0020015 "true"^^xsd:boolean)
AnnotationAssertion(skos:definition co:PMD_0020015 "trigonal Bravais lattice with rhombohedral centering (hR), having a 3-fold rotation axis and representable as a rhombohedron with equal axes and equal interaxial angles"@en)
AnnotationAssertion(skos:definition co:PMD_0020015 "trigonales Bravais-Gitter mit rhomboedrischer Zentrierung (hR), einer dreizähligen Rotationsachse und darstellbar als Rhomboeder mit gleichen Achsen und gleichen Zwischenachsenwinkeln"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0020015 "true"^^xsd:boolean)

# Individual: co:PMD_0020016 (Bravais-Gitter sechseckiges sechseckiges Grundelement)

AnnotationAssertion(rdfs:label co:PMD_0020016 "Bravais-Gitter sechseckiges sechseckiges Grundelement"@de)
AnnotationAssertion(rdfs:label co:PMD_0020016 "OBSOLETE bravais lattice hexagonal hexagonal primitive"@en)
AnnotationAssertion(owl:deprecated co:PMD_0020016 "true"^^xsd:boolean)
AnnotationAssertion(skos:definition co:PMD_0020016 "hexagonal Bravais lattice with primitive centering (hP), having one 6-fold rotation axis with two equal unit cell axes in the basal plane and one perpendicular axis"@en)
AnnotationAssertion(skos:definition co:PMD_0020016 "hexagonales Bravais-Gitter mit primitiver Zentrierung (hP), mit einer 6-fachen Rotationsachse mit zwei gleichen Elementarzellenachsen in der Basisebene und einer senkrechten Achse"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0020016 "true"^^xsd:boolean)

# Individual: co:PMD_0020017 (OBSOLETE bravais lattice cubic primitive)

AnnotationAssertion(rdfs:label co:PMD_0020017 "Bravais-Gitter, kubisches Grundelement"@de)
AnnotationAssertion(rdfs:label co:PMD_0020017 "OBSOLETE bravais lattice cubic primitive"@en)
AnnotationAssertion(owl:deprecated co:PMD_0020017 "true"^^xsd:boolean)
AnnotationAssertion(skos:definition co:PMD_0020017 "Kubisches Bravais-Gitter mit primitiver Zentrierung (cP), mit vier dreizähligen Rotationsachsen, wobei alle Elementarzellenachsen gleich und zueinander senkrecht sind, und einem Gitterpunkt pro Elementarzelle"@de)
AnnotationAssertion(skos:definition co:PMD_0020017 "cubic Bravais lattice with primitive centering (cP), having four 3-fold rotation axes with all unit cell axes equal and mutually perpendicular and one lattice point per unit cell"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0020017 "true"^^xsd:boolean)

# Individual: co:PMD_0020018 (OBSOLETE bravais lattice cubic body-centered)

AnnotationAssertion(rdfs:label co:PMD_0020018 "Bravais-Gitter kubisch raumzentriert"@de)
AnnotationAssertion(rdfs:label co:PMD_0020018 "OBSOLETE bravais lattice cubic body-centered"@en)
AnnotationAssertion(owl:deprecated co:PMD_0020018 "true"^^xsd:boolean)
AnnotationAssertion(skos:definition co:PMD_0020018 "Kubisches Bravais-Gitter mit körperzentrierter Zentrierung (cI), mit vier dreizähligen Rotationsachsen und einem zusätzlichen Gitterpunkt in der Mitte der Elementarzelle"@de)
AnnotationAssertion(skos:definition co:PMD_0020018 "cubic Bravais lattice with body-centered centering (cI), having four 3-fold rotation axes and an additional lattice point at the center of the unit cell"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0020018 "true"^^xsd:boolean)

# Individual: co:PMD_0020019 (Bravais-Gitter kubisch flächenzentriert)

AnnotationAssertion(rdfs:label co:PMD_0020019 "Bravais-Gitter kubisch flächenzentriert"@de)
AnnotationAssertion(rdfs:label co:PMD_0020019 "OBSOLETE bravais lattice cubic face-centered"@en)
AnnotationAssertion(owl:deprecated co:PMD_0020019 "true"^^xsd:boolean)
AnnotationAssertion(skos:definition co:PMD_0020019 "Kubisches Bravais-Gitter mit flächenzentrierter Zentrierung (cF), mit vier dreizähligen Rotationsachsen und zusätzlichen Gitterpunkten in den Mittelpunkten aller Flächen"@de)
AnnotationAssertion(skos:definition co:PMD_0020019 "cubic Bravais lattice with face-centered centering (cF), having four 3-fold rotation axes and additional lattice points at the centers of all faces"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0020019 "true"^^xsd:boolean)

# Individual: co:PMD_0020027 (Bainit)

AnnotationAssertion(rdfs:label co:PMD_0020027 "Bainit"@de)
AnnotationAssertion(rdfs:label co:PMD_0020027 "OBSOLETE bainite"@en)
AnnotationAssertion(owl:deprecated co:PMD_0020027 "true"^^xsd:boolean)
AnnotationAssertion(skos:definition co:PMD_0020027 "Eisen-Kohlenstoff-Mikrostruktur, die durch isotherme Umwandlung von Austenit bei Temperaturen zwischen dem Perlit- und Martensitbildungsbereich entsteht und aus Ferrit und fein verteiltem Zementit besteht"@de)
AnnotationAssertion(skos:definition co:PMD_0020027 "iron-carbon microstructure formed by isothermal transformation of austenite at temperatures between the pearlite and martensite formation ranges, consisting of ferrite and finely dispersed cementite"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0020027 "true"^^xsd:boolean)

# Individual: co:PMD_0020097 (Austenit)

AnnotationAssertion(rdfs:label co:PMD_0020097 "Austenit"@de)
AnnotationAssertion(rdfs:label co:PMD_0020097 "OBSOLETE austenite"@en)
AnnotationAssertion(owl:deprecated co:PMD_0020097 "true"^^xsd:boolean)
AnnotationAssertion(skos:definition co:PMD_0020097 "face-centered cubic phase of iron or an iron-based alloy, stable above the eutectoid temperature and capable of dissolving significant amounts of carbon in solid solution"@en)
AnnotationAssertion(skos:definition co:PMD_0020097 "flächenzentrierte kubische Phase aus Eisen oder einer Legierung auf Eisenbasis, die oberhalb der Eutektoidtemperatur stabil ist und in der Lage ist, erhebliche Mengen Kohlenstoff in fester Lösung aufzulösen"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0020097 "true"^^xsd:boolean)

# Individual: co:PMD_0020100 (OBSOLETE ferrite)

AnnotationAssertion(rdfs:label co:PMD_0020100 "Ferrit"@de)
AnnotationAssertion(rdfs:label co:PMD_0020100 "OBSOLETE ferrite"@en)
AnnotationAssertion(owl:deprecated co:PMD_0020100 "true"^^xsd:boolean)
AnnotationAssertion(skos:definition co:PMD_0020100 "body-centered cubic phase of iron or an iron-based alloy with very low carbon solubility, stable at low temperatures and ferromagnetic below the Curie temperature"@en)
AnnotationAssertion(skos:definition co:PMD_0020100 "kubisch raumzentrierte Phase aus Eisen oder einer Eisenlegierung mit sehr geringer Kohlenstofflöslichkeit, stabil bei niedrigen Temperaturen und ferromagnetisch unterhalb der Curie-Temperatur"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0020100 "true"^^xsd:boolean)

# Individual: co:PMD_0020107 (OBSOLETE ledeburite)

AnnotationAssertion(rdfs:label co:PMD_0020107 "Ledeburit"@de)
AnnotationAssertion(rdfs:label co:PMD_0020107 "OBSOLETE ledeburite"@en)
AnnotationAssertion(owl:deprecated co:PMD_0020107 "true"^^xsd:boolean)
AnnotationAssertion(skos:definition co:PMD_0020107 "Eutektische Mikrostruktur von Austenit und Zementit, die sich in Eisen-Kohlenstoff-Legierungen mit einem Kohlenstoffgehalt über 2,14 Gew.-% bei der Erstarrung bei der eutektischen Temperatur von 1147 °C bildet"@de)
AnnotationAssertion(skos:definition co:PMD_0020107 "eutectic microstructure of austenite and cementite formed in iron-carbon alloys with carbon content above 2.14 wt% upon solidification at the eutectic temperature of 1147 °C"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0020107 "true"^^xsd:boolean)

# Individual: co:PMD_0020109 (Perlit)

AnnotationAssertion(rdfs:label co:PMD_0020109 "OBSOLETE pearlite"@en)
AnnotationAssertion(rdfs:label co:PMD_0020109 "Perlit"@de)
AnnotationAssertion(owl:deprecated co:PMD_0020109 "true"^^xsd:boolean)
AnnotationAssertion(skos:definition co:PMD_0020109 "Lamellare eutektoide Mikrostruktur aus abwechselnden Ferrit- und Zementitschichten, die durch Zersetzung von Austenit bei der eutektoiden Temperatur von 723 °C entsteht"@de)
AnnotationAssertion(skos:definition co:PMD_0020109 "lamellar eutectoid microstructure of alternating ferrite and cementite layers formed by decomposition of austenite at the eutectoid temperature of 723 °C"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0020109 "true"^^xsd:boolean)

# Individual: co:PMD_0020110 (DEPRECATED Widmanstätten-Struktur)

AnnotationAssertion(rdfs:label co:PMD_0020110 "DEPRECATED Widmanstätten-Struktur"@de)
AnnotationAssertion(rdfs:label co:PMD_0020110 "DEPRECATED widmanstatten structure"@en)
AnnotationAssertion(owl:deprecated co:PMD_0020110 "true"^^xsd:boolean)
AnnotationAssertion(skos:definition co:PMD_0020110 "DEPRECATED Mikrostruktur, in der beim Abkühlen Ferrit- oder Zementitplatten Keime bilden und entlang bestimmter kristallographischer Ebenen des Ausgangsaustenits wachsen und ein charakteristisches nadel- oder plattenartiges Muster bilden"@de)
AnnotationAssertion(skos:definition co:PMD_0020110 "DEPRECATED microstructure in which ferrite or cementite plates nucleate and grow along specific crystallographic planes of the parent austenite during cooling, forming a characteristic needle-like or plate-like pattern"@en)

# Individual: co:PMD_0020111 (OBSOLETE martensite)


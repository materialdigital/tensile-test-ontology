# Class: co:PMD_0020098 (Naturkonstante)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0020098 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0020098 "PERSON: Philipp von Hartrott")
AnnotationAssertion(rdfs:label co:PMD_0020098 "Naturkonstante"@de)
AnnotationAssertion(rdfs:label co:PMD_0020098 "nature constant"@en)
AnnotationAssertion(skos:definition co:PMD_0020098 "A nature constant is a generically dependent continuant whose value, maginitude or configuration is determined by nature including physics and mathematics."@en)
AnnotationAssertion(skos:definition co:PMD_0020098 "Eine Naturkonstante ist ein generisch abhängiger Kontinuant, dessen Wert, Größe oder Konfiguration durch die Natur, einschließlich Physik und Mathematik, bestimmt wird."@de)
AnnotationAssertion(skos:example co:PMD_0020098 "Examples of nature constants are the speed of light, pi, etc."@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0020098 "true"^^xsd:boolean)
SubClassOf(co:PMD_0020098 obo:BFO_0000031)

# Class: co:PMD_0020099 (OBSOLETE bravais lattice (3D))

AnnotationAssertion(obo:IAO_0000114 co:PMD_0020099 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0020099 "PERSON: Philipp von Hartrott")
AnnotationAssertion(rdfs:comment co:PMD_0020099 "TODO: possibly extend for 2D (Graphene etc)

More elaborate crystal descriptions may be found in http://emmo.info/domain-crystallography/crystallography or https://purls.helmholtz-metadaten.de/disos/cso"@en)
AnnotationAssertion(rdfs:label co:PMD_0020099 "Bravais-Gitter (3D)"@de)
AnnotationAssertion(rdfs:label co:PMD_0020099 "OBSOLETE bravais lattice (3D)"@en)
AnnotationAssertion(owl:deprecated co:PMD_0020099 "true"^^xsd:boolean)
AnnotationAssertion(skos:definition co:PMD_0020099 "Das Bravais-Gitter ist eine kategoriale Wertspezifikation, die den Wert der Kristallstrukturqualität angibt. Es beschreibt die mögliche geometrische Anordnung von Gitterpunkten in einem Kristall. Der vorliegende Deskriptor beschränkt sich auf die 14 möglichen dreidimensionalen Anordnungen."@de)
AnnotationAssertion(skos:definition co:PMD_0020099 "The bravais lattice is a categorical value specification that specifies value of the crystal structure quality. It describes the possible geometric arrangement of lattice points in a crystal. The present descriptor is limited to the 14 possible three-dimensional arrangements."@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0020099 "true"^^xsd:boolean)

# Class: co:PMD_0020101 (proportion)

AnnotationAssertion(obo:IAO_0000117 co:PMD_0020101 "PERSON: Philipp von Hartrott")
AnnotationAssertion(rdfs:label co:PMD_0020101 "Anteil"@de)
AnnotationAssertion(rdfs:label co:PMD_0020101 "proportion"@en)
AnnotationAssertion(skos:definition co:PMD_0020101 "A proportion is a relational quality between two entities (the whole and the part) which quantifies the relation between the whole and its part."@en)
SubClassOf(co:PMD_0020101 co:PMD_0020353)
SubClassOf(co:PMD_0020101 ObjectSomeValuesFrom(obo:RO_0002328 obo:BFO_0000001))

# Class: co:PMD_0020102 (mass ratio)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0020102 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0020102 "Necessary and sufficient conditions for 'mass ratio' have not yet been formalized. The term is defined as a specific subtype of 'material composition'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0020102 "PERSON: Philipp von Hartrott")
AnnotationAssertion(rdfs:label co:PMD_0020102 "Massenverhältnis"@de)
AnnotationAssertion(rdfs:label co:PMD_0020102 "mass ratio"@en)
AnnotationAssertion(skos:definition co:PMD_0020102 "Das Massenverhältnis bezeichnet eine relationale Qualität, die einen Massenwert im Verhältnis zu einem anderen ausdrückt und typischerweise eine dimensionslose Zahl ergibt"@de)
AnnotationAssertion(skos:definition co:PMD_0020102 "Mass ratio denotes a relational quality expressing one mass value relative to another, typically producing a dimensionless number"@en)
AnnotationAssertion(skos:example co:PMD_0020102 "A fiber-reinforced composite has a fiber-to-matrix mass ratio of 60:40"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0020102 "true"^^xsd:boolean)
SubClassOf(co:PMD_0020102 co:PMD_0080069)

# Class: co:PMD_0020103 (Molverhältnis)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0020103 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0020103 "PERSON: Philipp von Hartrott")
AnnotationAssertion(rdfs:label co:PMD_0020103 "Molverhältnis"@de)
AnnotationAssertion(rdfs:label co:PMD_0020103 "molar ratio"@en)
AnnotationAssertion(skos:altLabel co:PMD_0020103 "molar proportion"@en)
AnnotationAssertion(skos:definition co:PMD_0020103 "Der Molanteil ist der Anteil, der die Anzahl der Einheiten des Teils im Verhältnis zur Anzahl der Einheiten des Ganzen quantifiziert."@de)
AnnotationAssertion(skos:definition co:PMD_0020103 "Molar proportion is the proportion which quantifies the entities count of the part in relation to the entities count of the whole."@en)
AnnotationAssertion(skos:example co:PMD_0020103 "The molar ratio of hydrogen gas H2 molecules to water H2O molecules is 1/1 in the oxyhydrogen reaction. The molar ratio of oxygen molecules O2 to water molecules is 2/1.
The molar ratio of carbon dioxide to average atmosphere air is 420 ppm as of 2022 AD."@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0020103 "true"^^xsd:boolean)
SubClassOf(co:PMD_0020103 co:PMD_0080069)

# Class: co:PMD_0020104 (volume ratio)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0020104 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0020104 "Necessary and sufficient conditions for 'volume ratio' have not yet been formalized. The term is defined as a specific subtype of 'material composition'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0020104 "PERSON: Philipp von Hartrott")
AnnotationAssertion(rdfs:label co:PMD_0020104 "Volumenverhältnis"@de)
AnnotationAssertion(rdfs:label co:PMD_0020104 "volume ratio"@en)
AnnotationAssertion(skos:definition co:PMD_0020104 "Volume ratio represents a relational quality expressing one volume value relative to another, typically resulting in a dimensionless number"@en)
AnnotationAssertion(skos:definition co:PMD_0020104 "Volumenverhältnis stellt eine relationale Qualität dar, die einen Volumenwert im Verhältnis zu einem anderen ausdrückt, typischerweise resultierend in einer dimensionslosen Zahl"@de)
AnnotationAssertion(skos:example co:PMD_0020104 "A foam material has a pore-to-solid volume ratio of 4:1, indicating 80 % porosity"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0020104 "true"^^xsd:boolean)
SubClassOf(co:PMD_0020104 co:PMD_0080069)

# Class: co:PMD_0020105 (geogenic mineral)

AnnotationAssertion(rdfs:label co:PMD_0020105 "geogenic mineral"@en)
AnnotationAssertion(skos:definition co:PMD_0020105 "material that is formed through geological processes"@en)
AnnotationAssertion(skos:example co:PMD_0020105 "such as Quartz (Silicates) or calcite (Carbonate) or Feldspar (Aluminosilicate)")

AnnotationAssertion(rdfs:label co:PMD_0020020 "DEPRECATED interacts with"@en)
AnnotationAssertion(rdfs:label co:PMD_0020020 "DEPRECATED interagiert mit"@de)
AnnotationAssertion(owl:deprecated co:PMD_0020020 "true"^^xsd:boolean)
AnnotationAssertion(skos:definition co:PMD_0020020 "DEPRECATED A relation between participants of a process indicating that some of the participants SDCs are affected during the process due to the interaction of the participants."@en)

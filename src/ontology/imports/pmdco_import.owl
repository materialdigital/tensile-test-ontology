AnnotationAssertion(obo:IAO_0000114 co:PMD_0000966 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0000966 "PERSON: Joerg Waitelonis")
AnnotationAssertion(rdfs:label co:PMD_0000966 "Oberflächenprofilometer"@de)
AnnotationAssertion(rdfs:label co:PMD_0000966 "surface profilometer"@en)
AnnotationAssertion(skos:definition co:PMD_0000966 "A device used to measure the surface profile and texture of materials."@en)

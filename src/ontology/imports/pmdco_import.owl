AnnotationAssertion(rdfs:label co:PMD_0000955 "structural material"@en)
AnnotationAssertion(skos:definition co:PMD_0000955 "A structural material S is an functional material which has the function to be used for an object O (O consists of S) and O's function is primarily mechanical load carrying."@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0000955 "true"^^xsd:boolean)

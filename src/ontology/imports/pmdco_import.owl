DisjointClasses(co:PMD_0027001 co:PMD_0027004)

# Class: co:PMD_0027002 (lamellae)

AnnotationAssertion(obo:IAO_0000112 co:PMD_0027002 "perlite microconstituent has part ferrite lamellae and has part cementite lamellae. Ferrite lamellae has part ferrite lamella"@en)
AnnotationAssertion(obo:IAO_0000114 co:PMD_0027002 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0027002 "PERSON: PMDco Team")
AnnotationAssertion(rdfs:label co:PMD_0027002 "lamellae"@en)
AnnotationAssertion(skos:definition co:PMD_0027002 "lamellae is an object aggregate that is part of some microconstituent and at the same time a single thermodynamic phase"@en)
AnnotationAssertion(skos:example co:PMD_0027002 "ferrite lamellae in perlite microcontituent"@en)

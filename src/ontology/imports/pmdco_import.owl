AnnotationAssertion(obo:IAO_0000117 co:PMD_0000536 "PERSON: Joerg Waitelonis")
AnnotationAssertion(rdfs:label co:PMD_0000536 "Brinell 2,5 62,5 ISO 6506"@de)
AnnotationAssertion(rdfs:label co:PMD_0000536 "Brinell 2.5 62.5 ISO 6506"@en)
AnnotationAssertion(skos:definition co:PMD_0000536 "A brinell hardness measured with 2.5mm diameter ball and a load of 62.5 kgf."@en)
AnnotationAssertion(skos:definition co:PMD_0000536 "Eine Brinellhärte, gemessen mit einer Kugel mit 2,5 mm Durchmesser und einer Belastung von 62,5 kgf."@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0000536 "true"^^xsd:boolean)

AnnotationAssertion(rdfs:label co:PMD_0080100 "mass fraction"@en)
AnnotationAssertion(skos:definition co:PMD_0080100 "Der Massenanteil beschreibt den relativen Anteil einer Masse an der Gesamtmasse einer Mischung, ein gängiges quantitatives Maß"@de)
AnnotationAssertion(skos:definition co:PMD_0080100 "mass ratio that describes the relative proportion of a mass to the total mass of a mixture, a common quantitative measure"@en)
AnnotationAssertion(skos:example co:PMD_0080100 "A binary Al-4 wt% Cu alloy has a copper mass fraction of 0.04"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080100 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080100 co:PMD_0020102)

# Class: co:PMD_0080101 (Massenkonzentration)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080101 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080101 "Necessary and sufficient conditions for 'mass concentration' have not yet been formalized. The term is defined as a specific subtype of 'material composition'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://de.wikipedia.org/wiki/Massenkonzentration."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080101 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080101 <https://de.wikipedia.org/wiki/Massenkonzentration>)
AnnotationAssertion(rdfs:label co:PMD_0080101 "Massenkonzentration"@de)
AnnotationAssertion(rdfs:label co:PMD_0080101 "mass concentration"@en)
AnnotationAssertion(skos:definition co:PMD_0080101 "Die Massenkonzentration verknüpft die Masse einer Mischungskomponente mit dem Gesamtvolumen in einer quantitativen Beschreibung, die häufig in Lösungen verwendet wird"@de)
AnnotationAssertion(skos:definition co:PMD_0080101 "Mass concentration links mass of a mixture component to the total volume in quantitative description, frequently used in solutions"@en)
AnnotationAssertion(skos:example co:PMD_0080101 "A saline infusion solution has a NaCl mass concentration of 9 g/L"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080101 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080101 co:PMD_0080069)


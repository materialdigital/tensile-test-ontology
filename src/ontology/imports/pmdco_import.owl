AnnotationAssertion(skos:definition co:PMD_0080187 "Strahlungsabsorptionsfähigkeit beschreibt die Fähigkeit einer Entität, elektromagnetische Strahlung zu absorbieren"@de)
AnnotationAssertion(skos:example co:PMD_0080187 "Carbon black pigment has high radiation absorption capability, absorbing over 99 % of incident visible light"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080187 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080187 co:PMD_0000877)


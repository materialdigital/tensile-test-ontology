SubClassOf(co:PMD_0080205 ObjectSomeValuesFrom(<http://qudt.org/schema/qudt/hasUnit> <http://qudt.org/schema/qudt/Unit>))

# Class: co:PMD_0090000 (semiconductor)

AnnotationAssertion(rdfs:label co:PMD_0090000 "semiconductor"@en)
AnnotationAssertion(skos:definition co:PMD_0090000 "A semiconductor is a material representing a class of materials characterized by an electrical conductivity between that of a conductor and an insulator. This is a result of a range of inexistent energy states in ther electron configuration between the valence and conduction band (bandgap)."@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0090000 "true"^^xsd:boolean)
EquivalentClasses(co:PMD_0090000 ObjectSomeValuesFrom(obo:RO_0000091 co:PMD_0090001))
SubClassOf(co:PMD_0090000 co:PMD_0000000)
SubClassOf(co:PMD_0090000 ObjectSomeValuesFrom(obo:RO_0000086 co:PMD_0090002))
SubClassOf(co:PMD_0090000 ObjectSomeValuesFrom(obo:RO_0000091 co:PMD_0090001))

# Class: co:PMD_0090001 (Halbleitfähigkeit)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0090001 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0090001 "PERSON: thnlrd")
AnnotationAssertion(rdfs:label co:PMD_0090001 "Halbleitfähigkeit"@de)
AnnotationAssertion(rdfs:label co:PMD_0090001 "semiconductivity"@en)
AnnotationAssertion(skos:definition co:PMD_0090001 "Semiconductivity is the disposition of a material to conduct electricity only when a certain level of excitation (via temperature, impurities, photonic excitation, electric field) elevates electrons from the valence band into the conduction band."@en)
AnnotationAssertion(skos:definition co:PMD_0090001 "Unter Halbleiterfähigkeit versteht man die Eigenschaft eines Materials, Elektrizität nur dann zu leiten, wenn ein bestimmtes Maß an Anregung (durch Temperatur, Verunreinigungen, photonische Anregung, elektrisches Feld) Elektronen aus dem Valenzband in das Leitungsband hebt."@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0090001 "true"^^xsd:boolean)
SubClassOf(co:PMD_0090001 co:PMD_0000620)

# Class: co:PMD_0090002 (Bandlücke)

AnnotationAssertion(obo:IAO_0000117 co:PMD_0090002 "PERSON: thnlrd")
AnnotationAssertion(rdfs:label co:PMD_0090002 "Bandlücke"@de)
AnnotationAssertion(rdfs:label co:PMD_0090002 "band gap"@en)
AnnotationAssertion(rdfs:seeAlso co:PMD_0090002 "https://en.wikipedia.org/wiki/Valence_and_conduction_bands"^^xsd:anyURI)
AnnotationAssertion(skos:definition co:PMD_0090002 "the energy difference between the valence band and the conduction band"@en)
SubClassOf(co:PMD_0090002 obo:BFO_0000019)
SubClassOf(co:PMD_0090002 co:PMD_0020312)
SubClassOf(co:PMD_0090002 co:PMD_0023004)
SubClassOf(co:PMD_0090002 ObjectSomeValuesFrom(obo:RO_0000080 co:PMD_0020293))


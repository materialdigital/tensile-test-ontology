# Class: co:PMD_0040001 (Länge)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0040001 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0040001 "Necessary and sufficient conditions for 'length' have not yet been formalized. The term is defined as a specific subtype of 'DimensionQuality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0000122."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0040001 "PERSON: Lars Vogt")
AnnotationAssertion(rdfs:comment co:PMD_0040001 "Length is a size that describes the spatial extent of its bearer in one dimension."@en)
AnnotationAssertion(rdfs:label co:PMD_0040001 "Länge"@de)
AnnotationAssertion(rdfs:label co:PMD_0040001 "length"@en)
AnnotationAssertion(skos:altLabel co:PMD_0040001 "dimension"@en)
AnnotationAssertion(skos:definition co:PMD_0040001 "Die Länge ist eine eindimensionale Größe."@de)
AnnotationAssertion(skos:definition co:PMD_0040001 "Length is a one dimensional size."@en)
AnnotationAssertion(skos:example co:PMD_0040001 "A steel rod measures 250 mm in length between its two end faces"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0040001 "true"^^xsd:boolean)
SubClassOf(co:PMD_0040001 co:PMD_0020132)

# Class: co:PMD_0050000 (atomic bond)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0050000 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0050000 "PERSON: Markus Schilling")
AnnotationAssertion(rdfs:label co:PMD_0050000 "Bindung"@de)
AnnotationAssertion(rdfs:label co:PMD_0050000 "atomic bond"@en)
AnnotationAssertion(skos:definition co:PMD_0050000 "A bond is a relational quality describing the force interaction between atoms."@en)
AnnotationAssertion(skos:definition co:PMD_0050000 "Eine Bindung ist eine relationale Qualität, die die Kraftwechselwirkung zwischen Atomen beschreibt."@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0050000 "true"^^xsd:boolean)
SubClassOf(co:PMD_0050000 co:PMD_0020353)
SubClassOf(co:PMD_0050000 ObjectSomeValuesFrom(co:PMD_0025999 obo:CHEBI_33250))

# Class: co:PMD_0050001 (covalent bond)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0050001 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0050001 "PERSON: Markus Schilling")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0050001 <https://sciencenotes.org/types-of-chemical-bonds/>)
AnnotationAssertion(rdfs:label co:PMD_0050001 "covalent bond"@en)
AnnotationAssertion(rdfs:label co:PMD_0050001 "kovalente Bindung"@de)
AnnotationAssertion(skos:definition co:PMD_0050001 "A covalent bond is a bond that forms when nonmetal atoms share electrons to achieve a stable electron configuration."@en)
AnnotationAssertion(skos:definition co:PMD_0050001 "Eine kovalente Bindung ist eine Bindung, die entsteht, wenn Nichtmetallatome Elektronen teilen, um eine stabile Elektronenkonfiguration zu erreichen."@de)
AnnotationAssertion(skos:example co:PMD_0050001 "In a water molecule (H₂O), the hydrogen and oxygen atoms share electrons."@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0050001 "true"^^xsd:boolean)
SubClassOf(co:PMD_0050001 co:PMD_0050000)

# Class: co:PMD_0050002 (metallic bond)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0050002 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0050002 "PERSON: Markus Schilling")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0050002 <https://www.thoughtco.com/metallic-bond-definition-properties-and-examples-4117948>)
AnnotationAssertion(rdfs:label co:PMD_0050002 "metallic bond"@en)
AnnotationAssertion(rdfs:label co:PMD_0050002 "metallische Bindung"@de)
AnnotationAssertion(skos:definition co:PMD_0050002 "A metallic bond is a bond that forms between metal atoms, where electrons are shared in a \"sea\" of electrons that move freely around the metal ions. This type of bonding gives metals their characteristic properties such as conductivity and malleability."@en)
AnnotationAssertion(skos:definition co:PMD_0050002 "Eine Metallbindung ist eine Bindung, die zwischen Metallatomen entsteht, wobei Elektronen in einem „Meer“ von Elektronen geteilt werden, die sich frei um die Metallionen bewegen. Diese Art der Bindung verleiht Metallen ihre charakteristischen Eigenschaften wie Leitfähigkeit und Formbarkeit."@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0050002 "true"^^xsd:boolean)
SubClassOf(co:PMD_0050002 co:PMD_0050000)

# Class: co:PMD_0050003 (Ionenbindung)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0050003 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0050003 "PERSON: Markus Schilling")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0050003 <https://sciencenotes.org/types-of-chemical-bonds/>)
AnnotationAssertion(rdfs:label co:PMD_0050003 "Ionenbindung"@de)
AnnotationAssertion(rdfs:label co:PMD_0050003 "ionic bond"@en)
AnnotationAssertion(skos:definition co:PMD_0050003 "An ionic bond is a bond that occurs when one atom donates an electron to another atom, resulting in oppositely charged ions that attract each other."@en)
AnnotationAssertion(skos:definition co:PMD_0050003 "Eine Ionenbindung ist eine Bindung, die entsteht, wenn ein Atom ein Elektron an ein anderes Atom abgibt, wodurch entgegengesetzt geladene Ionen entstehen, die sich gegenseitig anziehen."@de)
AnnotationAssertion(skos:example co:PMD_0050003 "An example is the interaction between the atoms of sodium chloride (NaCl), where the sodium atom donates an electron to a chlorine atom."@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0050003 "true"^^xsd:boolean)
SubClassOf(co:PMD_0050003 co:PMD_0050000)


AnnotationAssertion(obo:IAO_0000117 obo:OBI_0000571 "GROUP:  Role Branch")
AnnotationAssertion(obo:IAO_0000119 obo:OBI_0000571 "OBI")
AnnotationAssertion(rdfs:label obo:OBI_0000571 "manufacturer role")

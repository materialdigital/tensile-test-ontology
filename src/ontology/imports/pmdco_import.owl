# Class: co:PMD_0000638 (Ermüdungsprüfverfahren)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0000638 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0000638 "PERSON: Joerg Waitelonis")

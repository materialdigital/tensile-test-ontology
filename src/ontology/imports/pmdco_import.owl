# Class: co:PMD_0025030 (amorphous material)

AnnotationAssertion(rdfs:label co:PMD_0025030 "amorphous material"@en)
AnnotationAssertion(skos:comment co:PMD_0025030 "old axiom (material and ('has quality' some ('order scale' and 'specified by value' value 'short range order')))")
AnnotationAssertion(skos:definition co:PMD_0025030 "An amorphous material is a material that has a short-range atomic order"@en)
AnnotationAssertion(skos:example co:PMD_0025030 "Glass")

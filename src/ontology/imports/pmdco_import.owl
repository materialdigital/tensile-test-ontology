AnnotationAssertion(rdfs:label co:PMD_0020166 "heat (metallurgy)"@en)
AnnotationAssertion(skos:definition co:PMD_0020166 "A heat is a fixed amount of metallic alloy that may be input to some manufacturing process."@en)

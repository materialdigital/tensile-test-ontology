AnnotationAssertion(rdfs:label co:PMD_0000851 "melting point"@en)
AnnotationAssertion(skos:definition co:PMD_0000851 "Der Schmelzpunkt ist eine Zustandsgrenze einer Materie, die durch den Übergang vom festen in den flüssigen Zustand (oder umgekehrt) entsteht."@de)
AnnotationAssertion(skos:definition co:PMD_0000851 "The melting point is a state of matter boundary realized by transition form the solid state to the liquid state (or vice versa)."@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0000851 "true"^^xsd:boolean)
SubClassOf(co:PMD_0000851 co:PMD_0020164)


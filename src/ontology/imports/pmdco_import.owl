# Class: co:PMD_0000504 (ab initio molecular dynamics simulation)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0000504 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0000504 "PERSON: Joerg Waitelonis")
AnnotationAssertion(rdfs:label co:PMD_0000504 "Ab Initio MD Simulation"@de)
AnnotationAssertion(rdfs:label co:PMD_0000504 "ab initio molecular dynamics simulation"@en)
AnnotationAssertion(skos:definition co:PMD_0000504 "A simulation process that uses quantum mechanical calculations to predict the behavior of molecular systems without empirical parameters."@en)

AnnotationAssertion(rdfs:label co:PMD_0080105 "volume mix ratio"@en)
AnnotationAssertion(skos:definition co:PMD_0080105 "Mischengehaltverhältnis definiert das Verhältnis der Volumina von zwei Mischbestandteilen zueinander"@de)
AnnotationAssertion(skos:definition co:PMD_0080105 "Volume mix ratio defines the ratio of volumes of two mixture components to each other"@en)
AnnotationAssertion(skos:example co:PMD_0080105 "An epoxy adhesive is mixed in a volume mix ratio of 2:1 resin to hardener"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080105 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080105 co:PMD_0020104)

# Class: co:PMD_0080106 (piezoelectric coefficient)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080106 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080106 "Necessary and sufficient conditions for 'piezoelectric coefficient' have not yet been formalized. The term is defined as a specific subtype of 'physical relational quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080106 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080106 "piezoelectric coefficient"@en)
AnnotationAssertion(rdfs:label co:PMD_0080106 "piezoelektrischer Koeffizient"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080106 "d"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080106 "piezoelectric constant"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080106 "piezoelektrische Konstante"@de)
AnnotationAssertion(skos:definition co:PMD_0080106 "Piezoelectric coefficient is a physical relational quality of a material that quantifies the coupling between mechanical stress and electric polarization, expressed as the ratio of electric displacement to applied mechanical stress or the ratio of strain to applied electric field"@en)
AnnotationAssertion(skos:definition co:PMD_0080106 "Piezoelektrischer Koeffizient ist eine physikalische relationale Qualität eines Materials, die die Kopplung zwischen mechanischer Spannung und elektrischer Polarisation quantifiziert, ausgedrückt als Verhältnis der elektrischen Verschiebung zur angelegten mechanischen Spannung oder des Dehnungsanteils zum angelegten elektrischen Feld"@de)
AnnotationAssertion(skos:example co:PMD_0080106 "The d33 piezoelectric coefficient of PZT ceramics is about 400 pC/N, enabling sensitive force sensing"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080106 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080106 co:PMD_0020353)

# Class: co:PMD_0080107 (Klemmdruck)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080107 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080107 "Necessary and sufficient conditions for 'clamping pressure' have not yet been formalized. The term is defined as a specific subtype of 'pressure'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080107 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080107 "Klemmdruck"@de)
AnnotationAssertion(rdfs:label co:PMD_0080107 "clamping pressure"@en)
AnnotationAssertion(skos:definition co:PMD_0080107 "Clamping pressure describes the force per area used during the mounting process of a sample, typically involving grips or similar tools"@en)
AnnotationAssertion(skos:definition co:PMD_0080107 "Klemmdruck ist die Eigenschaft, die als quantitativer Wert die Kraft pro Fläche beschreibt, die beim Einbau einer Probe, eines Prüfkörpers oder eines Prüfstücks aufgebracht wird, typischerweise verbunden mit einer Art von Klemm- oder Spannzubehör"@de)
AnnotationAssertion(skos:example co:PMD_0080107 "A hydraulic fixture applies a clamping pressure of 5 MPa to hold a workpiece during machining"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080107 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080107 co:PMD_0020353)

# Class: co:PMD_0080108 (Spannung)

AnnotationAssertion(obo:IAO_0000117 co:PMD_0080108 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080108 "Spannung"@de)
AnnotationAssertion(rdfs:label co:PMD_0080108 "stress"@en)
AnnotationAssertion(skos:definition co:PMD_0080108 "Stress is the internal force per unit area a material experiences under external load, commonly described in tensile, compressive, or shear forms"@en)
AnnotationAssertion(skos:example co:PMD_0080108 "A cross-section of a loaded steel column bears a compressive stress of 150 MPa"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080108 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080108 co:PMD_0020311)
SubClassOf(co:PMD_0080108 co:PMD_0023004)
SubClassOf(Annotation(rdfs:comment "Mechanical view on stress"@en) co:PMD_0080108 ObjectIntersectionOf(ObjectSomeValuesFrom(obo:RO_0002328 co:PMD_0020200) ObjectSomeValuesFrom(obo:RO_0002328 co:PMD_0080019)))
SubClassOf(Annotation(rdfs:comment "Thermodynamic view on stress"@en) co:PMD_0080108 ObjectIntersectionOf(ObjectSomeValuesFrom(obo:RO_0002328 co:PMD_0020352) ObjectSomeValuesFrom(obo:RO_0002328 co:PMD_0020380)))
SubClassOf(co:PMD_0080108 ObjectSomeValuesFrom(obo:RO_0000052 co:PMD_0000001))

# Class: co:PMD_0080109 (engineering stress)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080109 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080109 "Necessary and sufficient conditions for 'engineering stress' have not yet been formalized. The term is defined as a specific subtype of 'stress'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080109 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080109 "engineering stress"@en)
AnnotationAssertion(rdfs:label co:PMD_0080109 "technische Spannung"@de)
AnnotationAssertion(skos:definition co:PMD_0080109 "Engineering stress quantifies the internal force per unit area a material experiences under load, assuming the area remains constant"@en)
AnnotationAssertion(skos:definition co:PMD_0080109 "Technische Spannung beschreibt die innere Kraft pro Fläche, die ein Material unter Last erfährt, unter der Annahme, dass die Fläche konstant bleibt"@de)
AnnotationAssertion(skos:example co:PMD_0080109 "At yield, a steel specimen with 50 mm2 cross-section under 12.5 kN shows engineering stress of 250 MPa"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080109 "true"^^xsd:boolean)
SubClassOf(Annotation(rdfs:comment "Express that force and area are properties of the anchor/independent of \"TQC of the deformation process\""@en) co:PMD_0080109 co:PMD_0080108)

# Class: co:PMD_0080110 (true stress)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080110 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080110 "Necessary and sufficient conditions for 'true stress' have not yet been formalized. The term is defined as a specific subtype of 'stress'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080110 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080110 "true stress"@en)
AnnotationAssertion(rdfs:label co:PMD_0080110 "wahre Spannung"@de)
AnnotationAssertion(skos:definition co:PMD_0080110 "True stress is defined using the cauchy stress tensor, relating stress to the current surface size of a volume element"@en)
AnnotationAssertion(skos:definition co:PMD_0080110 "Wahre Spannung wird unter Verwendung des Cauchy-Spannungstensors definiert und bezieht die Spannung auf die aktuelle Oberflächengröße eines Volumenelements"@de)
AnnotationAssertion(skos:example co:PMD_0080110 "At 10 % engineering strain in a tensile test, the true stress exceeds the engineering stress by the same factor"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080110 "true"^^xsd:boolean)
SubClassOf(Annotation(rdfs:comment "Express that force and area are properties dependent of \"TQC of the deformation process\""@en) co:PMD_0080110 co:PMD_0080108)

# Class: co:PMD_0080111 (creep stress)

AnnotationAssertion(obo:IAO_0000117 co:PMD_0080111 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080111 "Kriechspannung"@de)
AnnotationAssertion(rdfs:label co:PMD_0080111 "creep stress"@en)
AnnotationAssertion(skos:definition co:PMD_0080111 "Creep stress is characterized by strain occurring with time when a constant force is applied to a physical body"@en)
AnnotationAssertion(skos:example co:PMD_0080111 "A polymer gasket under a creep stress of 5 MPa at 60 C relaxes significantly over 1000 hours"@en)
SubClassOf(Annotation(rdfs:comment "strictly speaking this is just stress sustained over time."@en) co:PMD_0080111 ObjectIntersectionOf(co:PMD_0080108 ObjectSomeValuesFrom(obo:RO_0002328 ObjectIntersectionOf(co:PMD_0020200 ObjectSomeValuesFrom(obo:BFO_0000108 obo:BFO_0000202)))))

# Class: co:PMD_0080112 (Adhäsion)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080112 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080112 "Necessary and sufficient conditions for 'adhesion' have not yet been formalized. The term is defined as a specific subtype of 'pressure'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080112 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080112 "Adhäsion"@de)
AnnotationAssertion(rdfs:label co:PMD_0080112 "adhesion"@en)
AnnotationAssertion(skos:definition co:PMD_0080112 "Adhesion describes the ability of substances to bind to each other, involving attractive force between two bodies of different substances in contact and influencing material performance in scientific and industrial contexts"@en)
AnnotationAssertion(skos:definition co:PMD_0080112 "Adhäsion beschreibt die Fähigkeit von Substanzen, sich aneinander zu binden. Dabei handelt es sich um eine Anziehungskraft zwischen zwei in Kontakt stehenden Körpern unterschiedlicher Substanzen, die die Materialleistung in wissenschaftlichen und industriellen Kontexten beeinflusst"@de)
AnnotationAssertion(skos:example co:PMD_0080112 "The adhesion between a paint film and a steel substrate determines its resistance to delamination"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080112 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080112 co:PMD_0020353)

# Class: co:PMD_0080113 (surface tension)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080113 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080113 "Necessary and sufficient conditions for 'surface tension' have not yet been formalized. The term is defined as a specific subtype of 'adhesion'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080113 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080113 "Oberflächenspannung"@de)
AnnotationAssertion(rdfs:label co:PMD_0080113 "surface tension"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080113 "Oberflächenspannung"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080113 "surface stress"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080113 "surface tension"@en)
AnnotationAssertion(skos:definition co:PMD_0080113 "Oberflächenspannung bezeichnet den Effekt innerhalb der Oberflächenschicht einer Flüssigkeit, der durch Wechselwirkungskräfte zwischen ihren Molekülen verursacht wird"@de)
AnnotationAssertion(skos:definition co:PMD_0080113 "Surface tension refers to the effect within the surface layer of a liquid/gas interface, caused by intermolecular forces between its molecules"@en)
AnnotationAssertion(skos:example co:PMD_0080113 "Water has a surface tension of 72.8 mN/m at 20 C, enabling capillary rise in fine tubes"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080113 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080113 co:PMD_0023045)

# Class: co:PMD_0080114 (refractive index)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080114 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080114 "Necessary and sufficient conditions for 'refractive index' have not yet been formalized. The term is defined as a specific subtype of 'physical relational quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Refractive_index#Complex_index_of_refraction_and_absorption."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080114 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080114 <https://en.wikipedia.org/wiki/Refractive_index#Complex_index_of_refraction_and_absorption>)
AnnotationAssertion(rdfs:label co:PMD_0080114 "Brechzahl"@de)
AnnotationAssertion(rdfs:label co:PMD_0080114 "refractive index"@en)
AnnotationAssertion(skos:definition co:PMD_0080114 "Brechzahl gibt die Lichtbrechungsfähigkeit eines optischen Mediums an; umfasst einen realen und einen imaginären Teil, der als Extinktionskoeffizient bekannt ist"@de)
AnnotationAssertion(skos:definition co:PMD_0080114 "Refractive index indicates an optical medium's light bending ability; encompassing a real and imaginary part known as the extinction coefficient"@en)
AnnotationAssertion(skos:example co:PMD_0080114 "Optical glass BK7 has a refractive index of 1.52 at 589 nm, bending light in lenses"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080114 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080114 co:PMD_0020353)
SubClassOf(co:PMD_0080114 ObjectSomeValuesFrom(obo:BFO_0000051 co:PMD_0080115))

# Class: co:PMD_0080115 (Extinktionskoeffizient)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080115 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080115 "Necessary and sufficient conditions for 'extinction coefficient' have not yet been formalized. The term is defined as a specific subtype of 'refractive index'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Refractive_index#Complex_index_of_refraction_and_absorption."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080115 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080115 <https://en.wikipedia.org/wiki/Refractive_index#Complex_index_of_refraction_and_absorption>)
AnnotationAssertion(rdfs:label co:PMD_0080115 "Extinktionskoeffizient"@de)
AnnotationAssertion(rdfs:label co:PMD_0080115 "extinction coefficient"@en)
AnnotationAssertion(skos:definition co:PMD_0080115 "Der Extinktionskoeffizient, die imaginäre Komponente des komplexen Brechungsindex, gibt die Dämpfung elektromagnetischer Wellen durch ein Material an"@de)
AnnotationAssertion(skos:definition co:PMD_0080115 "Extinction coefficient, the imaginary component of the complex refractive index, indicates attenuation of electromagnetic waves through a material"@en)
AnnotationAssertion(skos:example co:PMD_0080115 "The extinction coefficient of gold at 500 nm wavelength is 1.87, characterizing strong optical absorption"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080115 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080115 co:PMD_0020353)

# Class: co:PMD_0080116 (potential)

AnnotationAssertion(obo:IAO_0000117 co:PMD_0080116 "Philipp von Hartrott")
AnnotationAssertion(rdfs:comment co:PMD_0080116 "Every potential in physics is the same mathematical object — a partial derivative of energy with respect to its conjugate extensive quantity. The differences are only in which extensive quality you're considering."@en)
AnnotationAssertion(rdfs:label co:PMD_0080116 "potential"@en)
AnnotationAssertion(skos:definition co:PMD_0080116 "a partial derivative of energy with respect to its conjugate extensive quantity"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080116 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080116 obo:BFO_0000019)
SubClassOf(Annotation(rdfs:comment "In field theories (e.g., gravity, electrostatics), the potential becomes a field ϕ(r⃗), and the force is recovered via:
F=−∇ϕ(r⃗)F
This is the spatial analogue: instead of asking \"how does energy change per unit carrier added?\", you ask \"how does energy change per unit carrier moved in space?\""@en) co:PMD_0080116 ObjectIntersectionOf(ObjectSomeValuesFrom(obo:RO_0002328 co:PMD_0020142) ObjectSomeValuesFrom(obo:RO_0002328 co:PMD_0020319)))

# Class: co:PMD_0080118 (gravitational potential)

AnnotationAssertion(rdfs:label co:PMD_0080118 "gravitational potential"@en)
AnnotationAssertion(skos:definition co:PMD_0080118 "the potential due to mass"@en)
SubClassOf(co:PMD_0080118 co:PMD_0080116)
SubClassOf(co:PMD_0080118 ObjectSomeValuesFrom(obo:RO_0002328 co:PMD_0020133))

# Class: co:PMD_0080119 (Wärmeübergangskoeffizient)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080119 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080119 "Necessary and sufficient conditions for 'heat transfer coefficient' have not yet been formalized. The term is defined as a specific subtype of 'physical relational quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Heat_transfer_coefficient."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080119 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080119 <https://en.wikipedia.org/wiki/Heat_transfer_coefficient>)
AnnotationAssertion(rdfs:label co:PMD_0080119 "Wärmeübergangskoeffizient"@de)
AnnotationAssertion(rdfs:label co:PMD_0080119 "heat transfer coefficient"@en)
AnnotationAssertion(skos:definition co:PMD_0080119 "Der Wärmeübertragungskoeffizient stellt die Proportionalitätskonstante zwischen dem Wärmefluss und der thermodynamischen Antriebskraft für den Wärmefluss dar und wird zur Berechnung der Wärmeübertragung, typischerweise durch Konvektion, verwendet"@de)
AnnotationAssertion(skos:definition co:PMD_0080119 "Heat transfer coefficient represents the proportionality constant between heat flux and the thermodynamic driving force for heat flow, used in calculating heat transfer, typically by convection"@en)
AnnotationAssertion(skos:example co:PMD_0080119 "A forced convection air-cooled heat sink has a heat transfer coefficient of 100 W/(m2·K)"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080119 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080119 co:PMD_0020309)
SubClassOf(co:PMD_0080119 co:PMD_0020313)
SubClassOf(co:PMD_0080119 ObjectSomeValuesFrom(co:PMD_0025999 obo:BFO_0000146))

# Class: co:PMD_0080120 (magnetic susceptibility)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080120 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080120 "Necessary and sufficient conditions for 'magnetic susceptibility' have not yet been formalized. Although χ = M/H is a well-defined ratio, a formal equivalence axiom would incorrectly classify any dimensionless relational quality of a magnetic bearer as magnetic susceptibility. Defined as a primitive subtype of 'physical relational quality'."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080120 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080120 "magnetic susceptibility"@en)
AnnotationAssertion(rdfs:label co:PMD_0080120 "magnetische Suszeptibilität"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080120 "χ"@en)
AnnotationAssertion(skos:definition co:PMD_0080120 "Magnetic susceptibility is a physical relational quality of a material that quantifies the degree to which it becomes magnetized in response to an applied magnetic field, expressed as the dimensionless ratio of magnetization to applied field intensity"@en)
AnnotationAssertion(skos:definition co:PMD_0080120 "Magnetische Suszeptibilität ist eine physikalische relationale Qualität eines Materials, die den Grad angibt, in dem es sich als Reaktion auf ein angelegtes Magnetfeld magnetisiert, ausgedrückt als dimensionsloses Verhältnis der Magnetisierung zur angelegten Feldstärke"@de)
AnnotationAssertion(skos:example co:PMD_0080120 "Paramagnetic oxygen gas has a positive magnetic susceptibility of 3.73e-6 m3/mol at 20 C"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080120 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080120 co:PMD_0020353)

# Class: co:PMD_0080121 (Fluiddurchlässigkeit)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080121 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080121 "Necessary and sufficient conditions for 'fluid permeability' have not yet been formalized. The term is defined as a specific subtype of 'physical relational quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080121 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080121 "Fluiddurchlässigkeit"@de)
AnnotationAssertion(rdfs:label co:PMD_0080121 "fluid permeability"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080121 "Darcy permeability"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080121 "Durchlässigkeit"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080121 "hydraulic permeability"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080121 "k"@en)
AnnotationAssertion(skos:definition co:PMD_0080121 "Fluid permeability is a physical relational quality of a porous material that quantifies its capacity to allow fluid flow through its pore network under an applied pressure gradient, defined by Darcy's law as the ratio of fluid flux to the pressure gradient normalized by fluid viscosity"@en)
AnnotationAssertion(skos:definition co:PMD_0080121 "Fluiddurchlässigkeit ist eine physikalische relationale Qualität eines porösen Materials, die seine Fähigkeit quantifiziert, Fluidfluss durch sein Porennetzwerk unter einem angelegten Druckgradienten zu ermöglichen, definiert durch das Darcy-Gesetz als Verhältnis des Fluidflusses zum Druckgradienten normiert durch die Viskosität des Fluids"@de)
AnnotationAssertion(skos:example co:PMD_0080121 "Sandstone with a Darcy permeability of 100 mD allows significant fluid flow under pressure gradients"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080121 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080121 co:PMD_0020353)

# Class: co:PMD_0080122 (phase velocity)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080122 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080122 "Necessary and sufficient conditions for 'phase velocity' have not yet been formalized. The term is defined as a specific subtype of 'speed'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080122 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080122 "Phasengeschwindigkeit"@de)
AnnotationAssertion(rdfs:label co:PMD_0080122 "phase velocity"@en)
AnnotationAssertion(skos:definition co:PMD_0080122 "Die Phasengeschwindigkeit bezieht sich auf die Geschwindigkeit, mit der sich die Phase einer Welle ausbreitet, definiert als Wellenlänge geteilt durch die Zeitperiode"@de)
AnnotationAssertion(skos:definition co:PMD_0080122 "Phase velocity refers to the rate at which the phase of a wave propagates, defined as wavelength divided by time period"@en)
AnnotationAssertion(skos:example co:PMD_0080122 "The phase velocity of a longitudinal ultrasonic wave in steel is approximately 5900 m/s"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080122 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080122 co:PMD_0080011)

# Class: co:PMD_0080123 (Deformationsgeschwindigkeit)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080123 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080123 "Necessary and sufficient conditions for 'deformation speed' have not yet been formalized. The term is defined as a specific subtype of 'speed'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Strain_rate."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080123 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080123 <https://en.wikipedia.org/wiki/Strain_rate>)
AnnotationAssertion(rdfs:label co:PMD_0080123 "Deformationsgeschwindigkeit"@de)
AnnotationAssertion(rdfs:label co:PMD_0080123 "deformation speed"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080123 "Dehnrate"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080123 "strain rate"@en)
AnnotationAssertion(skos:definition co:PMD_0080123 "Deformation speed measures the rate at which distances of adjacent material parcels change with time near a specific point, including expansion and shear rates"@en)
AnnotationAssertion(skos:definition co:PMD_0080123 "Die Verformungsgeschwindigkeit misst die Geschwindigkeit, mit der sich die Abstände benachbarter Materialpakete in der Nähe eines bestimmten Punktes im Laufe der Zeit ändern, einschließlich Expansions- und Schergeschwindigkeiten"@de)
AnnotationAssertion(skos:example co:PMD_0080123 "During high-rate forming, the deformation speed of the punch reaches 10 m/s"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080123 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080123 co:PMD_0080011)

# Class: co:PMD_0080125 (sound insulation index)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080125 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080125 "Necessary and sufficient conditions for 'sound insulation index' have not yet been formalized. The term is defined as a specific subtype of 'acoustic capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080125 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080125 "Schalldämmmaß"@de)
AnnotationAssertion(rdfs:label co:PMD_0080125 "sound insulation index"@en)
AnnotationAssertion(skos:definition co:PMD_0080125 "Schalldämmmaß quantifiziert die Fähigkeit eines Materials, die Schallübertragung zu reduzieren"@de)
AnnotationAssertion(skos:definition co:PMD_0080125 "Sound insulation index quantifies the ability of a material to reduce sound transmission"@en)
AnnotationAssertion(skos:example co:PMD_0080125 "A 200 mm concrete wall achieves a sound insulation index of 52 dB, blocking most airborne noise"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080125 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080125 co:PMD_0020317)
SubClassOf(co:PMD_0080125 ObjectIntersectionOf(co:PMD_0000506 ObjectSomeValuesFrom(obo:RO_0000052 obo:BFO_0000030)))

# Class: co:PMD_0080127 (elektrische Kapazität)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080127 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080127 "Necessary and sufficient conditions for 'electrical capacitance' have not yet been formalized. The term is defined as a specific subtype of 'electrical capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080127 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080127 "electrical capacitance"@en)
AnnotationAssertion(rdfs:label co:PMD_0080127 "elektrische Kapazität"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080127 "electrical capacitance"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080127 "electrical capacity"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080127 "elektrische Kapazität"@de)
AnnotationAssertion(skos:definition co:PMD_0080127 "Die elektrische Kapazität bezieht sich auf die Fähigkeit eines Wesens, elektrische Ladung zu speichern, ausgedrückt als die Menge an elektrischer Ladung, die pro gegebenem elektrischem Potenzial gespeichert wird"@de)
AnnotationAssertion(skos:definition co:PMD_0080127 "Electrical capacitance refers to an entity's ability to store electric charge, expressed as the amount of electric charge stored per given electric potential"@en)
AnnotationAssertion(skos:example co:PMD_0080127 "A ceramic capacitor has an electrical capacitance of 100 nF, storing charge in an electronic circuit"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080127 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080127 obo:BFO_0000019)
SubClassOf(co:PMD_0080127 co:PMD_0020312)
SubClassOf(co:PMD_0080127 co:PMD_0020317)
SubClassOf(co:PMD_0080127 ObjectSomeValuesFrom(obo:RO_0000080 obo:BFO_0000030))

# Class: co:PMD_0080128 (electrical resistance)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080128 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080128 "Necessary and sufficient conditions for 'electrical resistance' have not yet been formalized. The term is defined as a specific subtype of 'electrical capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://www.britannica.com/technology/resistance-electronics."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080128 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080128 <https://www.britannica.com/technology/resistance-electronics>)
AnnotationAssertion(rdfs:label co:PMD_0080128 "electrical resistance"@en)
AnnotationAssertion(rdfs:label co:PMD_0080128 "elektrischer Widerstand"@de)
AnnotationAssertion(skos:definition co:PMD_0080128 "Der elektrische Widerstand bezieht sich auf die Fähigkeit eines Stromkreises, elektrische Energie in Wärmeenergie umzuwandeln, indem er elektrischem Strom durch Teilchenkollisionen entgegenwirkt, die für Widerstände, Lampen und Drähte charakteristisch sind"@de)
AnnotationAssertion(skos:definition co:PMD_0080128 "Electrical resistance pertains to a circuit's capability to transform electric energy into heat energy, opposing electric current through particle collisions, characteristic of resistors, lamps, and wires"@en)
AnnotationAssertion(skos:example co:PMD_0080128 "A nichrome heating element has an electrical resistance of 10 Ω at room temperature"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080128 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080128 obo:BFO_0000019)
SubClassOf(co:PMD_0080128 co:PMD_0020312)
SubClassOf(co:PMD_0080128 co:PMD_0020317)
SubClassOf(co:PMD_0080128 ObjectSomeValuesFrom(obo:RO_0000080 obo:BFO_0000030))

# Class: co:PMD_0080129 (electrical conductance)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080129 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080129 "Necessary and sufficient conditions for 'electrical conductance' have not yet been formalized. The term is defined as a specific subtype of 'electrical capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080129 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080129 "electrical conductance"@en)
AnnotationAssertion(rdfs:label co:PMD_0080129 "elektrischer Leitwert"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080129 "Stromleitwert"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080129 "electrical conductance"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080129 "elektrischer Leitwert"@de)
AnnotationAssertion(skos:definition co:PMD_0080129 "Der elektrische Leitwert stellt den Kehrwert des elektrischen Widerstands eines Leiters dar und misst seine Fähigkeit, elektrischen Strom zu leiten, angegeben in Siemens (S)."@de)
AnnotationAssertion(skos:definition co:PMD_0080129 "Electrical conductance represents the reciprocal of a conductor's electrical resistance, measuring its ability to conduct an electric current, denoted in siemens (S)"@en)
AnnotationAssertion(skos:example co:PMD_0080129 "A copper wire of 1 m length and 1 mm2 cross-section has an electrical conductance of about 59 S"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080129 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080129 obo:BFO_0000019)
SubClassOf(co:PMD_0080129 co:PMD_0020312)
SubClassOf(co:PMD_0080129 co:PMD_0020317)
SubClassOf(co:PMD_0080129 ObjectSomeValuesFrom(obo:RO_0000080 obo:BFO_0000030))

# Class: co:PMD_0080131 (Sättigungsmagnetisierung)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080131 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080131 "Necessary and sufficient conditions for 'saturation magnetization' have not yet been formalized. The term is defined as a specific subtype of 'magnetic capability'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080131 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080131 "Sättigungsmagnetisierung"@de)
AnnotationAssertion(rdfs:label co:PMD_0080131 "saturation magnetization"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080131 "M_s"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080131 "magnetic saturation"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080131 "magnetische Sättigung"@de)
AnnotationAssertion(skos:definition co:PMD_0080131 "Saturation magnetization is a magnetic capability of a material that specifies the maximum magnetic moment per unit volume achieved when all magnetic domains are aligned with an applied external field"@en)
AnnotationAssertion(skos:definition co:PMD_0080131 "Sättigungsmagnetisierung ist eine magnetische Fähigkeit eines Materials, die das maximale magnetische Moment pro Volumeneinheit angibt, das erreicht wird, wenn alle magnetischen Domänen mit einem angelegten äußeren Feld ausgerichtet sind"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080131 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080131 co:PMD_0020312)

# Class: co:PMD_0080133 (durability)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080133 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080133 "Necessary and sufficient conditions for 'durability' have not yet been formalized. The term is defined as a specific subtype of 'mechanical capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080133 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080133 "Dauerhaftigkeit"@de)
AnnotationAssertion(rdfs:label co:PMD_0080133 "durability"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080133 "Dauerhaftigkeit"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080133 "Langlebigkeit"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080133 "durability"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080133 "longevity"@en)
AnnotationAssertion(skos:definition co:PMD_0080133 "Die Dauerhaftigkeit ist die Fähigkeit eines Materials, Abnutzung, Rissbildung und andere Arten von Schäden im Laufe der Zeit zu widerstehen"@de)
AnnotationAssertion(skos:definition co:PMD_0080133 "Durability is the ability of a material to resist wear, tear, and other types of damage over time"@en)
AnnotationAssertion(skos:example co:PMD_0080133 "Galvanized steel shows high durability in outdoor environments, resisting corrosion for over 50 years"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080133 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080133 co:PMD_0020353)

# Class: co:PMD_0080134 (Verschleißfestigkeit)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080134 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080134 "Necessary and sufficient conditions for 'wear resistance' have not yet been formalized. The term is defined as a specific subtype of 'durability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080134 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080134 "Verschleißfestigkeit"@de)
AnnotationAssertion(rdfs:label co:PMD_0080134 "wear resistance"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080134 "Verschleißfestigkeit"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080134 "resistance to wear"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080134 "wear resistance"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080134 "widerstand gegen Verschleiß"@de)
AnnotationAssertion(skos:definition co:PMD_0080134 "Verschleißfestigkeit ist die Fähigkeit eines Materials, mechanischen Aktionen wie Reiben, Kratzen oder Erosion zu widerstehen, die dazu tendieren, Material allmählich von seiner Oberfläche zu entfernen."@de)
AnnotationAssertion(skos:definition co:PMD_0080134 "Wear resistance is the ability of a material to resist mechanical actions such as rubbing, scraping or erosion that tend to progressively remove material from its surface."@en)
AnnotationAssertion(skos:example co:PMD_0080134 "Hardened tool steel has high wear resistance, maintaining a cutting edge through thousands of machining cycles"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080134 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080134 co:PMD_0080133)

# Class: co:PMD_0080135 (Kriechfestigkeit)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080135 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080135 "Necessary and sufficient conditions for 'creep resistance' have not yet been formalized. The term is defined as a specific subtype of 'durability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080135 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080135 "Kriechfestigkeit"@de)
AnnotationAssertion(rdfs:label co:PMD_0080135 "creep resistance"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080135 "Creep Resistance"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080135 "Creep Resistant"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080135 "Kriechfestig"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080135 "Kriechfestigkeit"@de)
AnnotationAssertion(skos:definition co:PMD_0080135 "Creep resistance is the ability of a material to resist deformation under load over time"@en)
AnnotationAssertion(skos:definition co:PMD_0080135 "Die Kriechfestigkeit ist die Fähigkeit eines Materials, unter Last über einen bestimmten Zeitraum eine Deformation zu widerstehen"@de)
AnnotationAssertion(skos:example co:PMD_0080135 "Nickel superalloys have high creep resistance, maintaining shape under stress at 1000 C in turbine blades"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080135 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080135 co:PMD_0080133)

# Class: co:PMD_0080136 (poisson effect)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080136 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080136 "Necessary and sufficient conditions for 'poisson effect' have not yet been formalized. The term is defined as a specific subtype of 'mechanical capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Poisson%27s_ratio."@en)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080136 "Was a subclass of 'Mechanical Quality'")
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080136 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080136 <https://en.wikipedia.org/wiki/Poisson%27s_ratio>)
AnnotationAssertion(rdfs:label co:PMD_0080136 "Querkontraktion"@de)
AnnotationAssertion(rdfs:label co:PMD_0080136 "poisson effect"@en)
AnnotationAssertion(skos:definition co:PMD_0080136 "Poisson effect describes deformation perpendicular to the direction of loading, named after Siméon Poisson"@en)
AnnotationAssertion(skos:definition co:PMD_0080136 "Querkontraktion beschreibt die Deformation senkrecht zur Belastungsrichtung, benannt nach Siméon Poisson"@de)
AnnotationAssertion(skos:example co:PMD_0080136 "A rubber cylinder loaded axially expands radially due to the Poisson effect, with a ratio of about 0.5"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080136 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080136 co:PMD_0020353)

# Class: co:PMD_0080137 (Poissonzahl)

AnnotationAssertion(obo:IAO_0000117 co:PMD_0080137 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080137 "Poissonzahl"@de)
AnnotationAssertion(rdfs:label co:PMD_0080137 "poisson's ratio"@en)
AnnotationAssertion(skos:definition co:PMD_0080137 "a classical mechanics property defining the strain in one direction, given the strain in a perpendicular direction."@en)
AnnotationAssertion(skos:example co:PMD_0080137 "Rubber has a Poisson's ratio close to 0.5, indicating nearly incompressible behavior under loading"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080137 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080137 co:PMD_0023004)
SubClassOf(Annotation(rdfs:comment "The two strains should be perpendicular to each other"@en) co:PMD_0080137 ObjectIntersectionOf(co:PMD_0020311 ObjectSomeValuesFrom(obo:RO_0000052 co:PMD_0000000) ObjectSomeValuesFrom(obo:RO_0002328 co:PMD_0080029)))

# Class: co:PMD_0080138 (material fatigue)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080138 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080138 "Necessary and sufficient conditions for 'aterial fatigue' have not yet been formalized. The term is defined as a specific subtype of 'mechanical capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080138 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080138 "Materialermüdung"@de)
AnnotationAssertion(rdfs:label co:PMD_0080138 "material fatigue"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080138 "Ermüdung des Materials"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080138 "Materialermüdung"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080138 "fatigue of material"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080138 "material fatigue"@en)
AnnotationAssertion(skos:definition co:PMD_0080138 "Material fatigue is the failure of a material caused by repeated or sustained loading below its ultimate strength."@en)
AnnotationAssertion(skos:definition co:PMD_0080138 "Materialermüdung ist das Versagen von Werkstoffen infolge wiederholter oder dauernder Belastung unterhalb der Probenfestigkeit"@de)
AnnotationAssertion(skos:example co:PMD_0080138 "Repeated cyclic loading at 400 MPa induces material fatigue in a steel shaft, leading to crack initiation"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080138 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080138 co:PMD_0020353)

# Class: co:PMD_0080139 (Schlagenergie)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080139 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080139 "Necessary and sufficient conditions for 'impact energy' have not yet been formalized. The term is defined as a specific subtype of 'mechanical capability'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080139 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080139 "Schlagenergie"@de)
AnnotationAssertion(rdfs:label co:PMD_0080139 "impact energy"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080139 "Charpy impact energy"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080139 "KV"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080139 "Kerbschlagenergie"@de)
AnnotationAssertion(skos:definition co:PMD_0080139 "Impact energy is a mechanical capability of a material that characterises the total energy absorbed by a standardised notched specimen during fracture under a single impact blow, as measured in a Charpy or Izod test"@en)
AnnotationAssertion(skos:definition co:PMD_0080139 "Schlagenergie ist eine mechanische Fähigkeit eines Materials, die die gesamte Energie beschreibt, die eine standardisierte gekerbte Probe beim Bruch unter einem einzigen Schlagimpuls absorbiert, gemessen im Charpy- oder Izod-Versuch"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080139 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080139 co:PMD_0020353)

# Class: co:PMD_0080143 (viscoelasticity)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080143 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080143 "Necessary and sufficient conditions for 'viscoelasticity' have not yet been formalized. The term is defined as a specific subtype of 'strength'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080143 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080143 "Viscoelastizität"@de)
AnnotationAssertion(rdfs:label co:PMD_0080143 "viscoelasticity"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080143 "Viscoelastizität"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080143 "Viskoelastizität"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080143 "elasticity of viscosity"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080143 "viscoelasticity"@en)
AnnotationAssertion(skos:definition co:PMD_0080143 "Viscoelasticity describes materials exhibiting both viscous and elastic characteristics during deformation"@en)
AnnotationAssertion(skos:definition co:PMD_0080143 "Viscoelastizität beschreibt Materialien, die sowohl viskose als auch elastische Eigenschaften während der Verformung zeigen"@de)
AnnotationAssertion(skos:example co:PMD_0080143 "Polymers exhibit viscoelasticity, showing both elastic recovery and creep under constant load"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080143 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080143 co:PMD_0020353)

# Class: co:PMD_0080144 (Kriechmodul)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080144 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080144 "Necessary and sufficient conditions for 'creep modulus' have not yet been formalized. The term is defined as a specific subtype of 'viscoelasticity'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080144 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080144 "Kriechmodul"@de)
AnnotationAssertion(rdfs:label co:PMD_0080144 "creep modulus"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080144 "Kriechmodul"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080144 "creep modulus"@en)
AnnotationAssertion(skos:definition co:PMD_0080144 "Creep modulus measures a material's viscoelasticity, indicating its ability to deform under stress over time"@en)
AnnotationAssertion(skos:definition co:PMD_0080144 "Der Kriechmodul ist ein Maß für die Viskoelastizität eines Materials, das seine Fähigkeit zur Verformung unter Belastung im Laufe der Zeit beschreibt"@de)
AnnotationAssertion(skos:example co:PMD_0080144 "The creep modulus of polyethylene at 50 C and 1 MPa after 1000 hours is 200 MPa"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080144 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080144 co:PMD_0020353)

# Class: co:PMD_0080145 (Komplexmodul)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080145 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080145 "Necessary and sufficient conditions for 'complex modulus' have not yet been formalized. The term is defined as a specific subtype of 'viscoelasticity'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080145 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080145 "Komplexmodul"@de)
AnnotationAssertion(rdfs:label co:PMD_0080145 "complex modulus"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080145 "E*"@en)
AnnotationAssertion(skos:definition co:PMD_0080145 "Complex modulus is a viscoelastic quality of a material that represents the total stiffness response under oscillatory loading as a complex number, comprising the storage modulus as the real part and the loss modulus as the imaginary part"@en)
AnnotationAssertion(skos:definition co:PMD_0080145 "Komplexmodul ist eine viskoelastische Qualität eines Materials, die die gesamte Steifigkeitsantwort unter schwingender Belastung als komplexe Zahl darstellt, bestehend aus dem Speichermodul als Realteil und dem Verlustmodul als Imaginärteil"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080145 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080145 co:PMD_0020353)

# Class: co:PMD_0080146 (Verlustmodul)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080146 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080146 "Necessary and sufficient conditions for 'loss modulus' have not yet been formalized. The term is defined as a specific subtype of 'complex modulus'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Dynamic_modulus."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080146 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080146 <https://en.wikipedia.org/wiki/Dynamic_modulus>)
AnnotationAssertion(rdfs:label co:PMD_0080146 "Verlustmodul"@de)
AnnotationAssertion(rdfs:label co:PMD_0080146 "loss modulus"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080146 "E''"@en)
AnnotationAssertion(skos:definition co:PMD_0080146 "Loss modulus is the imaginary part of the complex modulus that measures the viscous portion of energy dissipated as heat per cycle in a viscoelastic material under oscillatory loading"@en)
AnnotationAssertion(skos:definition co:PMD_0080146 "Verlustmodul ist der Imaginärteil des Komplexmoduls und misst den viskosen Anteil der pro Zyklus als Wärme dissipierten Energie in einem viskoelastischen Material unter schwingender Belastung"@de)
AnnotationAssertion(skos:example co:PMD_0080146 "The loss modulus of a viscoelastic polymer at 1 Hz is 0.3 MPa, representing energy dissipation per cycle"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080146 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080146 co:PMD_0080145)

# Class: co:PMD_0080147 (dynamic modulus)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080147 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080147 "Necessary and sufficient conditions for 'dynamic modulus' have not yet been formalized. The term is defined as a specific subtype of 'complex modulus'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Dynamic_modulus."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080147 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080147 <https://en.wikipedia.org/wiki/Dynamic_modulus>)
AnnotationAssertion(rdfs:label co:PMD_0080147 "dynamic modulus"@en)
AnnotationAssertion(rdfs:label co:PMD_0080147 "dynamischer Modul"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080147 "complex shear modulus"@en)
AnnotationAssertion(skos:definition co:PMD_0080147 "Dynamic modulus is the ratio of stress to strain under vibratory conditions, typically measured in shear, compression, or elongation tests, and characterizes viscoelastic materials"@en)
AnnotationAssertion(skos:definition co:PMD_0080147 "Dynamischer Modul ist das Verhältnis von Spannung zu Dehnung unter schwingenden Bedingungen, typischerweise gemessen in Scher-, Druck- oder Dehnungstests, und charakterisiert viskoelastische Materialien"@de)
AnnotationAssertion(skos:example co:PMD_0080147 "The dynamic modulus of a rubber compound at 10 Hz is 15 MPa, relevant for vibration isolation design"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080147 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080147 co:PMD_0080145)

# Class: co:PMD_0080148 (Verlustwinkel)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080148 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080148 "Necessary and sufficient conditions for 'loss tangent' have not yet been formalized. The term is defined as a specific subtype of 'dynamic modulus'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Dynamic_modulus."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080148 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080148 <https://en.wikipedia.org/wiki/Dynamic_modulus>)
AnnotationAssertion(rdfs:label co:PMD_0080148 "Verlustwinkel"@de)
AnnotationAssertion(rdfs:label co:PMD_0080148 "loss tangent"@en)
AnnotationAssertion(skos:definition co:PMD_0080148 "Der Verlustfaktor, dargestellt als tan δ, ist das Verhältnis des Verlustmoduls zum Speichermodul in viskoelastischen Materialien und liefert ein Maß für die Dämpfung"@de)
AnnotationAssertion(skos:definition co:PMD_0080148 "Loss tangent, represented as tan δ, is the ratio of the loss modulus to storage modulus in viscoelastic materials, providing a measure of damping"@en)
AnnotationAssertion(skos:example co:PMD_0080148 "A PTFE cable insulator has a loss tangent of 0.0002 at 1 GHz, minimizing signal attenuation"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080148 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080148 co:PMD_0080147)

# Class: co:PMD_0080149 (Speichermodul)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080149 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080149 "Necessary and sufficient conditions for 'storage modulus' have not yet been formalized. The term is defined as a specific subtype of 'complex modulus'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Dynamic_modulus."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080149 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080149 <https://en.wikipedia.org/wiki/Dynamic_modulus>)
AnnotationAssertion(rdfs:label co:PMD_0080149 "Speichermodul"@de)
AnnotationAssertion(rdfs:label co:PMD_0080149 "storage modulus"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080149 "E'"@en)
AnnotationAssertion(skos:definition co:PMD_0080149 "Speichermodul ist der Realteil des Komplexmoduls und misst den elastischen Anteil der gespeicherten und zurückgewonnenen Energie pro Zyklus in einem viskoelastischen Material unter schwingender Belastung"@de)
AnnotationAssertion(skos:definition co:PMD_0080149 "Storage modulus is the real part of the complex modulus that measures the elastic portion of energy stored and recovered per cycle in a viscoelastic material under oscillatory loading"@en)
AnnotationAssertion(skos:example co:PMD_0080149 "The storage modulus of a polyurethane foam at 1 Hz and 25 C is 0.5 MPa, reflecting its elastic stiffness"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080149 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080149 co:PMD_0080145)

# Class: co:PMD_0080150 (Zähigkeit)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080150 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080150 "Necessary and sufficient conditions for 'toughness' have not yet been formalized. The term is defined as a specific subtype of 'strength'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080150 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080150 "Zähigkeit"@de)
AnnotationAssertion(rdfs:label co:PMD_0080150 "toughness"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080150 "Zähigkeit"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080150 "toughness"@en)
AnnotationAssertion(skos:definition co:PMD_0080150 "Toughness describes the resistance of a material to fracture or crack propagation, determined by its ability to absorb mechanical energy during deformation"@en)
AnnotationAssertion(skos:definition co:PMD_0080150 "Zähigkeit beschreibt die Widerstandsfähigkeit eines Werkstoffs gegen Bruch oder Rissausbreitung, bestimmt durch die Fähigkeit zur Absorption von mechanischer Energie bei Verformung"@de)
AnnotationAssertion(skos:example co:PMD_0080150 "High-toughness tool steel absorbs 80 J before fracture in a Charpy V-notch test at room temperature"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080150 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080150 co:PMD_0020335)

# Class: co:PMD_0080151 (fracture toughness)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080151 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080151 "Necessary and sufficient conditions for 'fracture toughness' have not yet been formalized. The term is defined as a specific subtype of 'toughness'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080151 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080151 "Bruchzähigkeit"@de)
AnnotationAssertion(rdfs:label co:PMD_0080151 "fracture toughness"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080151 "K_Ic"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080151 "critical stress intensity factor"@en)
AnnotationAssertion(skos:definition co:PMD_0080151 "Bruchzähigkeit ist eine Zähigkeitsqualität eines Materials, die die kritische Spannungsintensität beschreibt, bei der ein vorhandener Riss zu wachsen beginnt"@de)
AnnotationAssertion(skos:definition co:PMD_0080151 "Fracture toughness is a toughness quality of a material that specifies the critical stress intensity at which a pre-existing crack begins to propagate, expressed as the stress intensity factor at the onset of fracture"@en)
AnnotationAssertion(skos:example co:PMD_0080151 "Fracture toughness of a high-strength steel measured as 50 MPa·√m according to ISO 17281 test conditions."@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080151 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080151 co:PMD_0080150)

# Class: co:PMD_0080152 (impact strength)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080152 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080152 "Necessary and sufficient conditions for 'impact strength' have not yet been formalized. The term is defined as a specific subtype of 'toughness'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080152 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080152 "Schlagzähigkeit"@de)
AnnotationAssertion(rdfs:label co:PMD_0080152 "impact strength"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080152 "Schlagfestigkeit"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080152 "Schlagzähigkeit"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080152 "impact strength"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080152 "mpact strength"@en)
AnnotationAssertion(skos:definition co:PMD_0080152 "Impact strength is the ability of a material to absorb energy and plastically deform without fracturing under dynamic load"@en)
AnnotationAssertion(skos:definition co:PMD_0080152 "Schlagzähigkeit bezeichnet die Fähigkeit eines Materials, Energie zu absorbieren und bei Anwendung einer dynamischen Last plastisch zu verformen, ohne dass es bricht"@de)
AnnotationAssertion(skos:example co:PMD_0080152 "A Charpy impact test on notched steel gives an impact strength of 120 J, indicating good toughness"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080152 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080152 co:PMD_0080150)

# Class: co:PMD_0080154 (ultimate tensile strength)

AnnotationAssertion(obo:IAO_0000117 co:PMD_0080154 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080154 "Zugfestigkeit"@de)
AnnotationAssertion(rdfs:label co:PMD_0080154 "ultimate tensile strength"@en)
AnnotationAssertion(skos:definition co:PMD_0080154 "the maximum (normal) stress a material can withstand before rupturing"@en)
AnnotationAssertion(skos:example co:PMD_0080154 "A high-strength bolt grade 10.9 has a tensile strength of at least 1040 MPa"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080154 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080154 obo:BFO_0000017)
SubClassOf(co:PMD_0080154 ObjectIntersectionOf(co:PMD_0000952 ObjectSomeValuesFrom(obo:BFO_0000054 co:PMD_0020339) ObjectSomeValuesFrom(obo:RO_0002328 co:PMD_0020336)))

# Class: co:PMD_0080155 (Druckfestigkeit)

AnnotationAssertion(obo:IAO_0000117 co:PMD_0080155 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080155 "Druckfestigkeit"@de)
AnnotationAssertion(rdfs:label co:PMD_0080155 "ultimate compressive strength"@en)
AnnotationAssertion(skos:definition co:PMD_0080155 "Compressive strength is the maximum stress a material can withstand under uniaxial compressive loading before failure"@en)
AnnotationAssertion(skos:example co:PMD_0080155 "Compressive strength of a concrete specimen measured as 30 MPa according to ISO 4012 test conditions."@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080155 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080155 ObjectIntersectionOf(co:PMD_0000952 ObjectSomeValuesFrom(obo:RO_0002328 co:PMD_0020337)))

# Class: co:PMD_0080156 (flexural strength)

AnnotationAssertion(obo:IAO_0000117 co:PMD_0080156 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080156 "flexural strength"@en)
AnnotationAssertion(skos:definition co:PMD_0080156 "Flexural strength indicates a material's ability to resist deformation under flexural load"@en)
AnnotationAssertion(skos:example co:PMD_0080156 "A ceramic bending bar fractures at a flexural strength of 350 MPa in a three-point bend test"@en)
SubClassOf(co:PMD_0080156 obo:BFO_0000017)
SubClassOf(co:PMD_0080156 ObjectIntersectionOf(co:PMD_0000952 ObjectSomeValuesFrom(obo:BFO_0000054 co:PMD_0000596) ObjectSomeValuesFrom(obo:BFO_0000054 co:PMD_0020339)))

# Class: co:PMD_0080157 (shear strength)

AnnotationAssertion(rdfs:label co:PMD_0080157 "shear strength"@en)
AnnotationAssertion(skos:definition co:PMD_0080157 "Shear strength is the maximum shear stress a material can withstand before failure along a plane parallel to the applied force"@en)
AnnotationAssertion(skos:example co:PMD_0080157 "Shear strength of a CFRP laminate specimen measured as 85 MPa according to ISO 14130 test conditions."@en)
SubClassOf(co:PMD_0080157 obo:BFO_0000017)
SubClassOf(co:PMD_0080157 ObjectIntersectionOf(co:PMD_0000952 ObjectSomeValuesFrom(obo:BFO_0000054 co:PMD_0020339)))
SubClassOf(co:PMD_0080157 ObjectIntersectionOf(co:PMD_0080108 ObjectSomeValuesFrom(obo:RO_0002328 co:PMD_0020333)))

# Class: co:PMD_0080159 (Witterungsbeständigkeit)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080159 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080159 "Necessary and sufficient conditions for 'weathering resistance' have not yet been formalized. The term is defined as a specific subtype of 'operational strength'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080159 "Was a subclass of 'Operational Strength';  But 'Operational Strength' does not appear to be Quality."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080159 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080159 "Witterungsbeständigkeit"@de)
AnnotationAssertion(rdfs:label co:PMD_0080159 "weathering resistance"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080159 "Witterungsbeständigkeit"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080159 "weather resistant"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080159 "weathering resistance"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080159 "wetterbeständig"@de)
AnnotationAssertion(skos:definition co:PMD_0080159 "Ability of a material to resist the effects of weathering, such as wind, rain, and sunlight."@en)
AnnotationAssertion(skos:definition co:PMD_0080159 "Fähigkeit eines Materials, den Auswirkungen von Witterungseinflüssen wie Wind, Regen und Sonnenlicht standzuhalten."@de)
AnnotationAssertion(skos:example co:PMD_0080159 "HDPE pipes show high weathering resistance, retaining mechanical properties after years of UV exposure"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080159 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080159 co:PMD_0020335)

# Class: co:PMD_0080163 (fatigue strength)

AnnotationAssertion(obo:IAO_0000117 co:PMD_0080163 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080163 "fatigue strength"@en)
AnnotationAssertion(skos:definition co:PMD_0080163 "Fatigue strength denotes a material's ability to resist fatigue or cyclic loading"@en)
AnnotationAssertion(skos:example co:PMD_0080163 "The fatigue strength of steel at 10^7 cycles is approximately half its tensile strength"@en)
SubClassOf(co:PMD_0080163 obo:BFO_0000017)
SubClassOf(co:PMD_0080163 ObjectIntersectionOf(co:PMD_0000952 ObjectSomeValuesFrom(obo:BFO_0000054 co:PMD_0020141)))

# Class: co:PMD_0080164 (elasticity)

AnnotationAssertion(obo:IAO_0000117 co:PMD_0080164 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080164 "Elastizität"@de)
AnnotationAssertion(rdfs:label co:PMD_0080164 "elasticity"@en)
AnnotationAssertion(skos:definition co:PMD_0080164 "Elasticity is the disposition of a material to resume its initial shape after deformation"@en)
AnnotationAssertion(skos:example co:PMD_0080164 "Rubber exhibits high elasticity, recovering its original shape after 300 % elongation"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080164 "true"^^xsd:boolean)
SubClassOf(Annotation(rdfs:comment "Should comprise reversibility/non-dissipative aspect in process"@en) co:PMD_0080164 co:PMD_0020311)

# Class: co:PMD_0080166 (shear modulus)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080166 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080166 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080166 "Schubmodul"@de)
AnnotationAssertion(rdfs:label co:PMD_0080166 "shear modulus"@en)
AnnotationAssertion(skos:definition co:PMD_0080166 "Shear modulus is a measure of elastic shear stiffness, defined as the ratio of shear stress to shear strain"@en)
AnnotationAssertion(skos:example co:PMD_0080166 "The shear modulus of aluminum is 26 GPa, governing torsional deformation of shafts"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080166 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080166 co:PMD_0023004)
SubClassOf(co:PMD_0080166 ObjectIntersectionOf(co:PMD_0020311 ObjectSomeValuesFrom(obo:RO_0000052 co:PMD_0000000) ObjectSomeValuesFrom(obo:RO_0002328 co:PMD_0020334) ObjectSomeValuesFrom(obo:RO_0002328 co:PMD_0080034)))

# Class: co:PMD_0080167 (specific elastic modulus)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080167 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080167 "Necessary and sufficient conditions for 'specific elastic modulus' have not yet been formalized. Although specific elastic modulus is defined as a ratio of elastic modulus to density, a co-inherence axiom cannot uniquely identify this quality among all stiffness qualities of the same bearer. The term is defined as a specific subtype of 'stiffness'."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080167 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080167 "specific elastic modulus"@en)
AnnotationAssertion(rdfs:label co:PMD_0080167 "spezifischer Elastizitätsmodul"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080167 "specific modulus"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080167 "specific stiffness"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080167 "spezifische Steifigkeit"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080167 "spezifischer Modul"@de)
AnnotationAssertion(skos:definition co:PMD_0080167 "Specific elastic modulus is a stiffness quality of a material expressed as the ratio of its elastic modulus to its density, representing the material's elastic stiffness per unit mass"@en)
AnnotationAssertion(skos:definition co:PMD_0080167 "Spezifischer Elastizitätsmodul ist eine Steifigkeitsqualität eines Materials, ausgedrückt als Verhältnis seines Elastizitätsmoduls zu seiner Dichte und repräsentiert die elastische Steifigkeit des Materials je Masseneinheit"@de)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080167 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080167 co:PMD_0020311)
SubClassOf(co:PMD_0080167 ObjectIntersectionOf(ObjectSomeValuesFrom(obo:RO_0002328 co:PMD_0000618) ObjectSomeValuesFrom(obo:RO_0002328 co:PMD_0023002)))
SubClassOf(co:PMD_0080167 ObjectSomeValuesFrom(obo:RO_0002328 co:PMD_0000618))

# Class: co:PMD_0080168 (flexural modulus)

AnnotationAssertion(obo:IAO_0000117 co:PMD_0080168 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080168 "Biegemodul"@de)
AnnotationAssertion(rdfs:label co:PMD_0080168 "flexural modulus"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080168 "bending modulus"@en)
AnnotationAssertion(skos:definition co:PMD_0080168 "Flexural modulus is a stiffness quality of a material that specifies the ratio of stress to strain in the elastic region of a bending test, representing resistance to elastic deformation under flexural load"@en)
AnnotationAssertion(skos:example co:PMD_0080168 "Flexural modulus of a glass-fibre reinforced polyamide measured as 9.5 GPa under ISO 178 three-point bending test conditions."@en)
SubClassOf(co:PMD_0080168 ObjectIntersectionOf(co:PMD_0000618 ObjectSomeValuesFrom(obo:RO_0009007 co:PMD_0000530)))

# Class: co:PMD_0080169 (adhesion strength)

AnnotationAssertion(obo:IAO_0000117 co:PMD_0080169 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080169 "adhesion strength"@en)
AnnotationAssertion(skos:definition co:PMD_0080169 "Adhesion strength measures the force required to separate two surfaces bonded together"@en)
AnnotationAssertion(skos:example co:PMD_0080169 "An epoxy adhesive joint on steel substrates has an adhesion strength of 20 MPa in lap shear testing"@en)
SubClassOf(co:PMD_0080169 obo:BFO_0000017)
SubClassOf(co:PMD_0080169 ObjectIntersectionOf(co:PMD_0000952 ObjectSomeValuesFrom(obo:BFO_0000054 co:PMD_0020339)))

# Class: co:PMD_0080170 (plasticity)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080170 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080170 "Necessary and sufficient conditions for 'plasticity' have not yet been formalized. The term is defined as a specific subtype of 'strength'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080170 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080170 "Plastizität"@de)
AnnotationAssertion(rdfs:label co:PMD_0080170 "plasticity"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080170 "Plastizität"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080170 "plasticity"@en)
AnnotationAssertion(skos:definition co:PMD_0080170 "Plasticity signifies a material's ability to undergo permanent deformation without breaking or cracking"@en)
AnnotationAssertion(skos:definition co:PMD_0080170 "Plastizität bezeichnet die Fähigkeit eines Materials, dauerhafte Verformungen ohne Bruch oder Riss zu erleiden"@de)
AnnotationAssertion(skos:example co:PMD_0080170 "Low-carbon steel exhibits high plasticity, allowing deep drawing without cracking"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080170 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080170 co:PMD_0020353)

# Class: co:PMD_0080171 (yield stress)

AnnotationAssertion(rdfs:comment co:PMD_0080171 "The amount of plastic strain typically gives more information about the yield stress. E.g. Rp02 has 0.2% plastic strain."@en)
AnnotationAssertion(rdfs:label co:PMD_0080171 "Fließgrenze"@de)
AnnotationAssertion(rdfs:label co:PMD_0080171 "yield stress"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080171 "yield strength"@en)
AnnotationAssertion(skos:definition co:PMD_0080171 "is the stress at which the material has a non-zero plastic strain."@en)
AnnotationAssertion(skos:example co:PMD_0080171 "The yield strength of mild steel is approximately 250 MPa, beyond which permanent deformation begins"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080171 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080171 ObjectIntersectionOf(co:PMD_0000952 ObjectSomeValuesFrom(obo:RO_0000052 ObjectIntersectionOf(co:PMD_0000068 ObjectSomeValuesFrom(obo:RO_0000053 co:PMD_0080035)))))

# Class: co:PMD_0080172 (untere Streckgrenze)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080172 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080172 "Necessary and sufficient conditions for 'lower yield strength' have not yet been formalized. The term is defined as a specific subtype of 'yield strength'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Yield_(engineering)."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080172 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080172 <https://en.wikipedia.org/wiki/Yield_(engineering)>)
AnnotationAssertion(rdfs:label co:PMD_0080172 "lower yield strength"@en)
AnnotationAssertion(rdfs:label co:PMD_0080172 "untere Streckgrenze"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080172 "lower yield stress"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080172 "untere Fließspannung"@de)
AnnotationAssertion(skos:definition co:PMD_0080172 "Lower yield strength defines the stress at which a material exhibits plastic behavior after initial yielding"@en)
AnnotationAssertion(skos:definition co:PMD_0080172 "Untere Streckgrenze beschreibt die Spannung, bei der ein Material nach dem anfänglichen Fließen plastisches Verhalten zeigt"@de)
AnnotationAssertion(skos:example co:PMD_0080172 "The lower yield strength of mild steel is approximately 235 MPa, defining the onset of stable plastic flow"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080172 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080172 co:PMD_0080171)

# Class: co:PMD_0080173 (obere Streckgrenze)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080173 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080173 "Necessary and sufficient conditions for 'upper yield strength' have not yet been formalized. The term is defined as a specific subtype of 'yield strength'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Yield_(engineering)."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080173 "PERSON: Thomas Hanke")
AnnotationAssertion(obo:IAO_0000119 co:PMD_0080173 <https://en.wikipedia.org/wiki/Yield_(engineering)>)
AnnotationAssertion(rdfs:label co:PMD_0080173 "obere Streckgrenze"@de)
AnnotationAssertion(rdfs:label co:PMD_0080173 "upper yield strength"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080173 "obere Fließspannung"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080173 "upper yield stress"@en)
AnnotationAssertion(skos:definition co:PMD_0080173 "Obere Streckgrenze charakterisiert die maximale Spannung, die vor dem plastischen Fließen eines Materials angewendet werden kann"@de)
AnnotationAssertion(skos:definition co:PMD_0080173 "Upper yield strength characterizes the maximum stress that can be applied before a material begins to yield plastically"@en)
AnnotationAssertion(skos:example co:PMD_0080173 "Mild steel exhibits an upper yield strength of about 300 MPa, followed by a yield drop to the lower yield point"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080173 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080173 co:PMD_0080171)

# Class: co:PMD_0080174 (viscosity)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080174 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080174 "Necessary and sufficient conditions for 'viscosity' have not yet been formalized. The term is defined as a specific subtype of 'plasticity'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080174 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080174 "Viskosität"@de)
AnnotationAssertion(rdfs:label co:PMD_0080174 "viscosity"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080174 "Viskosität"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080174 "viscosity"@en)
AnnotationAssertion(skos:definition co:PMD_0080174 "Viscosity measures a fluid's resistance to flow"@en)
AnnotationAssertion(skos:definition co:PMD_0080174 "Viskosität misst den Widerstand eines Fluids gegen den Fluss"@de)
AnnotationAssertion(skos:example co:PMD_0080174 "Honey at 25 C has a viscosity of about 10 Pa·s, flowing slowly under gravity"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080174 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080174 co:PMD_0020316)

# Class: co:PMD_0080175 (extentional viscosity)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080175 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080175 "Necessary and sufficient conditions for 'extentional viscosity' have not yet been formalized. The term is defined as a specific subtype of 'viscosity'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080175 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080175 "Dehnviskosität"@de)
AnnotationAssertion(rdfs:label co:PMD_0080175 "extentional viscosity"@en)
AnnotationAssertion(skos:definition co:PMD_0080175 "Die Dehnviskosität ist die Messung des Widerstands einer Flüssigkeit gegen den Fluss bei Dehnspannung"@de)
AnnotationAssertion(skos:definition co:PMD_0080175 "Extentional viscosity measures a fluid's resistance to tension flow"@en)
AnnotationAssertion(skos:example co:PMD_0080175 "A polymer melt shows an extensional viscosity three times its shear viscosity at low strain rates"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080175 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080175 co:PMD_0080174)

# Class: co:PMD_0080176 (Scherviskosität)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080176 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080176 "Necessary and sufficient conditions for 'shear viscosity' have not yet been formalized. The term is defined as a specific subtype of 'viscosity'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080176 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080176 "Scherviskosität"@de)
AnnotationAssertion(rdfs:label co:PMD_0080176 "shear viscosity"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080176 "Scherviskosität"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080176 "shear viscosity"@en)
AnnotationAssertion(skos:definition co:PMD_0080176 "Scherviskosität misst den Widerstand eines Fluids gegen Scherfluss"@de)
AnnotationAssertion(skos:definition co:PMD_0080176 "Shear viscosity measures a fluid's resistance to shear flow"@en)
AnnotationAssertion(skos:example co:PMD_0080176 "The shear viscosity of glycerol at 25 C is about 1.5 Pa·s, much higher than water"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080176 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080176 co:PMD_0080174)

# Class: co:PMD_0080177 (kinematische Viskosität)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080177 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080177 "Necessary and sufficient conditions for 'kinematic viscosity' have not yet been formalized. The term is defined as a specific subtype of 'viscosity'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080177 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080177 "kinematic viscosity"@en)
AnnotationAssertion(rdfs:label co:PMD_0080177 "kinematische Viskosität"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080177 "kinematic viscosity"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080177 "kinematische Viskosität"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080177 "kinetic viscosity"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080177 "kinetische Viskosität"@de)
AnnotationAssertion(skos:definition co:PMD_0080177 "Die kinematische Viskosität ist das Verhältnis der dynamischen Viskosität zur Dichte"@de)
AnnotationAssertion(skos:definition co:PMD_0080177 "Kinematic viscosity is the ratio of dynamic viscosity to density"@en)
AnnotationAssertion(skos:example co:PMD_0080177 "The kinematic viscosity of water at 20 C is about 1e-6 m2/s, used in pipe flow calculations"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080177 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080177 co:PMD_0080174)

# Class: co:PMD_0080178 (dynamische Viskosität)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080178 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080178 "Necessary and sufficient conditions for 'dynamic viscosity' have not yet been formalized. The term is defined as a specific subtype of 'viscosity'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080178 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080178 "dynamic viscosity"@en)
AnnotationAssertion(rdfs:label co:PMD_0080178 "dynamische Viskosität"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080178 "dynamic viscosity"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080178 "dynamische Viskosität"@de)
AnnotationAssertion(skos:definition co:PMD_0080178 "Die dynamische Viskosität ist ein Maß für den Widerstand eines Fluids gegen eine allmähliche Verformung durch Scher- oder Zugspannung. Es ist ein Maß für den inneren Widerstand des Fluids gegen den Fluss und kann als Maß für die Flüssigkeitsreibung betrachtet werden"@de)
AnnotationAssertion(skos:definition co:PMD_0080178 "Dynamic viscosity measures a fluid's resistance to gradual deformation by shear stress or tensile stress, indicative of the fluid's internal friction"@en)
AnnotationAssertion(skos:example co:PMD_0080178 "Motor oil at 40 C has a dynamic viscosity of about 100 mPa·s, resisting flow under shear"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080178 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080178 co:PMD_0080174)

# Class: co:PMD_0080179 (volume viscosity)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080179 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080179 "Necessary and sufficient conditions for 'volume viscosity' have not yet been formalized. The term is defined as a specific subtype of 'viscosity'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080179 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080179 "Volumenviskosität"@de)
AnnotationAssertion(rdfs:label co:PMD_0080179 "volume viscosity"@en)
AnnotationAssertion(skos:definition co:PMD_0080179 "Volume viscosity measures a fluid's resistance to volumetric stress"@en)
AnnotationAssertion(skos:definition co:PMD_0080179 "Volumenviskosität misst den Widerstand eines Fluids gegenüber volumetrischer Belastung"@de)
AnnotationAssertion(skos:example co:PMD_0080179 "Water has a volume viscosity of about 3 mPa·s at 25 C, relevant in acoustic wave propagation"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080179 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080179 co:PMD_0080174)

# Class: co:PMD_0080180 (Sprödigkeit)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080180 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080180 "Necessary and sufficient conditions for 'brittleness' have not yet been formalized. The term is defined as a specific subtype of 'mechanical capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080180 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080180 "Sprödigkeit"@de)
AnnotationAssertion(rdfs:label co:PMD_0080180 "brittleness"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080180 "Sprödigkeit"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080180 "Zerbrechlichkeit"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080180 "brittleness"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080180 "fragility"@en)
AnnotationAssertion(skos:definition co:PMD_0080180 "Opposite to toughness, brittleness is the property of being easily broken or damaged"@en)
AnnotationAssertion(skos:definition co:PMD_0080180 "Sprödigkeit ist die Eigenschaft, leicht zu brechen oder zu beschädigen"@de)
AnnotationAssertion(skos:example co:PMD_0080180 "Cast iron has high brittleness, fracturing without measurable plastic deformation under tensile loading"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080180 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080180 co:PMD_0020353)

# Class: co:PMD_0080181 (ductility)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080181 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080181 "Necessary and sufficient conditions for 'ductility' have not yet been formalized. The term is defined as a specific subtype of 'mechanical capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080181 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080181 "Duktilität"@de)
AnnotationAssertion(rdfs:label co:PMD_0080181 "ductility"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080181 "Biegsamkeit"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080181 "Duktilität"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080181 "ductility"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080181 "flexibility"@en)
AnnotationAssertion(skos:definition co:PMD_0080181 "Ductility is the ability of a material to deform plastically without breaking"@en)
AnnotationAssertion(skos:definition co:PMD_0080181 "Duktilität ist die Fähigkeit eines Materials, plastisch zu verformen, ohne zu brechen"@de)
AnnotationAssertion(skos:example co:PMD_0080181 "Low-carbon steel has high ductility, with elongation at break exceeding 30 %"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080181 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080181 co:PMD_0020353)

# Class: co:PMD_0080182 (Formbarkeit)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080182 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080182 "Necessary and sufficient conditions for 'malleability' have not yet been formalized. The term is defined as a specific subtype of 'ductility'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080182 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080182 "Formbarkeit"@de)
AnnotationAssertion(rdfs:label co:PMD_0080182 "malleability"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080182 "Formbarkeit"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080182 "Malleability"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080182 "Malleable"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080182 "formbar"@de)
AnnotationAssertion(skos:definition co:PMD_0080182 "Formbarkeit beschreibt Materialien, die durch Hammern oder Walzen bearbeitet werden können und sich von Duktilität unterscheiden"@de)
AnnotationAssertion(skos:definition co:PMD_0080182 "Malleability refers to a material's amenability to forming by hammering or rolling, distinct from ductility"@en)
AnnotationAssertion(skos:example co:PMD_0080182 "Gold has high malleability, allowing it to be hammered into sheets less than 100 nm thick"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080182 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080182 co:PMD_0080181)

# Class: co:PMD_0080184 (Resilienz)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0080184 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000116 co:PMD_0080184 "Necessary and sufficient conditions for 'resilience' have not yet been formalized. The term is defined as a specific subtype of 'mechanical capability'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0080184 "PERSON: Thomas Hanke")
AnnotationAssertion(rdfs:label co:PMD_0080184 "Resilienz"@de)
AnnotationAssertion(rdfs:label co:PMD_0080184 "resilience"@en)
AnnotationAssertion(skos:altLabel co:PMD_0080184 "Resilienzmodul"@de)
AnnotationAssertion(skos:altLabel co:PMD_0080184 "modulus of resilience"@en)
AnnotationAssertion(skos:definition co:PMD_0080184 "Elastizität ist die mechanische Fähigkeit eines Materials, bei elastischer Verformung Energie zu absorbieren und diese Energie bei Entlastung ohne bleibende Verformung abzugeben"@de)
AnnotationAssertion(skos:definition co:PMD_0080184 "Resilience is a mechanical capability of a material to absorb energy when elastically deformed and release that energy upon unloading without permanent deformation"@en)
AnnotationAssertion(co:PMD_0000060 co:PMD_0080184 "true"^^xsd:boolean)
SubClassOf(co:PMD_0080184 co:PMD_0020353)


AnnotationAssertion(obo:IAO_0000117 co:PMD_0027004 "PERSON: PMDco Team")
AnnotationAssertion(rdfs:label co:PMD_0027004 "lath"@en)
AnnotationAssertion(skos:comment co:PMD_0027004 "A lath is a crystal of a single phase. e.g., cementite in a crystallite of bainite microcontituent."@en)
AnnotationAssertion(skos:definition co:PMD_0027004 "Lath is an elongated object and at the same time a crystal and a thermodynamic phase"@en)

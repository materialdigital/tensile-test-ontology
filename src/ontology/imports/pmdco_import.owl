# Class: co:PMD_0025031 (short-range order)

AnnotationAssertion(rdfs:label co:PMD_0025031 "short-range order"@en)
AnnotationAssertion(skos:definition co:PMD_0025031 "short-range order is a range order characterized by structural organization of members of an object aggregate strictly confined to the nearest neighbours and immediate chemical bonds"@en)
AnnotationAssertion(skos:example co:PMD_0025031 "Ordering of atoms in amorphous materials"@en)
SubClassOf(co:PMD_0025031 co:PMD_0025025)

# Class: co:PMD_0025032 (long-range order)

AnnotationAssertion(rdfs:label co:PMD_0025032 "long-range order"@en)
AnnotationAssertion(skos:definition co:PMD_0025032 "long-range order is a range order characterized by repeating periodicity across macroscopic distances in an object aggregate"@en)
AnnotationAssertion(skos:example co:PMD_0025032 "ordering of atoms in a crystalline material"@en)
SubClassOf(co:PMD_0025032 co:PMD_0025025)

# Class: co:PMD_0025033 (medium-range order)

AnnotationAssertion(rdfs:label co:PMD_0025033 "medium-range order"@en)
AnnotationAssertion(skos:definition co:PMD_0025033 "medium-range order is a range order that characterizes structural organization of members of an object aggregate where small atomic groups link into localized patterns that do not repeat across the whole material"@en)
SubClassOf(co:PMD_0025033 co:PMD_0025025)

# Class: co:PMD_0025997 (Angabe des Bruchwerts)

AnnotationAssertion(obo:IAO_0000114 co:PMD_0025997 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000117 co:PMD_0025997 "PERSON: Kamilla Zaripova")
AnnotationAssertion(rdfs:label co:PMD_0025997 "Angabe des Bruchwerts"@de)
AnnotationAssertion(rdfs:label co:PMD_0025997 "fraction value specification"@en)
AnnotationAssertion(skos:definition co:PMD_0025997 "Bei der Bruchwertspezifikation handelt es sich um eine Wertspezifikation, die Informationen über den quantitativen Anteil eines Teils im Verhältnis zu einem angegebenen Ganzen enthält."@de)
AnnotationAssertion(skos:definition co:PMD_0025997 "Fraction value specification is a value specification that contains information about quantitative share of a part relative to a specified whole."@en)
AnnotationAssertion(skos:example co:PMD_0025997 "2.05 wt.% of carbon in steel, 4 vol.% of nitric acid in a solution"@en)
SubClassOf(co:PMD_0025997 obo:OBI_0001931)
SubClassOf(co:PMD_0025997 ObjectSomeValuesFrom(obo:OBI_0001927 ObjectIntersectionOf(co:PMD_0020101 ObjectSomeValuesFrom(co:PMD_0025999 ObjectIntersectionOf(obo:BFO_0000040 ObjectSomeValuesFrom(obo:BFO_0000050 obo:BFO_0000040))))))
SubClassOf(co:PMD_0025997 ObjectAllValuesFrom(obo:RO_0002350 co:PMD_0020004))

